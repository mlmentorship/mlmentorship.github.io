---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookReaderNav from '../../../components/BookReaderNav.astro';
import { LIBRARY_VOLUMES, type LibraryChapter, type LibraryVolume } from '../../../data/library';
import { entriesForChapter, getLibraryEntries } from '../../../utils/library';
import { getImplementedVisualAudit } from '../../../utils/visualAudits';

export function getStaticPaths() {
  return LIBRARY_VOLUMES.flatMap((volume) => volume.chapters.map((chapter) => ({
    params: { volume: volume.id, chapter: chapter.id },
    props: { volume, chapter },
  })));
}

interface Props { volume: LibraryVolume; chapter: LibraryChapter; }
const { volume, chapter } = Astro.props as Props;
const allEntries = await getLibraryEntries();
const entries = entriesForChapter(allEntries, chapter);
const visualReviewEntries = entries.filter((entry) => getImplementedVisualAudit(entry.slug));
const chapterIndex = volume.chapters.findIndex((item) => item.id === chapter.id);
const previousChapter = chapterIndex > 0 ? volume.chapters[chapterIndex - 1] : undefined;
const nextChapter = chapterIndex < volume.chapters.length - 1 ? volume.chapters[chapterIndex + 1] : undefined;
const bookChapters = volume.chapters.map((bookChapter) => ({ chapter: bookChapter, entries: entriesForChapter(allEntries, bookChapter) }));
const typeLabel = { concepts: 'Concept', questions: 'Question', guides: 'Guide' } as const;
---

<BaseLayout title={`${chapter.title} · ${volume.title}`} description={chapter.description}>
  <BookReaderNav
    volume={volume}
    currentChapter={chapter}
    currentSlug=""
    chapters={bookChapters}
    previousEntry={previousChapter ? { href: `/library/${volume.id}/${previousChapter.id}/`, title: previousChapter.title } : undefined}
    nextEntry={nextChapter ? { href: `/library/${volume.id}/${nextChapter.id}/`, title: nextChapter.title } : undefined}
    stepNoun="chapter"
    mobileOnly
  />
  <div class="chapter-page">
    <header class="chapter-head">
      <nav class="breadcrumb" aria-label="Chapter context"><a href={`/library/${volume.id}/`}>Book {volume.number} · {volume.shortTitle}</a><span aria-hidden="true">/</span><span>Chapter {chapterIndex + 1}</span></nav>
      <h1>{chapter.title}</h1>
      <p class="description">{chapter.description}</p>
      <dl class="chapter-meta">
        <div><dt>Priority</dt><dd>{chapter.priority}</dd></div>
        <div><dt>Difficulty</dt><dd>{chapter.difficulty}</dd></div>
        <div><dt>Useful for</dt><dd>{chapter.roles.join(', ')}</dd></div>
        <div><dt>Interview rounds</dt><dd>{chapter.rounds.join(', ')}</dd></div>
      </dl>
      {chapter.prerequisites && chapter.prerequisites.length > 0 && (
        <p class="prerequisites"><strong>Read first:</strong> {chapter.prerequisites.map((item, index) => <>{index > 0 && ', '}<a href={item.href}>{item.label}</a></>)}</p>
      )}
    </header>

    <section class="entry-section" aria-labelledby="entries-heading">
      <div class="entry-heading">
        <div><h2 id="entries-heading">Chapter contents</h2><span>{entries.length} lessons</span></div>
        {visualReviewEntries.length > 0 && (
          <a class="visual-review-link" href={`/review/#${visualReviewEntries[0].slug}`} data-visual-review-count={visualReviewEntries.length}>
            Visual lessons <span>{visualReviewEntries.length}</span><span aria-hidden="true">→</span>
          </a>
        )}
      </div>
      <ol class="entry-list" data-pagefind-ignore="all">
        {entries.map((entry, index) => (
          <li data-entry-id={`entry:${entry.slug}`}>
            <a href={entry.href}>
              <span class="entry-number">{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{entry.title}</strong></div>
              <small><span data-entry-complete hidden>✓ </span>{typeLabel[entry.category]}</small>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <nav class="chapter-nav" aria-label="Other chapters">
      {previousChapter ? <a href={`/library/${volume.id}/${previousChapter.id}/`}><span>← Previous chapter</span><strong>{previousChapter.title}</strong></a> : <span></span>}
      {nextChapter ? <a class="next" href={`/library/${volume.id}/${nextChapter.id}/`}><span>Next chapter →</span><strong>{nextChapter.title}</strong></a> : <span></span>}
    </nav>
  </div>
</BaseLayout>

<script>
  import { loadActivityProgress } from '../../../utils/activityProgress';
  const completed = loadActivityProgress().completed;
  document.querySelectorAll<HTMLElement>('[data-entry-id]').forEach((item) => {
    if (!completed[item.dataset.entryId ?? '']) return;
    item.classList.add('is-complete');
    const mark = item.querySelector<HTMLElement>('[data-entry-complete]');
    if (mark) mark.hidden = false;
  });
</script>

<style>
  .chapter-page { width: min(100%, 44rem); margin: 0 auto; padding: clamp(1.4rem, 3vw, 2.2rem) var(--gutter) 4rem; }
  .chapter-head { padding-bottom: 1.1rem; border-bottom: 1px solid var(--c-rule); }
  .breadcrumb { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem; margin-bottom: .7rem; color: var(--c-muted); font-size: .8rem; }
  .breadcrumb a { color: var(--c-text-soft); text-decoration: none; }
  .breadcrumb a:hover { color: var(--c-accent); }
  .chapter-head h1 { margin: 0 0 .4rem; font-size: 1.95rem; line-height: 1.2; letter-spacing: 0; }
  .description { max-width: 39rem; margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: .92rem; line-height: 1.5; }
  .chapter-meta { display: flex; flex-wrap: wrap; gap: .35rem 1rem; margin: .75rem 0 0; }
  .chapter-meta div { display: flex; flex-wrap: wrap; min-width: 0; gap: .3rem; }
  .chapter-meta dt { color: var(--c-muted); font-size: .76rem; }
  .chapter-meta dd { margin: 0; color: var(--c-text-soft); font-size: .76rem; line-height: 1.4; overflow-wrap: anywhere; }
  .prerequisites { margin: .65rem 0 0; color: var(--c-muted); font-size: .72rem; }

  .entry-section { margin-top: 1.4rem; }
  .entry-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-end; margin-bottom: .5rem; }
  .entry-heading > div { min-width: 0; }
  .entry-heading h2 { margin: 0; font-size: .9rem; }
  .entry-heading span { color: var(--c-muted); font-size: .66rem; }
  .entry-heading > div > span { display: block; margin-top: .15rem; }
  .visual-review-link {
    min-height: 44px;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: .4rem;
    padding: .42rem .65rem;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    color: var(--c-text-soft);
    font-family: var(--font-ui);
    font-size: .82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .visual-review-link:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .visual-review-link span { color: var(--c-muted); font-size: .62rem; font-weight: 400; }
  .entry-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--c-rule); }
  .entry-list li { margin: 0; border-bottom: 1px solid var(--c-rule); }
  .entry-list a { display: grid; grid-template-columns: 1.7rem minmax(0, 1fr) auto; align-items: center; min-height: 3.2rem; gap: .55rem; padding: .65rem .35rem; color: inherit; text-decoration: none; }
  .entry-list a > div { min-width: 0; }
  .entry-number, .entry-list small { color: var(--c-muted); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .entry-list strong { color: var(--c-text); font-size: .94rem; font-weight: 550; line-height: 1.45; }
  .entry-list small { font-size: .75rem; }
  .entry-list a:hover { background: var(--c-bg-tint); }
  .entry-list a:hover strong { color: var(--c-accent); text-decoration: underline; }
  .entry-list li.is-complete strong { color: var(--c-text-soft); }
  .entry-list li.is-complete small { color: var(--c-accent); }

  .chapter-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; padding-top: .75rem; border-top: 1px solid var(--c-rule); }
  .chapter-nav a { display: flex; flex-direction: column; color: var(--c-text); text-decoration: none; }
  .chapter-nav a.next { text-align: right; }
  .chapter-nav span { color: var(--c-muted); font-size: .65rem; }
  .chapter-nav strong { margin-top: .15rem; font-size: .8rem; }
  .chapter-nav a:hover strong { color: var(--c-accent); text-decoration: underline; }

  @media (max-width: 640px) {
    .entry-heading { align-items: stretch; flex-direction: column; gap: .65rem; }
    .chapter-head h1 { font-size: 1.75rem; }
    .visual-review-link { justify-content: center; }
    .entry-list a { grid-template-columns: 1.4rem minmax(0, 1fr); row-gap: .15rem; }
    .entry-number { grid-column: 1; grid-row: 1 / 3; align-self: start; padding-top: .15rem; }
    .entry-list small { grid-column: 2; grid-row: 2; justify-self: start; }
    .entry-list div { grid-column: 2; grid-row: 1; }
    .chapter-nav { grid-template-columns: 1fr; }
    .chapter-nav a.next { text-align: left; }
  }
</style>
