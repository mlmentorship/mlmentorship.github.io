---
import { LIBRARY_VOLUMES, type LibraryChapter, type LibraryVolume } from '../../../../data/library';
import { entriesForChapter, getLibraryEntries } from '../../../../utils/library';
import { getImplementedVisualAudit } from '../../../../utils/visualAudits';

export function getStaticPaths() {
  return LIBRARY_VOLUMES.flatMap((volume) => volume.chapters.map((chapter) => ({
    params: { volume: volume.id, chapter: chapter.id },
    props: { volume, chapter },
  })));
}

interface Props { volume: LibraryVolume; chapter: LibraryChapter; }
const { volume, chapter } = Astro.props as Props;
const entries = entriesForChapter(await getLibraryEntries(), chapter);
const firstVisual = entries.find((entry) => getImplementedVisualAudit(entry.slug));
const destination = firstVisual ? `/review/#${firstVisual.slug}` : `/library/${volume.id}/${chapter.id}/`;
const canonical = new URL(destination, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonical} />
    <title>Continue to visual review</title>
  </head>
  <body data-pagefind-ignore="all">
    <p><a href={destination}>Continue to the library-wide visual review</a></p>
  </body>
</html>
