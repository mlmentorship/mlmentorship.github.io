---
import PrepLayout from '../../layouts/PrepLayout.astro';
import { SITE } from '../../consts';
if (!SITE.features.prepTools) return Astro.redirect('/questions/', 302);

const rolePaths = [
  {
    id: 'applied-scientist', title: 'Applied Scientist', rule: 'Do not prep like a pure researcher. Preserve science, but prove scoping, experimentation, shipping, and influence.',
    sequence: [
      ['01 · Calibrate role and level', '/guides/as-vs-mle-vs-re/', 'Read the role taxonomy and L5/L6 calibration; choose the target rubric.'],
      ['02 · Scope before solving', '/questions/scope-ambiguous-problem/', 'Practice objective, user, data, constraints, and smallest discriminating experiment.'],
      ['03 · Prove ML breadth', '/questions/how-to-choose-loss-function/', 'Explain mechanisms and alternatives, not recipes.'],
      ['04 · Design end to end', '/questions/design-fraud-detection/', 'Connect data, baseline, model, eval, serving, monitoring, and iteration.'],
      ['05 · Make a product decision', '/questions/design-ml-ab-test/', 'Choose metrics, experiment design, validity checks, and a ship rule.'],
      ['06 · Debug evidence disagreement', '/questions/debug-offline-online-metric-gap/', 'Separate objective mismatch, leakage, serving skew, and feedback effects.'],
      ['07 · Defend project ownership', '/questions/most-ambitious-project/', 'Prepare a short opening and 20-minute technical deep-dive.'],
      ['08 · Show judgment under pressure', '/questions/advocated-quality-over-speed/', 'Balance legitimate delivery pressure with measurable user risk.'],
      ['09 · Simulate the loop', '/prep/simulations/#applied-scientist', 'Run the AS packet and reduce results to three bounded repairs.'],
    ],
  },
  {
    id: 'ml-engineer', title: 'Machine Learning Engineer', rule: 'Do not substitute ML reading for software execution. Code, debug, and design reliable systems repeatedly.',
    sequence: [
      ['01 · Confirm the loop', '/guides/as-vs-mle-vs-re/', 'Ask whether coding is algorithms, practical implementation, ML coding, or all three.'],
      ['02 · Establish coding baseline', '/questions/implement-knn/', 'Produce correct code, tests, and complexity under time.'],
      ['03 · Add bounded-memory implementation', '/questions/implement-batched-top-k/', 'Reason about vectorization, memory, and exact-versus-ANN trade-offs.'],
      ['04 · Debug systematically', '/questions/debug-training-loop/', 'State the diagnostic order before editing code.'],
      ['05 · Design reliable serving', '/questions/design-ml-monitoring/', 'Cover data, model, outcome, alerts, ownership, and rollback.'],
      ['06 · Make cost explicit', '/questions/design-ml-system-fixed-budget/', 'Quantify workload and quality/cost/latency frontiers.'],
      ['07 · Analyze experiment data', '/questions/analyze-experiment-sql/', 'Protect user grain, exposure, windows, and sample ratio.'],
      ['08 · Prepare production failure and recovery stories', '/prep/story-bank/', 'Use failure, incident recovery, trade-off, and cross-team stories.'],
      ['09 · Simulate the loop', '/prep/simulations/#ml-engineer', 'Run coding, design, production, breadth, and project rounds.'],
    ],
  },
  {
    id: 'research-engineer', title: 'Research Engineer', rule: 'Balance implementation and systems depth with scientific skepticism. Confirm whether the title is research-heavy or software-heavy.',
    sequence: [
      ['01 · Confirm role mix', '/guides/as-vs-mle-vs-re/', 'Map research, modeling, engineering, and product expectations.'],
      ['02 · Implement a core primitive', '/questions/implement-attention-from-scratch/', 'Build the mechanism correctly and explain dimensions and complexity.'],
      ['03 · Add systems coding', '/questions/implement-batched-top-k/', 'Handle memory and performance without hiding behind a library.'],
      ['04 · Model the workload', '/questions/train-100b-model/', 'Reason about memory, parallelism, communication, failures, and checkpoints.'],
      ['05 · Reason about inference', '/questions/reduce-llm-inference-cost-10x/', 'Use measurement and cost models rather than a list of optimizations.'],
      ['06 · Design discriminating evidence', '/questions/design-ablation-study/', 'Control compute, tuning, variance, and alternative explanations.'],
      ['07 · Critique research fairly', '/questions/critique-ml-paper/', 'Prioritize the threat that most changes the central claim.'],
      ['08 · Prepare translation stories', '/prep/story-bank/', 'Show failed experiments, implementation decisions, and research-to-production impact.'],
      ['09 · Simulate the loop', '/prep/simulations/#research-engineer', 'Run coding, systems, research depth, breadth, and project rounds.'],
    ],
  },
];

const domains = [
  { title: 'LLM and agents', do: ['LLM evals and failure taxonomy', 'RAG versus fine-tuning decisions', 'Inference workload and cost', 'Agent reliability and tool-use evaluation'], links: [['Evaluate an LLM application', '/questions/how-would-you-evaluate-an-llm-application/'], ['Evaluate an agent', '/questions/evaluate-an-agent/'], ['Reduce inference cost', '/questions/reduce-llm-inference-cost-10x/']] },
  { title: 'Recommendations and search', do: ['Candidate generation and ranking', 'Offline ranking metrics and position bias', 'Exploration and feedback loops', 'Cold start and ecosystem health'], links: [['YouTube recommender', '/questions/design-youtube-recommender/'], ['Evaluate a ranker', '/questions/evaluate-search-ranker/'], ['Cold start', '/questions/cold-start-new-user/']] },
  { title: 'ML platform and infrastructure', do: ['Training and serving workload models', 'Distributed communication and memory', 'Feature/data reliability', 'Monitoring, fallback, and cost ownership'], links: [['Train a 100B model', '/questions/train-100b-model/'], ['Feature store', '/questions/design-feature-store/'], ['Fixed-budget system', '/questions/design-ml-system-fixed-budget/']] },
  { title: 'General product ML', do: ['Problem framing and baseline', 'Experiment and metric hierarchy', 'Delayed labels and feedback', 'Cross-functional decision evidence'], links: [['Choose product metrics', '/questions/choose-ml-product-metrics/'], ['Design an A/B test', '/questions/design-ml-ab-test/'], ['Fraud detection', '/questions/design-fraud-detection/']] },
  { title: 'Research and modeling', do: ['Hypothesis and discriminating evidence', 'Matched baselines and compute', 'Ablations and alternative explanations', 'Derivations and boundary conditions'], links: [['Design an ablation', '/questions/design-ablation-study/'], ['Critique a paper', '/questions/critique-ml-paper/'], ['Derive logistic regression', '/questions/derive-logistic-regression/']] },
];
---

<PrepLayout
  title="Applied Scientist, MLE, and Research Engineer prep paths"
  description="Ordered role-specific and domain-specific interview preparation paths using the mlmentorship core library."
  heading="Prepare for the role and loop—not the title alone."
  lede="Follow one ordered role path, then add only the domain supplement that appears in the actual job and recruiter-provided round breakdown. Everything else is optional breadth."
>
  <section class="callout"><h2>Before choosing a path</h2><p>Company titles are inconsistent. Ask for round formats, coding style, project expectations, and the day-to-day research/modeling/engineering/product mix. If the recruiter cannot provide detail, use the typical rounds in the <a href="/prep/readiness/">readiness check</a> and mark uncertainty as risk.</p></section>

  <nav class="path-jumps" aria-label="Jump to role path">{rolePaths.map((role) => <a href={`#${role.id}`}>{role.title}</a>)}</nav>

  {rolePaths.map((role) => <section id={role.id} class="role-path"><header><p>Ordered core path</p><h2>{role.title}</h2><span>{role.rule}</span></header><ol>{role.sequence.map(([label, href, detail]) => <li><h3><a href={href}>{label}</a></h3><p>{detail}</p></li>)}</ol></section>)}

  <h2 id="domain-supplements">Domain supplements</h2>
  <p>A domain supplement changes examples and technical depth. It does not replace coding, project evidence, behavioral judgment, or the actual round formats.</p>
  <div class="domain-grid">{domains.map((domain) => <article><h3>{domain.title}</h3><ul>{domain.do.map((item) => <li>{item}</li>)}</ul><p>{domain.links.map(([label, href], index) => <><a href={href}>{label}</a>{index < domain.links.length - 1 ? ' · ' : ''}</>)}</p></article>)}</div>

  <h2>Specialist-domain boundary</h2>
  <section class="boundary"><p>The core library is deepest in LLMs, recommendations, general ML, training, and systems. For specialized CV, speech, or RL loops, use the concept collections below for foundations, but obtain a domain-specific paper/project mock from someone current in that field.</p><ul><li><a href="/concepts/#computer-vision">Computer Vision concepts</a></li><li><a href="/concepts/#nlp-and-speech">NLP & Speech concepts</a></li><li><a href="/concepts/#reinforcement-learning">Reinforcement Learning concepts</a></li></ul></section>

  <h2>What the core library does not yet cover deeply</h2>
  <section class="boundary"><p>Use external, current material when the role explicitly tests framework internals (PyTorch/TensorFlow compilation and autograd), general streaming-data infrastructure, privacy/compliance implementation, causal inference beyond experiment fundamentals, or a specialist research frontier. The prep system should expose these boundaries rather than turn a few reference notes into false readiness.</p></section>

  <section class="callout"><h2>How to use the sequence</h2><p>Do not merely read from 01 to 09. Attempt each linked question first, diagnose with its round-specific rubric, schedule retries, and move forward while due items continue in parallel. Run the simulation only after every expected round has a baseline.</p></section>
</PrepLayout>

<style>
  .path-jumps { display: flex; flex-wrap: wrap; gap: .5rem; }
  .path-jumps a { padding: .5rem .7rem; border: 1px solid var(--c-rule); border-radius: 999px; text-decoration: none; }
  .role-path { scroll-margin-top: 5.5rem; }
  .role-path > header { margin: 2.5rem 0 .8rem; padding-bottom: .8rem; border-bottom: 2px solid var(--c-text); }
  .role-path > header p { margin: 0; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--c-accent); }
  .role-path > header h2 { margin: .2rem 0 !important; }
  .role-path > header span { color: var(--c-text-soft); font-size: .86rem; }
  .role-path ol { list-style: none; padding: 0; counter-reset: path; }
  .role-path li { position: relative; padding: .8rem 0 .8rem 3.3rem; border-bottom: 1px solid var(--c-rule); counter-increment: path; }
  .role-path li::before { content: counter(path, decimal-leading-zero); position: absolute; left: 0; font-family: var(--font-mono); color: var(--c-accent); }
  .role-path h3, .role-path p { margin: 0; }
  .role-path h3 { font-size: .95rem !important; }
  .role-path p { color: var(--c-text-soft); font-size: .82rem; }
  .domain-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .domain-grid article { padding: .9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); }
  .domain-grid h3 { margin-top: 0 !important; }
  .domain-grid li, .domain-grid p { font-size: .82rem; }
  .boundary { padding: 1rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg-tint); }
  @media (max-width: 700px) { .domain-grid { grid-template-columns: 1fr; } }
</style>
