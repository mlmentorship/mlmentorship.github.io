---
import PrepLayout from '../../layouts/PrepLayout.astro';
import { SITE } from '../../consts';
import { ROLE_PATHS, STAFF_PRINCIPAL_PATH } from '../../data/rolePaths';
if (!SITE.features.prepTools) return Astro.redirect('/questions/', 302);

const frontierFormats = [
  { title: 'Agentic codebase', when: 'The recruiter names an existing repository or authorized coding agent.', action: 'Replace one implementation repetition with the agentic evaluation-service lab. Practice mapping, bounded delegation, diff review, and proof.', href: '/prep/labs/agentic-codebase/' },
  { title: 'Technical presentation', when: 'The loop includes a project presentation, job talk, or artifact defense.', action: 'Prepare 30 minutes around three decisions and reserve 15 minutes for interrupted questions.', href: '/prep/presentation/' },
  { title: 'Research work sample', when: 'The assessment uses a notebook, API, paper, model, or open-ended investigation.', action: 'Run the black-box lab and produce a five-minute claim, evidence, uncertainty, and next experiment readout.', href: '/prep/labs/black-box/' },
  { title: 'Values and mission', when: 'The loop includes a dedicated values, safety, mission, or senior-leadership discussion.', action: 'Prepare four real tensions and practice independent judgment under principled pushback.', href: '/prep/values/' },
  { title: 'Performance trace', when: 'The role centers on kernels, accelerators, training throughput, inference, or systems performance.', action: 'Use the released accelerator challenge or inference scheduler and keep an experiment ledger.', href: '/prep/labs/accelerator/' },
];

const domains = [
  { title: 'LLM and agents', do: ['Reasoning quality under fixed compute', 'Coding-product context and evaluation', 'Agent authority and runtime safety', 'RAG, inference, and tool-use evaluation'], links: [['Reasoning under budget', '/questions/design-reasoning-model-fixed-budget/'], ['AI coding product', '/questions/design-ai-coding-product/'], ['Enterprise agent platform', '/questions/design-enterprise-agent-platform/'], ['Agent safety control plane', '/questions/design-agent-safety-control-plane/'], ['Evaluate an agent', '/questions/evaluate-an-agent/']] },
  { title: 'Post-training and environments', do: ['Preference data and reward models', 'RL environments and evidence-bearing graders', 'Synthetic data and held-out task families', 'Verifiable rewards and reward hacking'], links: [['Post-training design', '/questions/design-post-training-data-and-rl-environment/'], ['Preference data', '/concepts/preference-data-and-reward-models/'], ['RLVR and GRPO', '/concepts/rl-verifiable-rewards-grpo/'], ['Synthetic data', '/concepts/synthetic-data-generation-verification/']] },
  { title: 'Alignment and model behavior', do: ['Scalable oversight and control', 'Mechanistic interpretability', 'Evaluation validity and contamination', 'Adaptive red-team and LLM security'], links: [['Scalable oversight', '/concepts/scalable-oversight-and-ai-control/'], ['Evaluation validity', '/concepts/evaluation-validity-benchmark-contamination/'], ['LLM-as-judge', '/concepts/llm-as-judge/'], ['Red-team design', '/questions/design-llm-red-team-program/']] },
  { title: 'Multimodal and robotics', do: ['Contrastive alignment and fusion', 'Live audio, video, screen, and tool timing', 'Grounding and modality-conflict evaluation', 'Observation, action, safety, and sim-to-real'], links: [['Real-time multimodal assistant', '/questions/design-real-time-multimodal-assistant/'], ['Contrastive learning', '/concepts/contrastive-self-supervised-learning/'], ['Multi-task learning', '/concepts/multi-task-learning-objective-interference/'], ['Multimodal models', '/concepts/multimodal-foundation-models/'], ['Robotics policies', '/concepts/robotics-policy-learning/']] },
  { title: 'Recommendations and search', do: ['Candidate generation and ranking objectives', 'Position bias and counterfactual evaluation', 'Multi-task learning and feedback loops', 'Creator cold start and ecosystem health'], links: [['Short-form video ecosystem', '/questions/design-short-form-video-ecosystem/'], ['Ecosystem strategy mock', '/guides/annotated-ecosystem-strategy-mock/'], ['Ranking losses', '/concepts/learning-to-rank-losses/'], ['Counterfactual ranking', '/concepts/position-bias-counterfactual-learning-to-rank/'], ['Evaluate a ranker', '/questions/evaluate-search-ranker/']] },
  { title: 'ML platform and infrastructure', do: ['Foundation-model data provenance and mixtures', 'Training and serving workload models', 'Distributed communication and memory', 'Migration, reliability, adoption, and cost ownership'], links: [['Foundation-model data platform', '/questions/design-foundation-model-data-platform/'], ['Multi-team platform case', '/questions/design-multi-team-ml-platform/'], ['ML lineage', '/concepts/ml-data-lineage-versioning/'], ['Parallelism selection', '/concepts/strong-scaling-and-parallelism-selection/'], ['Distributed profiling', '/concepts/profiling-distributed-ml-workloads/']] },
  { title: 'General product ML', do: ['Problem framing and baseline', 'Causal identification and experiment design', 'Cost-aware thresholds and abstention', 'Delayed and selective labels'], links: [['Causal inference', '/concepts/causal-inference-for-ml-decisions/'], ['Delayed labels', '/concepts/delayed-labels-selective-labels-feedback-loops/'], ['Decision thresholds', '/concepts/decision-thresholds-asymmetric-costs-abstention/'], ['Choose product metrics', '/questions/choose-ml-product-metrics/'], ['Design an A/B test', '/questions/design-ml-ab-test/']] },
  { title: 'Research and modeling', do: ['Moments and distribution choice', 'Paired resampling and uncertainty', 'Matched baselines and compute', 'Reproducible ablations'], links: [['Statistical moments', '/concepts/expectation-variance-covariance-correlation/'], ['Bootstrap', '/concepts/bootstrap-and-resampling/'], ['Hypothesis testing', '/concepts/hypothesis-testing-confidence-intervals/'], ['Design an ablation', '/questions/design-ablation-study/']] },
];
---

<PrepLayout
  title="ML role and level preparation paths"
  description="Ordered role paths for Applied Scientist, Research Scientist, MLE, and Research Engineer, plus a staff through senior-principal level overlay."
  heading="Prepare for the role and loop, not the title alone."
  lede="Follow one ordered role path, then add only the domain supplement that appears in the actual job and recruiter-provided round breakdown. Everything else is optional breadth."
>
  <section class="callout"><h2>Before choosing a path</h2><p>Company titles are inconsistent. Ask for round formats, implementation style, project expectations, and the day-to-day research/modeling/engineering/product mix. If the recruiter cannot provide detail, use the typical rounds in the <a href="/prep/readiness/">readiness check</a> and mark uncertainty as risk.</p></section>

  <section class="role-chooser" aria-labelledby="choose-role-heading">
    <h2 id="choose-role-heading">Choose one role</h2>
    <div>{ROLE_PATHS.map((role) => <article id={role.id}><span>{role.shortTitle}</span><h3><a href={`/prep/role-paths/${role.id}/`}>{role.title}</a></h3><p>{role.rule}</p><a class="open-path" href={`/prep/role-paths/${role.id}/`}>Open 9-step path →</a></article>)}</div>
  </section>

  <section class="level-overlay" aria-labelledby="level-overlay-heading">
    <div><span>Optional level overlay</span><h2 id="level-overlay-heading">{STAFF_PRINCIPAL_PATH.title}</h2><p>{STAFF_PRINCIPAL_PATH.rule}</p></div>
    <a href="/prep/level-paths/staff-principal/">Open {STAFF_PRINCIPAL_PATH.sequence.length}-step level path →</a>
  </section>

  <details class="optional-section">
    <summary><strong>Frontier format overlays</strong><span>Add one only when recruiting confirms the format.</span></summary>
    <div class="format-grid">{frontierFormats.map((format) => <article><h3>{format.title}</h3><p><strong>Use when:</strong> {format.when}</p><p>{format.action}</p><a href={format.href}>Open practice →</a></article>)}</div>
  </details>

  <details id="domain-supplements" class="optional-section">
    <summary><strong>Domain supplements</strong><span>Add only the technical subject used in the actual role.</span></summary>
    <p>A domain supplement changes examples and depth. It does not replace implementation, project evidence, behavioral judgment, or confirmed rounds.</p>
    <div class="domain-grid">{domains.map((domain) => <article><h3>{domain.title}</h3><ul>{domain.do.map((item) => <li>{item}</li>)}</ul><p>{domain.links.map(([label, href], index) => <><a href={href}>{label}</a>{index < domain.links.length - 1 ? ' · ' : ''}</>)}</p></article>)}</div>
  </details>

  <h2>Specialist-domain boundary</h2>
  <section class="boundary"><p>The core library is deepest in LLMs, recommendations, general ML, training, and systems. For specialized CV, speech, or RL loops, use the concept collections below for foundations, but obtain a domain-specific paper/project mock from someone current in that field.</p><ul><li><a href="/concepts/#computer-vision">Computer Vision concepts</a></li><li><a href="/concepts/#nlp-and-speech">NLP & Speech concepts</a></li><li><a href="/concepts/#reinforcement-learning">Reinforcement Learning concepts</a></li></ul></section>

  <h2>What the core library does not yet cover deeply</h2>
  <section class="boundary"><p>This site does not attempt to replace general algorithms or SQL interview preparation. The implementation questions stay here only when the task is fundamentally about ML: attention, training-loop diagnosis, memory-bounded retrieval, or mergeable evaluation metrics. Use external, current material for general data structures, framework internals, streaming-data infrastructure, privacy/compliance implementation, advanced causal inference, or a specialist research frontier.</p></section>

  <section class="callout"><h2>How to use a path</h2><p>Attempt each linked question before reading, diagnose with its rubric, and schedule retries. Run the simulation only after every expected round has a baseline.</p></section>
</PrepLayout>

<script>
  const target = window.location.hash ? document.querySelector<HTMLDetailsElement>(window.location.hash) : null;
  if (target?.tagName === 'DETAILS') target.open = true;
</script>

<style>
  .role-chooser > h2 { margin-top: 0 !important; }
  .role-chooser > div { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .role-chooser article { padding: 1rem; border: 1px solid var(--c-rule); border-radius: var(--radius); scroll-margin-top: var(--sticky-offset); }
  .role-chooser article > span { color: var(--c-accent); font-family: var(--font-mono); font-size: .68rem; }
  .role-chooser h3 { margin: .15rem 0 .35rem !important; }
  .role-chooser h3 a { color: var(--c-text); text-decoration: none; }
  .role-chooser h3 a:hover { color: var(--c-accent); text-decoration: underline; }
  .role-chooser p { min-height: 4.2rem; margin: 0 0 .55rem; color: var(--c-text-soft); font-size: .84rem; }
  .open-path { font-size: .8rem; font-weight: 650; text-decoration: none; }
  .open-path:hover { text-decoration: underline; }
  .level-overlay { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin: 1rem 0 1.5rem; padding: 1rem; border: 2px solid var(--c-text); border-radius: var(--radius); }
  .level-overlay span { color: var(--c-accent); font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase; }
  .level-overlay h2 { margin: .15rem 0 .25rem !important; font-size: 1.1rem !important; }
  .level-overlay p { max-width: 40rem; margin: 0; color: var(--c-text-soft); font-size: .84rem; }
  .level-overlay > a { flex: 0 0 auto; font-size: .8rem; font-weight: 700; text-decoration: none; }
  .level-overlay > a:hover { text-decoration: underline; }
  .optional-section { margin: 1.5rem 0; padding: .85rem 0; border-top: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule); scroll-margin-top: var(--sticky-offset); }
  .optional-section > summary { display: flex; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; }
  .optional-section > summary::-webkit-details-marker { display: none; }
  .optional-section > summary::after { content: '+'; color: var(--c-accent); font-family: var(--font-mono); }
  .optional-section[open] > summary::after { content: '−'; }
  .optional-section > summary span { margin-left: auto; color: var(--c-muted); font-size: .78rem; font-weight: 400; }
  .optional-section > p { margin-top: .9rem; color: var(--c-text-soft); font-size: .85rem; }
  .domain-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .format-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .format-grid article { padding: .9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); }
  .format-grid h3 { margin-top: 0 !important; }
  .format-grid p { font-size: .82rem; }
  .domain-grid article { padding: .9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); }
  .domain-grid h3 { margin-top: 0 !important; }
  .domain-grid li, .domain-grid p { font-size: .82rem; }
  .boundary { padding: 1rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg-tint); }
  @media (max-width: 700px) { .role-chooser > div, .domain-grid, .format-grid { grid-template-columns: 1fr; } .role-chooser p { min-height: 0; } .level-overlay { align-items: flex-start; flex-direction: column; } .optional-section > summary span { display: none; } }
</style>
