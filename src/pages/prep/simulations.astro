---
import PrepLayout from '../../layouts/PrepLayout.astro';
import { SITE } from '../../consts';
import { ROLE_ORDER, ROLE_OVERLAYS } from '../../data/prepCurriculum';
if (!SITE.features.prepTools) return Astro.redirect('/questions/', 302);

const packets = [
  {
    id: 'applied-scientist', role: 'Applied Scientist', duration: '3h 35m including breaks', observer: 'Prefer an experienced scientist, MLE, product partner, or interviewer.',
    rounds: [
      { time: '45 min', title: 'ML breadth', prompt: 'Choose three unseen breadth questions. Require mechanism, failure mode, and one alternative on each.' },
      { time: '45 min', title: 'ML system design', prompt: 'Design an ML system under explicit user, latency, cost, and delayed-label constraints.' },
      { time: '40 min', title: 'Project deep-dive', prompt: 'Probe ownership, the hardest decision, one failure, evidence, and what the candidate would change.' },
      { time: '35 min', title: 'Product & experimentation', prompt: 'Define a ship decision, primary metric, guardrails, experiment unit, and validity threats.' },
      { time: '30 min', title: 'Behavioral / leadership', prompt: 'Ask one conflict and one prioritization question; push back on at least two claims.' },
    ],
  },
  {
    id: 'research-scientist', role: 'Research Scientist', duration: '4h 10m including breaks', observer: 'Prefer an active researcher or Research Engineer who can test derivations, experimental validity, and ownership of claims.',
    rounds: [
      { time: '45 min', title: 'Math and ML depth', prompt: 'Use one derivation and two mechanism questions. Change an assumption after the first answer.' },
      { time: '45 min', title: 'Paper and research defense', prompt: 'Defend one central claim, its evidence, the strongest alternative explanation, and one limitation.' },
      { time: '60 min', title: 'Research work sample', prompt: 'Turn an unfamiliar observation into competing hypotheses, discriminating probes, and a short evidence readout.' },
      { time: '40 min', title: 'Research implementation', prompt: 'Implement or debug a small ML mechanism with tests, numerical checks, and complexity analysis.' },
      { time: '40 min', title: 'Job-talk follow-up', prompt: 'Present one contribution briefly, then probe ownership, failed paths, impact, and the next research question.' },
    ],
  },
  {
    id: 'ml-engineer', role: 'Machine Learning Engineer', duration: '3h 40m including breaks', observer: 'Prefer a strong software engineer or MLE who will inspect correctness and operational detail.',
    rounds: [
      { time: '45 min', title: 'ML implementation', prompt: 'Use an ML primitive, evaluation, or debugging problem. Require examples, tests, complexity, and working code.' },
      { time: '45 min', title: 'ML system design', prompt: 'Design data, training, serving, monitoring, rollback, and iteration for a product ML system.' },
      { time: '45 min', title: 'Systems / production', prompt: 'Diagnose a training or serving bottleneck from incomplete symptoms; require a measurement plan.' },
      { time: '35 min', title: 'ML breadth', prompt: 'Use two mechanism questions plus one model-choice trade-off.' },
      { time: '30 min', title: 'Behavioral / project', prompt: 'Probe a production failure, ownership boundaries, and influence during incident recovery.' },
    ],
  },
  {
    id: 'research-engineer', role: 'Research Engineer', duration: '3h 50m including breaks', observer: 'Prefer an RE, systems engineer, or researcher who can test both implementation and evidence quality.',
    rounds: [
      { time: '45 min', title: 'ML implementation', prompt: 'Implement an ML primitive or debugging task with tests and complexity analysis.' },
      { time: '45 min', title: 'Training / inference systems', prompt: 'Quantify a workload, identify the bottleneck, select parallelism, and design recovery.' },
      { time: '45 min', title: 'Research depth', prompt: 'Critique a claim, identify alternative explanations, and design discriminating ablations.' },
      { time: '35 min', title: 'ML breadth', prompt: 'Test mechanisms that connect algorithms to training or systems behavior.' },
      { time: '40 min', title: 'Project deep-dive', prompt: 'Probe research-to-production translation, a failed experiment, and the candidate’s personal decisions.' },
    ],
  },
  {
    id: 'staff-principal', role: 'Staff / Principal ML level overlay', duration: '4h 15m including breaks', observer: 'Use an experienced staff or principal IC who can challenge both technical mechanisms and organization-level claims.',
    rounds: [
      { time: '60 min', title: 'Multi-team architecture', prompt: 'Use the multi-team ML platform case. Change one constraint after the architecture, then probe state, failure, migration, ownership, and adoption.' },
      { time: '45 min', title: 'Technical strategy and portfolio', prompt: 'Give three credible investments under one constraint. Require an order, opportunity cost, quarterly checkpoints, and evidence that would stop or reverse the strategy.' },
      { time: '45 min', title: 'High-scope project deep-dive', prompt: 'Probe problem selection, personal authority, cross-team consequences, one wrong bet, operating results, and who carried the work afterward.' },
      { time: '35 min', title: 'Influence and recovery', prompt: 'Use one disagreement and one stopped or redirected project. Test incentives, evidence, cost of delay, and whether the candidate changed their own view.' },
      { time: '40 min', title: 'Retained domain depth', prompt: 'Choose one mechanism from the candidate’s primary role. Move from strategy to architecture to an algorithm, invariant, experiment, or failure trace.' },
    ],
  },
  {
    id: 'senior-principal', role: 'Senior Principal / Distinguished ML level overlay', duration: '4h 40m including breaks', observer: 'Use a principal, distinguished engineer, research leader, or equivalent upper IC who can challenge delegated authority and technical depth.',
    rounds: [
      { time: '60 min', title: 'Enterprise agent architecture', prompt: 'Use the enterprise agent-platform case. Probe authority, unknown side effects, memory, regional policy, evaluation, migration, and one deep technical invariant.' },
      { time: '55 min', title: 'Multi-portfolio technical strategy', prompt: 'Balance product, platform, model, security, migration, and retirement investments. Require opportunity cost, checkpoints, and reversal evidence.' },
      { time: '45 min', title: 'Delegated technical leadership', prompt: 'Define principal-owned domains, decision rights, interface review, incident authority, and escalation without centralizing every choice.' },
      { time: '45 min', title: 'Durability under external change', prompt: 'Change a vendor, regulation, region, or organization assumption. Test doctrine, portability, succession, and which decisions reopen.' },
      { time: '45 min', title: 'Retained domain depth', prompt: 'Move from company-level direction to one algorithm, experiment, distributed invariant, security boundary, or performance model.' },
    ],
  },
  {
    id: 'upper-ic-reasoning', role: 'Upper-IC reasoning-systems transfer', duration: '4h 25m including breaks', observer: 'Use a research or systems leader who can challenge compute arithmetic, evaluation support, serving constraints, and portfolio claims.',
    rounds: [
      { time: '60 min', title: 'Reasoning under fixed compute', prompt: 'Allocate fixed capacity across training, post-training, evaluation, and serving. Require arithmetic, routing, stopping rules, and graceful degradation.' },
      { time: '50 min', title: 'Verifier and evaluation strategy', prompt: 'Probe verifier support, false acceptance, correlated errors, severe tails, held-out families, and evidence that changes the allocation.' },
      { time: '45 min', title: 'Serving and recovery', prompt: 'Change request mix, KV pressure, or provider availability. Require admission control, fallback, state preservation, and recovery.' },
      { time: '45 min', title: 'Portfolio and delegated ownership', prompt: 'Partition model, verifier, serving, evaluation, and product decisions across technical leaders with explicit review checkpoints.' },
      { time: '35 min', title: 'Project evidence', prompt: 'Test one real capacity, quality, or research decision for ownership, failure, update, and measured outcome.' },
    ],
  },
  {
    id: 'upper-ic-ecosystem', role: 'Upper-IC ecosystem-ranking transfer', duration: '4h 15m including breaks', observer: 'Use a ranking, marketplace, experimentation, or product leader who can challenge causal claims and participant trade-offs.',
    rounds: [
      { time: '60 min', title: 'Short-form video ecosystem design', prompt: 'Balance viewer value, creator opportunity, quality, revenue, and concentration without hiding policy in one weighted score.' },
      { time: '50 min', title: 'Causal evidence and feedback loops', prompt: 'Probe exposure bias, interference, exploration, cohort maturity, long horizons, and what cannot be learned from one experiment.' },
      { time: '45 min', title: 'Incident and rollback', prompt: 'A watch-time win damages creator retention. Require containment, rollback, diagnosis, compensation, and a safe next experiment.' },
      { time: '45 min', title: 'Governance and portfolio', prompt: 'Assign metric authority and decision rights across ranking, product, integrity, creator, and revenue leaders. Define reversal evidence.' },
      { time: '35 min', title: 'Retained ranking depth', prompt: 'Probe one objective, calibration, counterfactual estimator, exploration policy, or serving constraint below the strategy.' },
    ],
  },
];

const frontierPackets = [
  {
    id: 'frontier-engineering',
    title: 'Agentic engineering loop',
    rule: 'Use only when the confirmed loop includes an authorized coding agent, an existing codebase, or a technical presentation.',
    rounds: [
      ['60 min', 'Agentic ML codebase', 'Run the evaluation-service lab. Score codebase mapping, bounded delegation, diff review, tests, and explanation.'],
      ['45 min', 'LLM inference design', 'Design admission, batching, KV capacity, fairness, overload, and quality-preserving degradation.'],
      ['45 min', 'Technical presentation', 'Present for 30 minutes and reserve 15 for interrupted questions on ownership, evidence, and counterfactuals.'],
      ['30 min', 'Collaboration and values', 'Probe one cross-functional conflict and one decision with a real safety, quality, or user-cost tension.'],
    ],
  },
  {
    id: 'frontier-research',
    title: 'Research work-sample loop',
    rule: 'Use only when the confirmed loop includes a notebook, API investigation, research brainstorm, paper discussion, or experiment review.',
    rounds: [
      ['90 min', 'Black-box investigation', 'Produce competing hypotheses, discriminating probes, a boundary condition, and a five-minute readout.'],
      ['45 min', 'Research depth', 'Critique one claim and design an ablation that separates it from the strongest alternative.'],
      ['30 min', 'Math oral', 'Draw two derivations and change one assumption in follow-up.'],
      ['45 min', 'Technical project defense', 'Defend one research-to-system project with failures, evidence, ownership, and transfer.'],
    ],
  },
  {
    id: 'frontier-performance',
    title: 'Performance and training-systems loop',
    rule: 'Use only for roles that name accelerators, kernels, distributed training, inference performance, or ML infrastructure.',
    rounds: [
      ['120 min', 'Accelerator work sample', 'Use the public challenge and experiment ledger. Require a trace-based hypothesis, measurement, and unchanged correctness tests.'],
      ['45 min', 'Fault-tolerant training design', 'Classify failures, define state consistency, and choose recovery scope.'],
      ['45 min', 'Frontier training incident', 'Diagnose a loss spike from rank-local evidence and preserve experimental validity.'],
      ['40 min', 'Project deep-dive', 'Probe one bottleneck, one failed optimization, and the candidate’s instrumentation choices.'],
    ],
  },
];

const unfamiliarPrompts = [
  'A company has historical project documents and wants to predict which future ML projects will succeed. Scope the problem before proposing a model.',
  'Your model improves the offline metric by 8% but hurts the online primary metric by 2%. Decide what to do next.',
  'Inference quality is fixed; cut annual serving cost by 60% without violating the p95 latency SLO.',
  'A new policy forbids storing raw labels after 24 hours. Redesign training, evaluation, and auditability.',
  'Two teams report opposite experiment results for the same model. Design the investigation.',
  'The strongest paper baseline is missing and the reported gain is within seed variance. Decide what evidence you need.',
  'Eight ML teams use incompatible training and release systems. Choose the first shared contract, migration sequence, ownership model, and stop condition.',
  'Forty teams use agents with incompatible tools and authority. Design the common contracts, delegated ownership, migration, and evidence that can reverse centralization.',
  'A reasoning-model program has a fixed cluster budget. Allocate training, verification, evaluation, and serving capacity, then define evidence that changes the allocation.',
  'A short-form video ranker raises watch time while creator retention falls. Contain the harm, investigate causality, and redesign objectives and decision rights.',
];
---

<PrepLayout
  title="Senior through senior-principal ML interview simulations"
  description="Role-specific ML mock loops plus staff, principal, and senior-principal level packets with timing, rubrics, and readiness gates."
  heading="Simulate the loop, not a favorite question."
  lede="A useful mock removes predictable cues, preserves real round timing, and produces bounded repair tasks. Run one early enough to improve and one only if the first exposed broad uncertainty."
>
  <section class="callout"><h2>Simulation rules</h2><ol><li>Use prompts the candidate has not rehearsed verbatim.</li><li>The observer must interrupt, clarify, and push back as a real interviewer would.</li><li>Score each round before discussing it; do not coach during the round.</li><li>Take 5–10 minute breaks, but do not read notes between rounds.</li><li>Turn misses into at most three repair tasks. A list of 20 problems is not a diagnosis.</li></ol></section>

  <div class="packet-actions"><button class="print-button" type="button" data-print>Print simulation packets</button></div>

  <section class="simulation-builder">
    <div><p class="builder-kicker">Quick builder</p><h2>Generate a concrete prompt set</h2><p>Select a role to draw one core-library prompt for each typical round. Regenerate to change prompts; replace any question the candidate rehearsed recently.</p></div>
    <div class="builder-controls"><label>Role<select data-builder-role>{ROLE_ORDER.map((id) => <option value={id}>{ROLE_OVERLAYS[id].label}</option>)}</select></label><button class="print-button" type="button" data-build-simulation>Build prompt set</button><button class="print-button" type="button" data-start-simulation>Start timed loop</button></div>
    <ol class="builder-output" data-builder-output hidden></ol>
  </section>

  <dialog class="simulation-dialog" data-simulation-dialog aria-labelledby="simulation-round-title">
    <div class="simulation-dialog-inner">
      <header><div><p data-simulation-position></p><h2 id="simulation-round-title" data-simulation-title></h2></div><button type="button" data-close-simulation aria-label="Close simulation">×</button></header>
      <p class="simulation-prompt"><a data-simulation-starter-link aria-label="Open related lesson after the simulation"></a><span data-simulation-prompt></span></p>
      <div class="simulation-timer"><strong data-simulation-timer role="timer" aria-label="Simulation time remaining">00:00</strong><button type="button" data-pause-simulation>Pause</button></div>
      <p class="sr-only" data-simulation-timer-status role="status" aria-live="polite"></p>
      <label>Private notes<textarea rows="7" data-simulation-notes placeholder="Outline evidence and follow-ups. Notes are cleared when this runner closes."></textarea></label>
      <p class="simulation-note">Do not open the linked answer during the round. Score after the timer or when you choose to stop.</p>
      <div class="simulation-actions"><button type="button" class="secondary-button" data-previous-simulation>Previous round</button><button type="button" data-next-simulation>Next round</button></div>
    </div>
  </dialog>

  {packets.map((packet) => (
    <section id={packet.id} class="packet">
      <header><p>Simulation packet</p><h2>{packet.role}</h2><span>{packet.duration}</span><p>{packet.observer}</p></header>
      <ol class="round-list">{packet.rounds.map((round, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{round.title} <small>{round.time}</small></h3><p>{round.prompt}</p></div></li>)}</ol>
    </section>
  ))}

  <h2>Frontier format overlays</h2>
  <p>These are not company packets. They model public, current work-sample formats and should be used only when recruiting confirms the corresponding round.</p>
  <div class="frontier-packets">
    {frontierPackets.map((packet) => <section id={packet.id} class="frontier-packet"><header><p>Format-specific packet</p><h3>{packet.title}</h3><span>{packet.rule}</span></header><ol>{packet.rounds.map(([time, title, prompt]) => <li><strong>{title}</strong><small>{time}</small><p>{prompt}</p></li>)}</ol></section>)}
  </div>

  <h2>Unfamiliar transfer prompt pool</h2>
  <p>Use one prompt the candidate has not seen. The goal is transfer of framing, evaluation, and trade-off patterns, not recall of a memorized architecture.</p>
  <ol class="prompt-pool">{unfamiliarPrompts.map((prompt) => <li>{prompt}</li>)}</ol>

  <section class="scorecard">
    <h2>Round scorecard</h2>
    <p>Score 0–2 before giving feedback: <strong>0 = missing or unsafe</strong>, <strong>1 = workable but inconsistent</strong>, <strong>2 = strong under follow-up</strong>.</p>
    <div class="score-grid">
      <label>Problem framing <select><option>0</option><option selected>1</option><option>2</option></select></label>
      <label>Technical correctness <select><option>0</option><option selected>1</option><option>2</option></select></label>
      <label>Depth under follow-up <select><option>0</option><option selected>1</option><option>2</option></select></label>
      <label>Trade-off judgment <select><option>0</option><option selected>1</option><option>2</option></select></label>
      <label>Evidence / testing <select><option>0</option><option selected>1</option><option>2</option></select></label>
      <label>Communication <select><option>0</option><option selected>1</option><option>2</option></select></label>
    </div>
    <label class="notes-label">Bounded feedback (keep private; never submitted)<textarea rows="5" placeholder="One strength, one highest-impact failure, one concrete retry instruction"></textarea></label>
  </section>

  <section class="gate-section">
    <h2>Go / risk / extend decision</h2>
    <div class="gate-grid">
      <article><h3>Green</h3><p>No critical dimension scores 0; every round has a workable structure; follow-ups reveal real depth; remaining misses are bounded.</p></article>
      <article><h3>Amber</h3><p>One critical round is inconsistent but responds to targeted repair. Keep the loop only if there is time for a spaced retry before it.</p></article>
      <article><h3>Red</h3><p>More than one critical round scores 0, ML implementation or design cannot reach a baseline in time, or stories lose ownership under follow-up. Extend or move the loop when possible.</p></article>
    </div>
  </section>

  <section class="callout"><h2>After the simulation</h2><ol><li>Write the failure as an observable behavior, not “study systems more.”</li><li>Choose one corrective drill and a due date.</li><li>Retry closed-book after spacing.</li><li>Graduate only after the repair survives a mixed session.</li></ol><p><a href="/prep/#queue">Open the Workbook →</a></p></section>
</PrepLayout>

<script>
  import { INTERVIEW_ROUNDS, ROLE_OVERLAYS, type RoleId } from '../../data/prepCurriculum';
  import { setActivityComplete } from '../../utils/activityProgress';
  import { trackPublicEvent } from '../../utils/publicEvents';
  trackPublicEvent('simulation_opened');
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  const select = document.querySelector<HTMLSelectElement>('[data-builder-role]');
  const output = document.querySelector<HTMLOListElement>('[data-builder-output]');
  const buildRounds = () => {
    if (!select) return [];
    const role = ROLE_OVERLAYS[select.value as RoleId];
    return role.defaultRounds.map((roundId) => INTERVIEW_ROUNDS.find((round) => round.id === roundId)).filter((round): round is (typeof INTERVIEW_ROUNDS)[number] => Boolean(round));
  };
  const dialog = document.querySelector<HTMLDialogElement>('[data-simulation-dialog]');
  const position = document.querySelector<HTMLElement>('[data-simulation-position]');
  const title = document.querySelector<HTMLElement>('[data-simulation-title]');
  const prompt = document.querySelector<HTMLElement>('[data-simulation-prompt]');
  const starterLink = document.querySelector<HTMLAnchorElement>('[data-simulation-starter-link]');
  const timer = document.querySelector<HTMLElement>('[data-simulation-timer]');
  const timerStatus = document.querySelector<HTMLElement>('[data-simulation-timer-status]');
  const pause = document.querySelector<HTMLButtonElement>('[data-pause-simulation]');
  const previous = document.querySelector<HTMLButtonElement>('[data-previous-simulation]');
  const next = document.querySelector<HTMLButtonElement>('[data-next-simulation]');
  const notes = document.querySelector<HTMLTextAreaElement>('[data-simulation-notes]');
  let activeRounds: ReturnType<typeof buildRounds> = [];
  let builtRole: RoleId | undefined;
  let builtStarters: Array<{ label: string; href: string }> = [];
  let activeStarters: Array<{ label: string; href: string }> = [];
  let activeIndex = 0;
  let remaining = 0;
  let paused = false;
  let interval: number | undefined;
  let deadline = 0;
  const roundNotes: string[] = [];

  const stopTimer = () => { if (interval !== undefined) window.clearInterval(interval); interval = undefined; };
  const showTime = () => { if (timer) timer.textContent = `${String(Math.floor(remaining / 60)).padStart(2, '0')}:${String(remaining % 60).padStart(2, '0')}`; };
  const refreshTimer = () => {
    if (paused || deadline === 0) return;
    remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
    showTime();
    if (remaining === 0) {
      stopTimer();
      if (timerStatus) timerStatus.textContent = 'Simulation time is up. Finish this round when ready.';
    }
  };
  const startTimer = () => {
    stopTimer();
    deadline = Date.now() + remaining * 1000;
    interval = window.setInterval(refreshTimer, 250);
  };
  const saveCurrentNotes = () => { if (notes) roundNotes[activeIndex] = notes.value; };
  const showRound = () => {
    const round = activeRounds[activeIndex];
    if (!round) return;
    remaining = round.minutes * 60;
    paused = false;
    if (position) position.textContent = `Round ${activeIndex + 1} of ${activeRounds.length}`;
    if (title) title.textContent = round.label;
    if (starterLink) {
      starterLink.href = activeStarters[activeIndex]?.href ?? '#';
      starterLink.textContent = activeStarters[activeIndex]?.label ?? round.label;
    }
    if (prompt) prompt.textContent = ` · ${round.description}`;
    if (pause) pause.textContent = 'Pause';
    if (previous) previous.disabled = activeIndex === 0;
    if (next) next.textContent = activeIndex === activeRounds.length - 1 ? 'Finish simulation' : 'Next round';
    if (notes) notes.value = roundNotes[activeIndex] ?? '';
    if (timerStatus) timerStatus.textContent = '';
    showTime(); startTimer();
  };
  const closeRunner = () => { stopTimer(); if (notes) notes.value = ''; roundNotes.length = 0; dialog?.close(); };
  const chooseStarters = (rounds: ReturnType<typeof buildRounds>) => rounds.map((round) => round.starterLinks[Math.floor(Math.random() * round.starterLinks.length)] ?? { label: round.label, href: '#' });
  const renderBuiltPromptSet = (rounds: ReturnType<typeof buildRounds>) => {
    if (!output) return;
    output.replaceChildren(...rounds.map((round, index) => {
      const item = document.createElement('li');
      const heading = document.createElement('strong');
      heading.textContent = `${round.label} · ${round.minutes} min`;
      const link = document.createElement('a');
      link.href = builtStarters[index]?.href ?? '#';
      link.textContent = builtStarters[index]?.label ?? round.label;
      const description = document.createElement('span');
      description.textContent = round.description;
      item.append(heading, link, description);
      return item;
    }));
    output.hidden = false;
  };
  const buildPromptSet = () => {
    if (!select) return [];
    const rounds = buildRounds();
    builtRole = select.value as RoleId;
    builtStarters = chooseStarters(rounds);
    renderBuiltPromptSet(rounds);
    return rounds;
  };
  document.querySelector('[data-start-simulation]')?.addEventListener('click', () => {
    activeRounds = buildRounds(); activeIndex = 0;
    const canReuseBuiltSet = builtRole === select?.value && builtStarters.length === activeRounds.length;
    activeStarters = canReuseBuiltSet ? [...builtStarters] : chooseStarters(activeRounds);
    roundNotes.length = 0;
    if (!dialog || activeRounds.length === 0) return;
    dialog.showModal(); showRound();
  });
  document.querySelector('[data-build-simulation]')?.addEventListener('click', () => { buildPromptSet(); });
  pause?.addEventListener('click', () => { refreshTimer(); paused = !paused; pause.textContent = paused ? 'Resume' : 'Pause'; if (paused) stopTimer(); else startTimer(); });
  previous?.addEventListener('click', () => {
    if (activeIndex === 0) return;
    saveCurrentNotes();
    stopTimer();
    activeIndex -= 1;
    showRound();
  });
  next?.addEventListener('click', () => {
    saveCurrentNotes();
    stopTimer();
    if (activeIndex >= activeRounds.length - 1) {
      if (select) { try { setActivityComplete(`simulation:${select.value}`); } catch { /* simulation still completed */ } }
      closeRunner();
      return;
    }
    activeIndex += 1; showRound();
  });
  document.querySelector('[data-close-simulation]')?.addEventListener('click', closeRunner);
  dialog?.addEventListener('cancel', closeRunner);
  document.addEventListener('visibilitychange', refreshTimer);
</script>

<style>
  .packet-actions { display: flex; justify-content: flex-end; }
  .simulation-builder { margin: 1rem 0 2rem; padding: 1rem; border: 2px solid var(--c-text); border-radius: var(--radius-lg); }
  .simulation-builder h2 { margin: .15rem 0 .4rem !important; }
  .simulation-builder > div > p:last-child { color: var(--c-text-soft); font-size: .85rem; }
  .builder-kicker { margin: 0; color: var(--c-accent); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }
  .builder-controls { display: flex; align-items: flex-end; gap: .7rem; }
  .builder-controls label { flex: 1; font-size: .8rem; font-weight: 700; }
  .builder-controls select { display: block; width: 100%; margin-top: .3rem; padding: .58rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; }
  .builder-output { margin: 1rem 0 0; padding: 0; list-style: none; }
  .builder-output li { display: grid; grid-template-columns: 12rem 1fr; gap: .2rem .7rem; padding: .65rem 0; border-top: 1px solid var(--c-rule); }
  .builder-output strong, .builder-output a, .builder-output span { display: block; }
  .builder-output span { grid-column: 2; color: var(--c-muted); font-size: .78rem; }
  .simulation-dialog { width: min(42rem, 94vw); max-height: 92vh; padding: 0; border: 1px solid var(--c-rule); border-radius: var(--radius-lg); background: var(--c-surface); color: var(--c-text); box-shadow: var(--shadow-lg); }
  .simulation-dialog::backdrop { background: rgba(15, 23, 42, .62); }
  .simulation-dialog-inner { max-height: 92vh; overflow-y: auto; padding: clamp(1rem, 4vw, 1.7rem); }
  .simulation-dialog header { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: .8rem; border-bottom: 1px solid var(--c-rule); }
  .simulation-dialog header p { margin: 0; color: var(--c-accent); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
