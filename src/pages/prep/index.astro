---
import PrepLayout from '../../layouts/PrepLayout.astro';
import { SITE } from '../../consts';
if (!SITE.features.prepTools) return Astro.redirect('/questions/', 302);
---

<PrepLayout
  title="Private ML interview workbook"
  description="One private, browser-local place for an ML interview plan, next practice task, due retries, and simulations."
  heading="Workbook"
  lede="The books explain the material. This companion keeps one plan, one next action, and the practice evidence stored on this device."
  eyebrow="Companion to the field guide"
>
  <p class="storage-warning" data-storage-warning aria-live="polite" hidden>Browser storage is unavailable. The books and question practice still work, but this device cannot save a plan or retry dates.</p>

  <section class="start-sheet" data-no-plan>
    <p class="section-kicker" data-start-kicker>Start here</p>
    <h2 data-start-title>Build one plan from your actual interview loop.</h2>
    <p data-start-copy>Select the role, rounds, and recent closed-book evidence that matter. The result becomes your private next-action list.</p>
    <div class="start-actions">
      <a class="primary-link" data-start-primary href="/prep/readiness/">Build my plan</a>
      <a data-start-secondary href="/questions/">Practice without a plan</a>
    </div>
  </section>

  <section class="plan-sheet" data-plan-context hidden>
    <header>
      <div><p class="section-kicker">Current plan</p><h2 data-plan-title></h2><p data-plan-summary></p></div>
      <a href="/prep/readiness/">Edit plan</a>
    </header>
    <section class="next-action" data-next-action hidden>
      <p>Do this next</p>
      <a data-next-link><strong data-next-title></strong><span data-next-detail></span></a>
    </section>
    <details class="later-tasks" data-later-tasks hidden>
      <summary>Next after this</summary>
      <ol data-later-list></ol>
    </details>
    <div class="external-blockers" data-plan-blockers hidden><strong>Prepare separately</strong><ul></ul></div>
  </section>

  <section class="study-map" data-study-map hidden aria-labelledby="study-map-heading">
    <header class="study-map-header">
      <div><p class="section-kicker">Your study map</p><h2 id="study-map-heading" data-route-title>Study the loop you actually have.</h2><p data-route-summary></p></div>
      <span class="study-map-week" data-route-week></span>
    </header>
    <div class="route-milestones" data-route-milestones></div>
    <section class="gap-route" aria-labelledby="gap-route-heading">
      <header><h3 id="gap-route-heading">Start with these gaps</h3><span>From your evidence check</span></header>
      <div class="gap-route-grid" data-gap-route-list></div>
    </section>
    <div class="round-route-grid" data-round-route-grid></div>
    <details class="role-sequence" data-role-sequence>
      <summary><strong data-role-sequence-title>Role sequence</strong><span>Study in order</span></summary>
      <ol data-role-sequence-list></ol>
    </details>
  </section>

  <section id="queue" class="record-sheet">
    <header>
      <div><p class="section-kicker">Practice record</p><h2>Due and recent work</h2></div>
      <p data-record-summary>No question attempts yet.</p>
    </header>
    <section class="empty-record" data-record-empty>
      <p>Question pages include a timer and round-specific scorecard. Start with one question, then return here only when a retry is due.</p>
      <a href="/questions/">Choose a question <span aria-hidden="true">→</span></a>
    </section>
    <div data-record-content hidden>
      <section class="due-section">
        <h3>Due now</h3>
        <div class="record-list" data-due-list></div>
      </section>
      <details class="other-records" data-other-records>
        <summary data-other-summary>Scheduled and completed</summary>
        <div class="record-list" data-other-list></div>
      </details>
    </div>
    <details class="backup" data-backup-controls hidden>
      <summary>Backup or reset this workbook</summary>
      <p>Export saves the plan, question record, and study completion marks as one JSON file.</p>
      <div><button type="button" data-export>Export</button><button type="button" data-import>Import</button><button class="danger" type="button" data-clear>Clear workbook</button><input type="file" accept="application/json" data-import-file hidden /></div>
    </details>
  </section>

  <details id="how-practice-works" class="method-sheet">
    <summary><strong>How practice works</strong><span>Three steps</span></summary>
    <ol>
      <li><strong>Attempt closed-book.</strong> Use Practice Mode on a question page. Speak, derive, design, or code until the timer ends.</li>
      <li><strong>Compare and score.</strong> Mark the observable gap before reading the reference answer.</li>
      <li><strong>Retry later.</strong> Weak returns in two days. Review returns in one week. A Confident result still needs spaced evidence.</li>
    </ol>
    <p><strong>Graduation rule:</strong> two successful attempts on different days, no critical weak dimension, one unfamiliar follow-up, and a later mixed-session pass.</p>
    <a href="/questions/">Choose a question <span aria-hidden="true">→</span></a>
  </details>

  <section class="next-stage">
    <h2>When the basics are working</h2>
    <ul>
      <li><a href="/prep/simulations/">Run a role-specific simulation</a> after every expected round has a baseline.</li>
      <li><a href="/prep/role-paths/">Open a role guide</a> when the next subject is unclear.</li>
    </ul>
    <details>
      <summary>Specialist and final-stage appendices</summary>
      <ul>
        <li><a href="/prep/labs/">Executable labs</a></li>
        <li><a href="/prep/frontier-labs/">Current interview formats</a></li>
        <li><a href="/prep/story-bank/">Story bank</a></li>
        <li><a href="/prep/final-week/">Final-week checklist</a></li>
        <li><a href="/prep/plans/">Printable planning templates</a></li>
      </ul>
    </details>
  </section>
</PrepLayout>

<script>
  import { clearPrepProgress, isPrepStorageAvailable, loadPrepProgress, markMixedSessionVerified, replacePrepProgress, toLocalDate, type PracticeProgressRecord } from '../../utils/prepProgress';
  import { clearPrepPlan, currentPlanWeek, loadPrepPlan, nextPrepTasks, parsePrepBackup, savePrepPlan } from '../../utils/prepPlan';
  import { getRolePath } from '../../data/rolePaths';
  import { INTERVIEW_ROUNDS } from '../../data/prepCurriculum';
  import { clearActivityProgress, loadActivityProgress, replaceActivityProgress } from '../../utils/activityProgress';
  import { trackPublicEvent } from '../../utils/publicEvents';

  const today = toLocalDate(new Date());
  const storageWarning = document.querySelector<HTMLElement>('[data-storage-warning]');
  const backupControls = document.querySelector<HTMLElement>('[data-backup-controls]');
  if (storageWarning) storageWarning.hidden = isPrepStorageAvailable();
  if (backupControls) backupControls.hidden = false;

  function dimensionLabel(value: string): string {
    return value.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function taskItem(title: string, detail: string, href: string): HTMLLIElement {
    const item = document.createElement('li');
    const link = document.createElement('a');
    link.href = href;
    const strong = document.createElement('strong');
    strong.textContent = title;
    const span = document.createElement('span');
    span.textContent = detail;
    link.append(strong, span);
    item.append(link);
    return item;
  }

  const roundMethods: Record<string, { how: string; repeat: string }> = {
    'ml-breadth': { how: 'Read one visual lesson, close it, then explain the mechanism, assumptions, failure mode, and one alternative in eight minutes.', repeat: 'Retry in two days with a different topic and one “why?” follow-up.' },
    coding: { how: 'Use Practice Mode: write the contract, examples, baseline, edge cases, and complexity before optimizing.', repeat: 'Retry in two to three days without looking at the reference implementation.' },
    'agentic-codebase': { how: 'Map the repository, give an agent one bounded change, inspect every diff, and run focused tests before widening the task.', repeat: 'Repeat weekly with a new codebase or failure; keep one unaided implementation session.' },
    'ml-system-design': { how: 'Scope the user and failure cost, then draw data, model, evaluation, serving, monitoring, and rollback before naming tools.', repeat: 'Retry in three days with a changed scale, latency, or reliability constraint.' },
    'project-deep-dive': { how: 'Record a 90-second opening, then rehearse three decisions with ownership, alternatives, evidence, failure, and update.', repeat: 'Repeat weekly with a new skeptical follow-up or observer.' },
    'technical-strategy': { how: 'Choose the problem, portfolio order, decision rights, stop conditions, migration cost, and what remains reversible.', repeat: 'Use the upper-IC path weekly; get an experienced person to challenge one premise.' },
    'technical-presentation': { how: 'Practice the talk from claims and decisions, not a script. Reserve time for interruption and technical descent.', repeat: 'Record one full run, repair three moments, then run it again after two days.' },
    behavioral: { how: 'Use a real story: situation, your decision, conflict or failure, measured result, and what you changed afterward.', repeat: 'Retell from prompts once a week; change the follow-up, not the facts.' },
    'values-mission': { how: 'Name the tension, affected people, principle, decision, consequence, and where new evidence would change your view.', repeat: 'Practice with pushback after three days; avoid slogans and invented certainty.' },
    'product-experimentation': { how: 'State the decision and causal question, choose the unit and metric, add guardrails, then define the ship rule.', repeat: 'Retry in three days with a different source of bias or product constraint.' },
    'research-depth': { how: 'State the claim, strongest alternative explanation, ablation, uncertainty, and the result that would change your mind.', repeat: 'Critique a new paper or method weekly, under a fixed time limit.' },
    'research-work-sample': { how: 'List competing hypotheses, choose the smallest discriminating probes, measure them, and give a short evidence readout.', repeat: 'Run a new case after three to seven days; do not reuse the same diagnosis.' },
    'math-oral': { how: 'Derive without notes, check dimensions and assumptions, then answer one changed-condition follow-up aloud.', repeat: 'Repeat every three to four days until the derivation is reliable under time pressure.' },
    'systems-infrastructure': { how: 'Estimate workload, memory, communication, latency, cost, failure recovery, and the bottleneck before choosing parallelism.', repeat: 'Retry in three days with a different scale or hardware constraint.' },
  };

  function textElement(tag: string, className: string, text: string): HTMLElement {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = text;
    return element;
  }

  function routeLink(label: string, href: string): HTMLAnchorElement {
    const link = document.createElement('a');
    link.href = href;
    link.textContent = label;
    return link;
  }

  function renderStudyMap(plan: ReturnType<typeof loadPrepPlan>): void {
    const map = document.querySelector<HTMLElement>('[data-study-map]');
    if (!map) return;
    if (!plan) {
      map.hidden = true;
      return;
    }
    map.hidden = false;
    const week = currentPlanWeek(plan);
    const title = map.querySelector<HTMLElement>('[data-route-title]');
    const summary = map.querySelector<HTMLElement>('[data-route-summary]');
    const weekLabel = map.querySelector<HTMLElement>('[data-route-week]');
    if (title) title.textContent = `${plan.roleLabel} study map`;
    if (summary) summary.textContent = `${plan.selectedRounds.length} confirmed rounds · ${plan.weeklyHours} hours/week · ${plan.horizon} weeks. Follow the round cards in order, then use the retry queue below.`;
    if (weekLabel) weekLabel.textContent = `Week ${week} of ${plan.horizon}`;

    const milestones = map.querySelector<HTMLElement>('[data-route-milestones]');
    if (milestones) {
      const phase = week === 1 ? 'Baseline' : week === plan.horizon ? 'Mixed practice' : 'Repair';
      milestones.replaceChildren(
        textElement('div', 'route-milestone route-milestone--active', `NOW · ${phase}`),
        textElement('div', 'route-milestone', 'NEXT · Retry the weakest round'),
        textElement('div', 'route-milestone', 'THEN · Run one mixed simulation'),
      );
    }

    const grid = map.querySelector<HTMLElement>('[data-round-route-grid]');
    if (grid) {
      grid.replaceChildren();
      plan.selectedRounds.forEach((roundId) => {
        const round = INTERVIEW_ROUNDS.find((item) => item.id === roundId);
        if (!round) return;
        const method = roundMethods[round.id] ?? { how: 'Attempt one representative question closed-book, compare against the reference, and record the missing step.', repeat: 'Retry after two or three days with a changed assumption.' };
        const card = document.createElement('article');
        card.className = 'round-route-card';
        card.append(textElement('p', 'round-route-label', round.label));
        card.append(textElement('h3', '', round.description));
        const study = document.createElement('p');
        study.className = 'round-route-method';
        study.append(textElement('strong', '', 'How: '), document.createTextNode(method.how));
        card.append(study);
        const repeat = document.createElement('p');
        repeat.className = 'round-route-repeat';
        repeat.append(textElement('strong', '', 'Repeat: '), document.createTextNode(method.repeat));
        card.append(repeat);
        const links = document.createElement('div');
        links.className = 'round-route-links';
        round.starterLinks.slice(0, 3).forEach((starter) => links.append(routeLink(starter.label, starter.href)));
        card.append(links);
        grid.append(card);
      });
    }

    const gapList = map.querySelector<HTMLElement>('[data-gap-route-list]');
    if (gapList) {
      gapList.replaceChildren(...plan.topGaps.slice(0, 3).map((gap) => {
        const card = document.createElement('article');
        card.className = 'gap-route-card';
        const heading = document.createElement('div');
        heading.className = 'gap-route-heading';
        heading.append(textElement('strong', '', gap.label), textElement('span', '', `${gap.rating}/5`));
        card.append(heading, textElement('p', '', gap.description));
        const links = document.createElement('div');
        links.className = 'gap-route-links';
        gap.starterLinks.slice(0, 2).forEach((starter) => links.append(routeLink(starter.label, starter.href)));
        card.append(links);
        return card;
      }));
    }

    const rolePath = getRolePath(plan.role);
    const sequenceTitle = map.querySelector<HTMLElement>('[data-role-sequence-title]');
    const sequenceList = map.querySelector<HTMLOListElement>('[data-role-sequence-list]');
    if (sequenceTitle) sequenceTitle.textContent = `${rolePath?.title ?? plan.roleLabel} sequence`;
    if (sequenceList) {
      sequenceList.replaceChildren(...(rolePath?.sequence ?? []).map((step, index) => {
        const item = document.createElement('li');
        const number = textElement('span', 'sequence-number', String(index + 1).padStart(2, '0'));
        const body = document.createElement('div');
        body.append(routeLink(step.title, step.href), textElement('p', '', step.detail));
        item.append(number, body);
        return item;
      }));
    }
  }

  function renderPlan(records: PracticeProgressRecord[]): void {
    const plan = loadPrepPlan();
    const context = document.querySelector<HTMLElement>('[data-plan-context]');
    const noPlan = document.querySelector<HTMLElement>('[data-no-plan]');
    if (context) context.hidden = !plan;
    if (noPlan) noPlan.hidden = Boolean(plan);

    if (!plan || !context) {
      const due = records.filter((record) => record.dueOn !== null && record.dueOn <= today);
      const kicker = document.querySelector<HTMLElement>('[data-start-kicker]');
      const title = document.querySelector<HTMLElement>('[data-start-title]');
      const copy = document.querySelector<HTMLElement>('[data-start-copy]');
      const primary = document.querySelector<HTMLAnchorElement>('[data-start-primary]');
      const secondary = document.querySelector<HTMLAnchorElement>('[data-start-secondary]');
      if (due.length > 0) {
        if (kicker) kicker.textContent = 'Due now';
        if (title) title.textContent = `${due.length} ${due.length === 1 ? 'question needs' : 'questions need'} another attempt.`;
        if (copy) copy.textContent = 'Complete due work before opening another topic. Keep the answer closed until the attempt ends.';
        if (primary) { primary.href = `/questions/${due[0].slug}/?practice=1`; primary.textContent = 'Practice the next due question'; }
        if (secondary) { secondary.href = '/prep/readiness/'; secondary.textContent = 'Build a plan'; }
      } else if (records.length > 0) {
        if (kicker) kicker.textContent = 'Continue';
        if (title) title.textContent = 'No retry is due today.';
        if (copy) copy.textContent = 'Choose one new question. Preserve spacing instead of repeating a familiar answer immediately.';
        if (primary) { primary.href = '/questions/'; primary.textContent = 'Choose a new question'; }
        if (secondary) { secondary.href = '/prep/readiness/'; secondary.textContent = 'Build a plan'; }
      }
      return;
    }

    const week = currentPlanWeek(plan);
    const title = context.querySelector<HTMLElement>('[data-plan-title]');
    const summary = context.querySelector<HTMLElement>('[data-plan-summary]');
    if (title) title.textContent = `${plan.roleLabel} · week ${week} of ${plan.horizon}`;
    if (summary) summary.textContent = `${plan.level.toUpperCase()} · ${plan.weeklyHours} hours/week · estimated ${plan.estimatedHours.low}–${plan.estimatedHours.high} hours · updated ${plan.updatedOn}`;

    const tasks = nextPrepTasks(plan, records, today);
    const nextAction = context.querySelector<HTMLElement>('[data-next-action]');
    const nextLink = context.querySelector<HTMLAnchorElement>('[data-next-link]');
    const nextTitle = context.querySelector<HTMLElement>('[data-next-title]');
    const nextDetail = context.querySelector<HTMLElement>('[data-next-detail]');
    const first = tasks[0];
    if (nextAction) nextAction.hidden = !first;
    if (first && nextLink && nextTitle && nextDetail) {
      nextLink.href = first.href;
      nextTitle.textContent = first.title;
      nextDetail.textContent = first.detail;
    }

    const later = context.querySelector<HTMLDetailsElement>('[data-later-tasks]');
    const laterList = context.querySelector<HTMLOListElement>('[data-later-list]');
    if (later) later.hidden = tasks.length < 2;
    if (laterList) laterList.replaceChildren(...tasks.slice(1).map((task) => taskItem(task.title, task.detail, task.href)));

    const blockerBox = context.querySelector<HTMLElement>('[data-plan-blockers]');
    const blockerList = blockerBox?.querySelector('ul');
    const blockers = plan.externalRounds.filter((item) => item.status === 'missing');
    if (blockerBox) blockerBox.hidden = blockers.length === 0;
    if (blockerList) blockerList.replaceChildren(...blockers.map((blocker) => Object.assign(document.createElement('li'), { textContent: blocker.label })));
  }

  function recordCard(record: PracticeProgressRecord): HTMLElement {
    const card = document.createElement('article');
    card.className = 'record-row';
    const header = document.createElement('header');
    const title = document.createElement('h4');
    const link = document.createElement('a');
    link.href = `/questions/${record.slug}/?practice=1`;
    link.textContent = record.title;
    title.append(link);
    const badge = document.createElement('span');
    badge.className = `score score--${record.score.toLowerCase()}`;
    badge.textContent = record.score;
    header.append(title, badge);

    const due = record.dueOn ? (record.dueOn <= today ? 'Due now' : `Due ${record.dueOn}`) : 'No retry scheduled';
    const meta = document.createElement('p');
    meta.textContent = `${record.attempts} attempt${record.attempts === 1 ? '' : 's'} · ${due}`;
    card.append(header, meta);

    if (record.weakDimensions.length > 0) {
      const gaps = document.createElement('p');
      gaps.className = 'gaps';
      gaps.textContent = `Repair: ${record.weakDimensions.map(dimensionLabel).join(', ')}`;
      card.append(gaps);
    }

    const eligibleForMixed = record.successfulAttempts >= 2 && record.weakDimensions.length === 0;
    if (eligibleForMixed && !record.mixedVerifiedOn) {
      const verify = document.createElement('button');
      verify.type = 'button';
      verify.className = 'verify-button';
      verify.textContent = 'Mark mixed-session pass';
      verify.addEventListener('click', () => {
        if (!window.confirm('Confirm this answer passed later with a changed prompt or unfamiliar follow-up?')) return;
        try { markMixedSessionVerified(record.slug); render(); }
        catch { if (storageWarning) storageWarning.hidden = false; }
      });
      card.append(verify);
    } else if (record.mixedVerifiedOn) {
      const graduated = document.createElement('p');
      graduated.className = 'graduated';
      graduated.textContent = `Graduated ${record.mixedVerifiedOn}`;
      card.append(graduated);
    }
    return card;
  }

  function render(): void {
    const records = loadPrepProgress().sort((left, right) => (left.dueOn ?? '9999').localeCompare(right.dueOn ?? '9999'));
    renderPlan(records);
    renderStudyMap(loadPrepPlan());
    const due = records.filter((record) => record.dueOn !== null && record.dueOn <= today);
    const other = records.filter((record) => !due.includes(record));
    const attempts = records.reduce((sum, record) => sum + record.attempts, 0);
    const study = Object.keys(loadActivityProgress().completed).length;
    const summary = document.querySelector<HTMLElement>('[data-record-summary]');
    if (summary) summary.textContent = records.length === 0
      ? `${study} study ${study === 1 ? 'item' : 'items'} completed`
      : `${records.length} ${records.length === 1 ? 'question' : 'questions'} · ${attempts} ${attempts === 1 ? 'attempt' : 'attempts'} · ${due.length} due · ${study} study items`;

    const empty = document.querySelector<HTMLElement>('[data-record-empty]');
    const content = document.querySelector<HTMLElement>('[data-record-content]');
    if (empty) empty.hidden = records.length > 0;
    if (content) content.hidden = records.length === 0;

    const dueList = document.querySelector<HTMLElement>('[data-due-list]');
    if (dueList) dueList.replaceChildren(...(due.length > 0
      ? due.map(recordCard)
      : [Object.assign(document.createElement('p'), { className: 'nothing-due', textContent: 'Nothing is due. Preserve spacing rather than retrying immediately.' })]));
    const otherList = document.querySelector<HTMLElement>('[data-other-list]');
    if (otherList) otherList.replaceChildren(...other.map(recordCard));
    const otherRecords = document.querySelector<HTMLDetailsElement>('[data-other-records]');
    const otherSummary = document.querySelector<HTMLElement>('[data-other-summary]');
    if (otherRecords) otherRecords.hidden = other.length === 0;
    if (otherSummary) otherSummary.textContent = `Scheduled and completed (${other.length})`;
  }

  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    if (!window.confirm('Clear the local plan, question record, and study completion marks?')) return;
    try { clearPrepProgress(); clearPrepPlan(); clearActivityProgress(); render(); }
    catch { if (storageWarning) storageWarning.hidden = false; }
  });

  document.querySelector('[data-export]')?.addEventListener('click', () => {
    const blob = new Blob([JSON.stringify({ version: 1, exportedOn: new Date().toISOString(), plan: loadPrepPlan(), records: loadPrepProgress(), activity: loadActivityProgress() }, null, 2)], { type: 'application/json' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'mlmentorship-workbook-backup.json';
    link.click();
    URL.revokeObjectURL(link.href);
  });

  const importFile = document.querySelector<HTMLInputElement>('[data-import-file]');
  document.querySelector('[data-import]')?.addEventListener('click', () => importFile?.click());
  importFile?.addEventListener('change', async () => {
    const file = importFile.files?.[0];
    if (!file) return;
    try {
      const backup = parsePrepBackup(JSON.parse(await file.text()));
      if (!backup) throw new Error('Invalid backup');
      const hasCurrentState = Boolean(loadPrepPlan()) || loadPrepProgress().length > 0 || Object.keys(loadActivityProgress().completed).length > 0;
      if (hasCurrentState && !window.confirm('Replace the current workbook plan, practice record, and completion marks with this backup?')) return;
      if (backup.plan) savePrepPlan(backup.plan); else clearPrepPlan();
      replacePrepProgress(backup.records);
      replaceActivityProgress(backup.activity);
      render();
    } catch {
      if (storageWarning) { storageWarning.textContent = 'This file is not a valid mlmentorship workbook backup.'; storageWarning.hidden = false; }
    } finally {
      importFile.value = '';
    }
  });

  try {
    Object.keys(localStorage).filter((key) => key.startsWith('mlm:practice:')).forEach((key) => localStorage.removeItem(key));
  } catch {
    if (storageWarning) storageWarning.hidden = false;
  }
  const anchoredDetails = window.location.hash ? document.querySelector<HTMLDetailsElement>(window.location.hash) : null;
  if (anchoredDetails?.tagName === 'DETAILS') anchoredDetails.open = true;
  render();
  window.addEventListener('storage', render);
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') render(); });
  trackPublicEvent('workbook_opened');
</script>

<style>
  .storage-warning { margin: 0 0 1rem; padding: .75rem .85rem; border-left: 3px solid #b45309; background: var(--c-bg-tint); color: var(--c-text-soft); font-size: .82rem; }
  .section-kicker { margin: 0; color: var(--c-accent); font-family: var(--font-mono); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; }
  .start-sheet, .plan-sheet, .record-sheet { margin: 0 0 1.7rem; padding: .8rem 0; border-top: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule); }
  .study-map { margin: 0 0 1.7rem; padding: .9rem 0 1.1rem; border-top: 2px solid var(--c-text); border-bottom: 1px solid var(--c-rule); }
  .study-map[hidden] { display: none; }
  .study-map-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
