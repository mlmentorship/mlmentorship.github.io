---
import PrepLayout from '../../layouts/PrepLayout.astro';
import { SITE } from '../../consts';
if (!SITE.features.prepTools) return Astro.redirect('/questions/', 302);
---

<PrepLayout
  title="Private ML interview progress and retry queue"
  description="A local-only queue for spaced interview practice retries, repeated rubric gaps, and evidence-based graduation."
  heading="Track evidence, not hours spent."
  lede="Practice Mode can save question ID, score, weak rubric dimensions, attempt count, and due date on this device. No scratchpad or story text is included, and nothing is synchronized."
>
  <section class="privacy-note"><p><strong>Local-only progress.</strong> This page reads browser storage on this device. Clearing browser data removes it. Use Export if you want a private backup.</p><div><button class="print-button" type="button" data-export>Export JSON</button><button class="print-button danger" type="button" data-clear>Clear all progress</button></div></section>

  <div class="progress-metrics" data-metrics><article><span>Questions tracked</span><strong data-question-count>0</strong></article><article><span>Total attempts</span><strong data-attempt-count>0</strong></article><article><span>Due now</span><strong data-due-count>0</strong></article><article><span>Graduated</span><strong data-graduated-count>0</strong></article></div>

  <section data-empty class="empty-state"><h2>No practice evidence yet</h2><p>Open any <a href="/questions/">question</a>, run Practice Mode, mark weak rubric dimensions, and select an overall score.</p></section>

  <section data-progress-content hidden>
    <h2>Due and weak</h2>
    <div class="record-list" data-due-list></div>

    <h2>Maintenance and graduated</h2>
    <div class="record-list" data-maintenance-list></div>

    <h2>Repeated weak dimensions</h2>
    <div class="dimension-list" data-dimension-list></div>
  </section>

  <section class="callout"><h2>Graduation rule</h2><p>A question graduates only after two <em>spaced</em> Confident attempts, no rubric dimension marked weak on the latest attempt, and a later mixed session that does not reopen the gap. This page records all three; only you or an observer can judge whether the mixed attempt genuinely used a changed cue or unfamiliar follow-up.</p></section>

  <section class="callout"><h2>What the queue cannot tell you</h2><p>Self-scoring is not external calibration. Record selected attempts and ask a peer or experienced interviewer to challenge the answer, especially for project ownership, L6 scope, implementation correctness, and communication under pushback.</p><p><a href="/prep/simulations/">Open role-specific simulation packets →</a></p></section>
</PrepLayout>

<script>
  import { clearPrepProgress, loadPrepProgress, markMixedSessionVerified, toLocalDate, type PracticeProgressRecord } from '../../utils/prepProgress';
  import { trackPublicEvent } from '../../utils/publicEvents';

  const today = toLocalDate(new Date());
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const content = document.querySelector<HTMLElement>('[data-progress-content]');

  function dimensionLabel(value: string): string {
    return value.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
  }

  function recordCard(record: PracticeProgressRecord): HTMLElement {
    const card = document.createElement('article');
    card.className = 'record-card';
    const header = document.createElement('div');
    const title = document.createElement('h3');
    const link = document.createElement('a');
    link.href = `/questions/${record.slug}/`;
    link.textContent = record.title;
    title.append(link);
    const badge = document.createElement('span');
    badge.className = `score score--${record.score.toLowerCase()}`;
    badge.textContent = record.score;
    header.append(title, badge);
    const meta = document.createElement('p');
    const due = record.dueOn ? (record.dueOn <= today ? `Due now · ${record.dueOn}` : `Due ${record.dueOn}`) : 'Maintenance';
    meta.textContent = `${record.mode} · ${record.attempts} attempt${record.attempts === 1 ? '' : 's'} · ${due}`;
    const evidence = document.createElement('p');
    evidence.className = 'evidence';
    const eligibleForMixed = record.successfulAttempts >= 2 && record.weakDimensions.length === 0;
    const graduated = eligibleForMixed && record.mixedVerifiedOn !== null;
    evidence.textContent = graduated
      ? `Graduated: 2 spaced successes and mixed-session pass recorded ${record.mixedVerifiedOn}.`
      : eligibleForMixed
        ? 'Two spaced successes recorded. Verify with a changed prompt in a mixed session.'
        : `Evidence gate: ${record.successfulAttempts}/2 spaced successes.`;
    card.append(header, meta, evidence);
    if (eligibleForMixed && !record.mixedVerifiedOn) {
      const verify = document.createElement('button');
      verify.type = 'button';
      verify.className = 'verify-button';
      verify.textContent = 'Mark mixed-session pass';
      verify.addEventListener('click', () => {
        if (!window.confirm('Confirm this answer passed later in an interleaved session with a changed prompt or unfamiliar follow-up?')) return;
        markMixedSessionVerified(record.slug);
        render();
      });
      card.append(verify);
    }
    if (record.weakDimensions.length > 0) {
      const gaps = document.createElement('ul');
      record.weakDimensions.forEach((dimension) => { const item = document.createElement('li'); item.textContent = `${dimensionLabel(dimension)} needs work`; gaps.append(item); });
      card.append(gaps);
    }
    return card;
  }

  function render(): void {
    const records = loadPrepProgress().sort((left, right) => (left.dueOn ?? '9999').localeCompare(right.dueOn ?? '9999'));
    const dueRecords = records.filter((record) => record.score !== 'Confident' || record.weakDimensions.length > 0 || record.mixedVerifiedOn === null || (record.dueOn !== null && record.dueOn <= today));
    const maintenance = records.filter((record) => !dueRecords.includes(record));
    const graduated = records.filter((record) => record.successfulAttempts >= 2 && record.weakDimensions.length === 0 && record.mixedVerifiedOn !== null);
    const attemptCount = records.reduce((sum, record) => sum + record.attempts, 0);
    const setText = (selector: string, value: number) => { const element = document.querySelector(selector); if (element) element.textContent = String(value); };
    setText('[data-question-count]', records.length);
    setText('[data-attempt-count]', attemptCount);
    setText('[data-due-count]', dueRecords.length);
    setText('[data-graduated-count]', graduated.length);
    if (empty) empty.hidden = records.length > 0;
    if (content) content.hidden = records.length === 0;
    const dueList = document.querySelector('[data-due-list]');
    const maintenanceList = document.querySelector('[data-maintenance-list]');
    if (dueList) dueList.replaceChildren(...(dueRecords.length ? dueRecords.map(recordCard) : [Object.assign(document.createElement('p'), { textContent: 'Nothing is due. Preserve spacing rather than retrying immediately.' })]));
    if (maintenanceList) maintenanceList.replaceChildren(...(maintenance.length ? maintenance.map(recordCard) : [Object.assign(document.createElement('p'), { textContent: 'No maintenance items yet.' })]));
    const dimensions = new Map<string, number>();
    records.forEach((record) => Object.entries(record.dimensionMisses).forEach(([dimension, count]) => dimensions.set(dimension, (dimensions.get(dimension) ?? 0) + count)));
    const dimensionList = document.querySelector('[data-dimension-list]');
    if (dimensionList) {
      dimensionList.replaceChildren(...[...dimensions.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([dimension, count]) => {
        const item = document.createElement('div');
        const label = document.createElement('span');
        label.textContent = dimensionLabel(dimension);
        const value = document.createElement('strong');
        value.textContent = `${count} miss${count === 1 ? '' : 'es'}`;
        item.append(label, value);
        return item;
      }));
    }
  }

  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    if (!window.confirm('Clear all locally stored practice scores and retry dates?')) return;
    clearPrepProgress();
    render();
  });
  document.querySelector('[data-export]')?.addEventListener('click', () => {
    const blob = new Blob([JSON.stringify({ version: 1, records: loadPrepProgress() }, null, 2)], { type: 'application/json' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'mlmentorship-prep-progress.json';
    link.click();
    URL.revokeObjectURL(link.href);
  });

  // Remove the obsolete score-only keys from the first public Practice Mode.
  Object.keys(localStorage).filter((key) => key.startsWith('mlm:practice:')).forEach((key) => localStorage.removeItem(key));
  render();
  trackPublicEvent('progress_opened');
</script>

<style>
  .privacy-note { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg-tint); }
  .privacy-note p { margin: 0; color: var(--c-text-soft); font-size: .86rem; }
  .privacy-note > div { display: flex; gap: .5rem; flex: 0 0 auto; }
  .danger { color: #b91c1c !important; }
  .progress-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: .65rem; margin: 1.2rem 0; }
  .progress-metrics article { padding: .85rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-surface); }
  .progress-metrics span, .progress-metrics strong { display: block; }
  .progress-metrics span { color: var(--c-muted); font-size: .7rem; letter-spacing: .05em; text-transform: uppercase; }
  .progress-metrics strong { margin-top: .2rem; font-size: 1.35rem; }
  .empty-state { padding: 1.2rem; border: 1px dashed var(--c-rule); border-radius: var(--radius); text-align: center; }
  .record-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .record-card { padding: .9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-surface); }
  .record-card > div { display: flex; align-items: flex-start; justify-content: space-between; gap: .6rem; }
  .record-card h3 { margin: 0 !important; font-size: .95rem !important; }
  .record-card p { margin: .4rem 0; color: var(--c-muted); font-size: .78rem; }
  .record-card .evidence { color: var(--c-text-soft); }
  .record-card ul { margin: .5rem 0 0; padding-left: 1rem; font-size: .78rem; }
  .verify-button { margin-top: .6rem; padding: .5rem .65rem; border: 1px solid var(--c-accent); border-radius: var(--radius); background: var(--c-accent-soft); color: var(--c-text); font: inherit; font-size: .76rem; font-weight: 700; cursor: pointer; }
  .score { flex: 0 0 auto; padding: .2rem .4rem; border-radius: 999px; background: var(--c-bg-tint); font-size: .68rem; font-weight: 700; }
  .score--weak { color: #b91c1c; }
  .score--confident { color: #166534; }
  .dimension-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: .5rem; }
  .dimension-list div { display: flex; justify-content: space-between; gap: 1rem; padding: .65rem; border: 1px solid var(--c-rule); border-radius: var(--radius); }
  .dimension-list strong { color: var(--c-accent); }
  @media (max-width: 720px) { .progress-metrics { grid-template-columns: repeat(2, 1fr); } .record-list, .dimension-list { grid-template-columns: 1fr; } .privacy-note { align-items: stretch; flex-direction: column; } .privacy-note > div, .privacy-note button { width: 100%; } }
</style>
