---
import PrepLayout from '../../layouts/PrepLayout.astro';
import { INTERVIEW_ROUNDS, KNOWLEDGE_AREAS, ROLE_ORDER, ROLE_OVERLAYS } from '../../data/prepCurriculum';
import { SITE } from '../../consts';
if (!SITE.features.prepTools) return Astro.redirect('/questions/', 302);

const domains = [
  { id: 'general', label: 'General / not sure' },
  { id: 'llm', label: 'LLM and agent systems' },
  { id: 'recsys', label: 'Recommendations, search, and ranking' },
  { id: 'platform', label: 'ML platform, training, and serving' },
  { id: 'research', label: 'Research and modeling' },
  { id: 'post-training', label: 'Post-training, RL, and agent environments' },
  { id: 'alignment', label: 'Alignment, safety, and model behavior' },
  { id: 'multimodal', label: 'Multimodal, vision, speech, or robotics' },
  { id: 'product', label: 'General product ML' },
];
const defaultRounds = new Set(ROLE_OVERLAYS['applied-scientist'].defaultRounds);
const externalDependencies = [
  { id: 'general-coding', label: 'General algorithms / DSA', note: 'Use a dedicated coding resource and record a recent timed baseline.' },
  { id: 'practical-software', label: 'Practical software, OOP, or concurrency', note: 'Practice a progressive stateful task outside this ML-specific library.' },
  { id: 'sql-data', label: 'SQL and data manipulation', note: 'Use a dedicated SQL resource with realistic event and experiment tables.' },
  { id: 'general-systems', label: 'General distributed-system design', note: 'Prepare storage, queues, consistency, partitioning, and failure semantics separately.' },
];
---

<PrepLayout
  title="Evidence-based ML interview readiness check"
  description="A private readiness and workload check for ML roles from mid-level through company-dependent senior-principal scope."
  heading="Estimate the work from evidence, not confidence."
  lede="Describe the actual loop, your available time, and what you can currently do under pressure. The result identifies three gaps, a realistic workload, and a 2-, 4-, or 8-week starting plan."
>
  <p class="privacy-note"><strong>No account, dates, identity, or answer text.</strong> Selections and calculations stay in this browser. Clearing browser data removes the saved plan; the Workbook can export a backup. Only coarse “started” and “completed” event names are counted.</p>

  <form id="readiness-form" class="readiness-form">
    <section class="panel" aria-labelledby="target-heading">
      <h2 id="target-heading">1. Target and capacity</h2>
      <div class="field-grid">
        <label><span>Role</span><select name="role" required>{ROLE_ORDER.map((id) => <option value={id}>{ROLE_OVERLAYS[id].label}</option>)}</select></label>
        <label><span>Target level</span><select name="level" required><option value="l4">L4 / mid-level</option><option value="l5" selected>L5 / senior</option><option value="l6">L6 / staff</option><option value="l7">L7 / principal</option><option value="l8">Senior principal / distinguished</option></select></label>
        <label><span>Primary domain</span><select name="domain" required>{domains.map((domain) => <option value={domain.id}>{domain.label}</option>)}</select></label>
        <label><span>Hours available each week</span><select name="hours" required><option value="5">About 5 hours</option><option value="8" selected>About 8 hours</option><option value="12">About 12 hours</option></select></label>
        <label><span>Weeks until the loop</span><select name="runway" required><option value="2">2 weeks</option><option value="4" selected>4 weeks</option><option value="6">6 weeks</option><option value="8">8 weeks</option><option value="12">12+ weeks</option></select></label>
      </div>
    </section>

    <fieldset class="panel rounds-panel">
      <legend>2. Actual interview rounds</legend>
      <div class="section-intro">
        <p>Select the formats the recruiter described, not every topic you might study. Domains such as LLMs and recommendations belong above, not here.</p>
        <button type="button" class="secondary-button" data-typical-rounds>Use typical rounds for this role</button>
      </div>
      <div class="choice-grid">
        {INTERVIEW_ROUNDS.map((round) => (
          <label class="choice"><input type="checkbox" name="rounds" value={round.id} checked={defaultRounds.has(round.id)} /><span><strong>{round.label}</strong><small>{round.description}</small></span></label>
        ))}
      </div>
      <p id="round-error" class="form-error" role="alert" hidden></p>
    </fieldset>

    <details class="external-check">
      <summary>Rounds outside this site's curriculum</summary>
      <p>Select only formats confirmed for your loop. These affect readiness, but mlmentorship intentionally does not duplicate dedicated coding, SQL, or general systems resources.</p>
      <div class="external-grid">
        {externalDependencies.map((dependency) => (
          <label>
            <span><strong>{dependency.label}</strong><small>{dependency.note}</small></span>
            <select name={`external:${dependency.id}`} data-external-label={dependency.label}>
              <option value="none">Not in my loop</option>
              <option value="missing">No recent timed baseline</option>
              <option value="workable">Workable timed baseline</option>
            </select>
          </label>
        ))}
      </div>
    </details>

    <fieldset class="panel">
      <legend>3. Current evidence</legend>
      <p class="help">Every area starts at 0. Change it only when you have evidence from a recent timed, closed-book attempt. “I understand it when reading” is not a 3.</p>
      <div class="rating-grid">
        {KNOWLEDGE_AREAS.map((area) => (
          <label class="rating-field" data-rating-area={area.id}><span>{area.label}</span><select name={`rating:${area.id}`} aria-label={`${area.label} evidence`}><option value="0">0 · not attempted recently</option><option value="1">1 · cannot structure an answer</option><option value="2">2 · needs notes or has major gaps</option><option value="3">3 · workable timed answer</option><option value="4">4 · handles one unfamiliar follow-up</option><option value="5">5 · two spaced successful attempts</option></select></label>
        ))}
      </div>
    </fieldset>

    <div class="form-actions"><button class="primary-button" type="submit">Build my prep starting point</button></div>
  </form>

  <section id="readiness-results" class="results" aria-live="polite" tabindex="-1" hidden data-pagefind-ignore="all">
    <header class="results-head"><div><p class="eyebrow">Evidence-based starting point</p><h2 id="result-title">Recommended plan</h2></div><a class="primary-button" href="/prep/">Open my workbook <span aria-hidden="true">→</span></a></header>
    <p id="plan-save-status" class="plan-save-status" aria-live="polite"></p>
    <p id="readiness-delta" class="readiness-delta" hidden></p>
    <p id="result-summary" class="result-summary"></p>
    <div class="result-metrics"><div><span>Estimated work</span><strong id="result-hours"></strong></div><div><span>Your capacity</span><strong id="result-capacity"></strong></div><div><span>Runway signal</span><strong id="result-runway"></strong></div></div>
    <h3>Your first three gaps</h3>
    <ol id="focus-list" class="focus-list">
      {[0, 1, 2].map((index) => <li data-focus-item><span class="focus-rank">{String(index + 1).padStart(2, '0')}</span><div><h4><a data-focus-link></a></h4><p data-focus-description></p><p class="starter-links" data-focus-starters></p></div></li>)}
    </ol>
    <section class="role-result"><h3 id="role-heading"></h3><p id="role-summary"></p><ul id="role-allocation"></ul><p id="role-warning" class="warning"></p></section>
    <section class="level-result"><h3 id="level-heading"></h3><p id="level-bar"></p><ul id="level-evidence"></ul><p id="level-warning" class="warning"></p><p><a id="level-path" href="/prep/level-paths/staff-principal/" hidden>Open the staff through senior-principal level path →</a></p></section>
    <section id="external-result" class="external-result" hidden><h3>External rounds to prepare separately</h3><ul id="external-result-list"></ul></section>
    <p class="domain-note">Domain selection changes gap priorities and examples. The Workbook will surface the role guide or simulation when it becomes the next useful task.</p>
    <section class="gate-note"><h3>Do not graduate a critical gap on confidence alone</h3><p>Require two successful closed-book attempts separated in time, no critical rubric dimension still weak, and one unfamiliar follow-up. Use the <a href="/prep/#queue">Workbook</a> to track that evidence.</p></section>
    <button id="reset-readiness" class="text-button" type="button">Run the check again</button>
  </section>
</PrepLayout>

<script>
  import { INTERVIEW_ROUNDS, KNOWLEDGE_AREAS, LEVEL_OVERLAYS, ROLE_OVERLAYS, type AreaId, type LevelId, type RoleId, type RoundId } from '../../data/prepCurriculum';
  import { loadPrepPlan, savePrepPlan, type PrepPlanState } from '../../utils/prepPlan';
  import { toLocalDate } from '../../utils/prepProgress';
  import { trackPublicEvent } from '../../utils/publicEvents';

  type Domain = 'general' | 'llm' | 'recsys' | 'platform' | 'research' | 'post-training' | 'alignment' | 'multimodal' | 'product';
  const roleAreaWeights: Record<RoleId, Record<AreaId, number>> = {
    'applied-scientist': { fundamentals: 1.2, production: .8, 'llm-systems': .8, 'recsys-search': .8, 'system-design': 1.2, experimentation: 1.25, behavioral: 1.15, 'math-research': 1, coding: .65 },
    'ml-engineer': { fundamentals: .9, production: 1.3, 'llm-systems': .8, 'recsys-search': .75, 'system-design': 1.25, experimentation: .75, behavioral: .75, 'math-research': .55, coding: 1.4 },
    'research-scientist': { fundamentals: 1.15, production: .55, 'llm-systems': .7, 'recsys-search': .45, 'system-design': .6, experimentation: 1.15, behavioral: .75, 'math-research': 1.5, coding: 1.05 },
    'research-engineer': { fundamentals: 1.05, production: 1.25, 'llm-systems': .9, 'recsys-search': .55, 'system-design': .85, experimentation: .65, behavioral: .65, 'math-research': 1.25, coding: 1.4 },
  };
  const domainWeights: Record<Domain, Partial<Record<AreaId, number>>> = {
    general: {},
    llm: { 'llm-systems': .8, production: .2 },
    recsys: { 'recsys-search': .8, experimentation: .2 },
    platform: { production: .8, coding: .25 },
    research: { 'math-research': .7, fundamentals: .25 },
    'post-training': { 'llm-systems': .55, 'math-research': .45, experimentation: .25, coding: .15 },
    alignment: { 'llm-systems': .45, 'math-research': .5, behavioral: .25, experimentation: .2 },
    multimodal: { fundamentals: .45, 'math-research': .35, production: .25, 'system-design': .2 },
    product: { experimentation: .55, 'system-design': .35, behavioral: .15 },
  };

  const form = document.querySelector<HTMLFormElement>('#readiness-form');
  const results = document.querySelector<HTMLElement>('#readiness-results');
  const roundError = document.querySelector<HTMLElement>('#round-error');
  let started = false;
  form?.addEventListener('input', () => { if (!started) { started = true; trackPublicEvent('readiness_started'); } }, { once: true });

  function activeEvidenceAreas(): Set<AreaId> {
    if (!form) return new Set();
    const data = new FormData(form);
    const domain = String(data.get('domain')) as Domain;
    const selectedRounds = new Set(data.getAll('rounds').map(String) as RoundId[]);
    const active = new Set<AreaId>();
    INTERVIEW_ROUNDS.filter((round) => selectedRounds.has(round.id)).forEach((round) => {
      Object.keys(round.areaWeights).forEach((area) => active.add(area as AreaId));
    });
    Object.entries(domainWeights[domain]).forEach(([area, weight]) => { if ((weight ?? 0) > 0) active.add(area as AreaId); });
    return active;
  }

  function updateEvidenceFields(): void {
    const active = activeEvidenceAreas();
    document.querySelectorAll<HTMLElement>('[data-rating-area]').forEach((field) => {
      field.hidden = !active.has(field.dataset.ratingArea as AreaId);
    });
  }

  const applyTypicalRounds = () => {
    if (!form) return;
    const data = new FormData(form);
    const role = String(data.get('role')) as RoleId;
    const level = String(data.get('level')) as LevelId;
    const defaults = new Set(ROLE_OVERLAYS[role].defaultRounds);
    if (level === 'l7' || level === 'l8') defaults.add('technical-strategy');
    form.querySelectorAll<HTMLInputElement>('input[name="rounds"]').forEach((input) => { input.checked = defaults.has(input.value as RoundId); });
    updateEvidenceFields();
  };
  document.querySelector('[data-typical-rounds]')?.addEventListener('click', applyTypicalRounds);
  form?.querySelector('select[name="role"]')?.addEventListener('change', applyTypicalRounds);
  form?.querySelector('select[name="level"]')?.addEventListener('change', applyTypicalRounds);
  form?.querySelectorAll('input[name="rounds"], select[name="domain"]').forEach((input) => input.addEventListener('change', updateEvidenceFields));
  const savedPlan = loadPrepPlan();
  if (form && savedPlan) {
    const setSelect = (name: string, value: string) => {
      const select = form.querySelector<HTMLSelectElement>(`select[name="${name}"]`);
      if (select && [...select.options].some((option) => option.value === value)) select.value = value;
    };
    setSelect('role', savedPlan.role);
    setSelect('level', savedPlan.level);
    setSelect('domain', savedPlan.domain);
    setSelect('hours', String(savedPlan.weeklyHours));
    setSelect('runway', String(savedPlan.availableWeeks));
    const savedRounds = new Set(savedPlan.selectedRounds);
    form.querySelectorAll<HTMLInputElement>('input[name="rounds"]').forEach((input) => { input.checked = savedRounds.has(input.value); });
    Object.entries(savedPlan.areaRatings).forEach(([area, rating]) => setSelect(`rating:${area}`, String(rating)));
    for (const external of savedPlan.externalRounds) {
      const select = [...form.querySelectorAll<HTMLSelectElement>('select[name^="external:"]')].find((field) => field.dataset.externalLabel === external.label);
      if (select) select.value = external.status;
    }
    const externalDetails = form.querySelector<HTMLDetailsElement>('details.external-check');
    if (externalDetails && savedPlan.externalRounds.length > 0) externalDetails.open = true;
  }
  updateEvidenceFields();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form || !results) return;
    const data = new FormData(form);
    const role = String(data.get('role')) as RoleId;
    const level = String(data.get('level')) as LevelId;
    const domain = String(data.get('domain')) as Domain;
    const weeklyHours = Number(data.get('hours'));
    const availableWeeks = Number(data.get('runway'));
    const selectedRounds = new Set(data.getAll('rounds').map(String) as RoundId[]);
    const externalFields = [...form.querySelectorAll<HTMLSelectElement>('select[name^="external:"]')];
    const selectedExternal = externalFields.filter((field) => field.value !== 'none');
    const missingExternal = selectedExternal.filter((field) => field.value === 'missing');
    if (selectedRounds.size < 2) {
      if (roundError) { roundError.textContent = 'Select at least two actual round formats.'; roundError.hidden = false; }
      form.querySelector<HTMLInputElement>('input[name="rounds"]')?.focus();
      return;
    }
    if (roundError) roundError.hidden = true;

    const roundAreaWeights: Partial<Record<AreaId, number>> = {};
    INTERVIEW_ROUNDS.filter((round) => selectedRounds.has(round.id)).forEach((round) => {
      Object.entries(round.areaWeights).forEach(([area, weight]) => { roundAreaWeights[area as AreaId] = (roundAreaWeights[area as AreaId] ?? 0) + weight; });
    });
    const activeAreas = activeEvidenceAreas();
    const scored = KNOWLEDGE_AREAS.filter((area) => activeAreas.has(area.id)).map((area) => {
      const rating = Number(data.get(`rating:${area.id}`));
      const relevance = roleAreaWeights[role][area.id] + (domainWeights[domain][area.id] ?? 0) + (roundAreaWeights[area.id] ?? 0);
      return { ...area, rating, relevance, score: (5 - rating) * relevance + (rating === 0 ? relevance : 0) };
    }).sort((left, right) => right.score - left.score || left.label.localeCompare(right.label));

    const relevanceTotal = scored.reduce((sum, item) => sum + item.relevance, 0);
    const weightedDeficit = scored.reduce((sum, item) => sum + (5 - item.rating) * item.relevance, 0) / relevanceTotal;
    const criticalWeak = scored.filter((item) => item.rating <= 2 && item.relevance >= 1.5).length;
    const levelHours = level === 'l8' ? 9 : level === 'l7' ? 6 : level === 'l6' ? 3 : level === 'l5' ? 1.5 : 0;
    const estimatedHours = 5 + selectedRounds.size * 1.25 + weightedDeficit * 5 + criticalWeak * 2 + levelHours;
    const rawWeeks = estimatedHours / weeklyHours;
    let horizon = rawWeeks <= 2.25 ? 2 : rawWeeks <= 4.5 ? 4 : 8;
    if (criticalWeak >= 3 && weeklyHours < 12) horizon = 8;
    const lowHours = Math.max(8, Math.round(estimatedHours * .85));
    const highHours = Math.ceil(estimatedHours * 1.15);
    const runwayStatus = missingExternal.length > 0
      ? `${missingExternal.length} external ${missingExternal.length === 1 ? 'round needs' : 'rounds need'} a baseline`
      : availableWeeks >= horizon
        ? 'Enough for the recommended plan'
        : `Short by about ${horizon - availableWeeks} week${horizon - availableWeeks === 1 ? '' : 's'}`;

    const roleMeta = ROLE_OVERLAYS[role];
    const resultTitle = document.querySelector<HTMLElement>('#result-title');
    const summary = document.querySelector<HTMLElement>('#result-summary');
    if (resultTitle) resultTitle.textContent = `${horizon}-week ${roleMeta.label} starting plan`;
    if (summary) {
      const baseSummary = availableWeeks >= horizon
        ? `Your evidence and ${weeklyHours}-hour weekly capacity support the ${horizon}-week framework. Treat this as a starting estimate and recalibrate after the first mixed simulation.`
        : `Your current evidence suggests a ${horizon}-week workload, but you reported ${availableWeeks} weeks. Triage to the actual rounds, reduce new topics, and consider moving the loop when possible.`;
      summary.textContent = missingExternal.length > 0
        ? `${baseSummary} This estimate does not include the time required to build ${missingExternal.length === 1 ? 'an external round' : 'external rounds'} from zero.`
        : baseSummary;
    }
    const hours = document.querySelector('#result-hours');
    const capacity = document.querySelector('#result-capacity');
    const runway = document.querySelector('#result-runway');
    if (hours) hours.textContent = `${lowHours}–${highHours} hours`;
    if (capacity) capacity.textContent = `${weeklyHours} hours/week`;
    if (runway) runway.textContent = runwayStatus;

    const focusItems = document.querySelectorAll<HTMLElement>('[data-focus-item]');
    scored.slice(0, 3).forEach((item, index) => {
      const link = focusItems[index]?.querySelector<HTMLAnchorElement>('[data-focus-link]');
      const description = focusItems[index]?.querySelector<HTMLElement>('[data-focus-description]');
      const starters = focusItems[index]?.querySelector<HTMLElement>('[data-focus-starters]');
      if (link) { link.href = item.link; link.textContent = item.label; }
      if (description) description.textContent = `${item.description} Current evidence: ${item.rating}/5.`;
      if (starters) {
        const children: Node[] = [document.createTextNode('Start: ')];
        item.starterLinks.forEach((starter, starterIndex) => {
          const starterLink = document.createElement('a');
          starterLink.href = starter.href;
          starterLink.textContent = starter.label;
          children.push(starterLink);
          if (starterIndex < item.starterLinks.length - 1) children.push(document.createTextNode(' · '));
        });
        starters.replaceChildren(...children);
      }
    });
    const roleHeading = document.querySelector('#role-heading');
    const roleSummary = document.querySelector('#role-summary');
    const roleWarning = document.querySelector('#role-warning');
    const allocation = document.querySelector('#role-allocation');
    if (roleHeading) roleHeading.textContent = `${roleMeta.label} workload overlay`;
    if (roleSummary) roleSummary.textContent = roleMeta.summary;
    if (roleWarning) roleWarning.textContent = roleMeta.warning;
    if (allocation) {
      allocation.replaceChildren(...roleMeta.allocation.map((item) => {
        const li = document.createElement('li');
        li.textContent = `${item.percent}% · ${item.label}`;
        return li;
      }));
    }
    const levelMeta = LEVEL_OVERLAYS[level];
    const levelHeading = document.querySelector<HTMLElement>('#level-heading');
    const levelBar = document.querySelector<HTMLElement>('#level-bar');
    const levelEvidence = document.querySelector<HTMLUListElement>('#level-evidence');
    const levelWarning = document.querySelector<HTMLElement>('#level-warning');
    const levelPath = document.querySelector<HTMLAnchorElement>('#level-path');
    if (levelHeading) levelHeading.textContent = `${levelMeta.label} evidence bar`;
    if (levelBar) levelBar.textContent = levelMeta.bar;
    if (levelEvidence) levelEvidence.replaceChildren(...levelMeta.evidence.map((evidence) => Object.assign(document.createElement('li'), { textContent: evidence })));
    if (levelWarning) levelWarning.textContent = levelMeta.commonFailure;
    if (levelPath) levelPath.hidden = level !== 'l6' && level !== 'l7' && level !== 'l8';
    const externalResult = document.querySelector<HTMLElement>('#external-result');
    const externalList = document.querySelector<HTMLUListElement>('#external-result-list');
    if (externalResult && externalList) {
      externalResult.hidden = selectedExternal.length === 0;
      externalList.replaceChildren(...selectedExternal.map((field) => {
        const item = document.createElement('li');
        const label = field.dataset.externalLabel ?? 'External round';
        item.textContent = field.value === 'missing'
          ? `${label}: no recent timed baseline. This remains a readiness blocker.`
          : `${label}: workable timed baseline reported. Maintain it outside this site.`;
        return item;
      }));
    }
    const today = toLocalDate(new Date());
    const existingPlan = loadPrepPlan();
    const improved = existingPlan?.areaRatings
      ? scored.filter((item) => item.rating > (existingPlan.areaRatings[item.id] ?? item.rating))
      : [];
    const plan: PrepPlanState = {
      version: 1,
      createdOn: existingPlan?.role === role ? existingPlan.createdOn : today,
      updatedOn: today,
      role,
      roleLabel: roleMeta.label,
      level,
      domain,
      weeklyHours,
      availableWeeks,
      horizon: horizon as 2 | 4 | 8,
      estimatedHours: { low: lowHours, high: highHours },
      selectedRounds: [...selectedRounds],
      areaRatings: Object.fromEntries(scored.map((item) => [item.id, item.rating])),
      topGaps: scored.slice(0, 3).map((item) => ({
        areaId: item.id,
        label: item.label,
        description: item.description,
        link: item.link,
        starterLinks: item.starterLinks,
        rating: item.rating,
      })),
      externalRounds: selectedExternal.map((field) => ({
        label: field.dataset.externalLabel ?? 'External round',
        status: field.value as 'missing' | 'workable',
      })),
    };
    const planSaveStatus = document.querySelector<HTMLElement>('#plan-save-status');
    const readinessDelta = document.querySelector<HTMLElement>('#readiness-delta');
    if (readinessDelta) {
      readinessDelta.hidden = !existingPlan;
      readinessDelta.textContent = existingPlan
        ? improved.length > 0
          ? `Since ${existingPlan.updatedOn}: improved ${improved.map((item) => item.label).join(', ')}. Areas not listed did not increase.`
          : `Compared with ${existingPlan.updatedOn}: no evidence rating increased. Keep the new plan only if the round mix or available time changed.`
        : '';
    }
    try {
      savePrepPlan(plan);
      if (planSaveStatus) planSaveStatus.textContent = 'Saved on this device. The Prep and Review pages will now show your next tasks.';
    } catch {
      if (planSaveStatus) planSaveStatus.textContent = 'The result is ready, but this browser blocked local plan storage.';
    }
    results.hidden = false;
    results.focus();
    trackPublicEvent('readiness_completed');
  });

  document.querySelector('#reset-readiness')?.addEventListener('click', () => {
    if (results) results.hidden = true;
    form?.querySelector<HTMLSelectElement>('select')?.focus({ preventScroll: true });
    form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .privacy-note { padding: .75rem .9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg-tint); color: var(--c-muted); font-size: .88rem; }
  .readiness-form { display: grid; gap: 1rem; }
  .panel { margin: 0; padding: clamp(1.1rem, 3vw, 1.6rem); border: 1px solid var(--c-rule); border-radius: var(--radius-lg); background: var(--c-surface); }
  .panel h2, .panel legend { margin: 0 0 .7rem; font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; }
  .panel legend { padding: 0 .35rem; }
  .field-grid, .rating-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem 1rem; }
  label > span { display: block; margin-bottom: .35rem; font-family: var(--font-ui); font-size: .84rem; font-weight: 700; }
  select { width: 100%; padding: .68rem .75rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; }
  .section-intro { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; }
  .section-intro p, .help { margin: 0; color: var(--c-muted); font-size: .88rem; }
