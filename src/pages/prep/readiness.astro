---
import PrepLayout from '../../layouts/PrepLayout.astro';
import { INTERVIEW_ROUNDS, KNOWLEDGE_AREAS, ROLE_OVERLAYS } from '../../data/prepCurriculum';
import { SITE } from '../../consts';
if (!SITE.features.prepTools) return Astro.redirect('/questions/', 302);

const domains = [
  { id: 'general', label: 'General / not sure' },
  { id: 'llm', label: 'LLM and agent systems' },
  { id: 'recsys', label: 'Recommendations, search, and ranking' },
  { id: 'platform', label: 'ML platform, training, and serving' },
  { id: 'research', label: 'Research and modeling' },
  { id: 'product', label: 'General product ML' },
];
const defaultRounds = new Set(ROLE_OVERLAYS['applied-scientist'].defaultRounds);
---

<PrepLayout
  title="Evidence-based ML interview readiness check"
  description="A private, browser-only readiness and workload check for Applied Scientist, MLE, and Research Engineer interviews."
  heading="Estimate the work from evidence, not confidence."
  lede="Describe the actual loop, your available time, and what you can currently do under pressure. The result identifies three gaps, a realistic workload, and a 2-, 4-, or 8-week starting plan."
>
  <p class="privacy-note"><strong>No account, dates, identity, or answer text.</strong> Selections and calculations stay in this browser. Only coarse “started” and “completed” event names are counted.</p>

  <form id="readiness-form" class="readiness-form">
    <section class="panel" aria-labelledby="target-heading">
      <h2 id="target-heading">1. Target and capacity</h2>
      <div class="field-grid">
        <label><span>Role</span><select name="role" required>{Object.entries(ROLE_OVERLAYS).map(([id, role]) => <option value={id}>{role.label}</option>)}</select></label>
        <label><span>Target level</span><select name="level" required><option value="l4">L4 / mid-level</option><option value="l5" selected>L5 / senior</option><option value="l6">L6 / staff</option></select></label>
        <label><span>Primary domain</span><select name="domain" required>{domains.map((domain) => <option value={domain.id}>{domain.label}</option>)}</select></label>
        <label><span>Hours available each week</span><select name="hours" required><option value="5">About 5 hours</option><option value="8" selected>About 8 hours</option><option value="12">About 12 hours</option></select></label>
        <label><span>Weeks until the loop</span><select name="runway" required><option value="2">2 weeks</option><option value="4" selected>4 weeks</option><option value="6">6 weeks</option><option value="8">8 weeks</option><option value="12">12+ weeks</option></select></label>
      </div>
    </section>

    <fieldset class="panel rounds-panel">
      <legend>2. Actual interview rounds</legend>
      <div class="section-intro">
        <p>Select the formats the recruiter described, not every topic you might study. Domains such as LLMs and recommendations belong above, not here.</p>
        <button type="button" class="secondary-button" data-typical-rounds>Use typical rounds for this role</button>
      </div>
      <div class="choice-grid">
        {INTERVIEW_ROUNDS.map((round) => (
          <label class="choice"><input type="checkbox" name="rounds" value={round.id} checked={defaultRounds.has(round.id)} /><span><strong>{round.label}</strong><small>{round.description}</small></span></label>
        ))}
      </div>
      <p id="round-error" class="form-error" role="alert" hidden></p>
    </fieldset>

    <fieldset class="panel">
      <legend>3. Current evidence</legend>
      <p class="help">Rate the best evidence you have from a recent timed, closed-book attempt. “I understand it when reading” is not a 3.</p>
      <div class="rating-grid">
        {KNOWLEDGE_AREAS.map((area) => (
          <label class="rating-field"><span>{area.label}</span><select name={`rating:${area.id}`} aria-label={`${area.label} evidence`}><option value="0">0 · not attempted</option><option value="1">1 · cannot structure an answer</option><option value="2">2 · needs notes or has major gaps</option><option value="3" selected>3 · workable timed answer</option><option value="4">4 · handles one unfamiliar follow-up</option><option value="5">5 · two spaced successful attempts</option></select></label>
        ))}
      </div>
    </fieldset>

    <div class="form-actions"><button class="primary-button" type="submit">Build my prep starting point</button></div>
  </form>

  <section id="readiness-results" class="results" aria-live="polite" tabindex="-1" hidden data-pagefind-ignore="all">
    <header class="results-head"><div><p class="eyebrow">Evidence-based starting point</p><h2 id="result-title">Recommended plan</h2></div><a id="plan-link" class="primary-button" href="/prep/plans/">Open the plan <span aria-hidden="true">→</span></a></header>
    <p id="result-summary" class="result-summary"></p>
    <div class="result-metrics"><div><span>Estimated work</span><strong id="result-hours"></strong></div><div><span>Your capacity</span><strong id="result-capacity"></strong></div><div><span>Runway signal</span><strong id="result-runway"></strong></div></div>
    <h3>Your first three gaps</h3>
    <ol id="focus-list" class="focus-list">
      {[0, 1, 2].map((index) => <li data-focus-item><span class="focus-rank">{String(index + 1).padStart(2, '0')}</span><div><h4><a data-focus-link></a></h4><p data-focus-description></p><p class="starter-links" data-focus-starters></p></div></li>)}
    </ol>
    <section class="role-result"><h3 id="role-heading"></h3><p id="role-summary"></p><ul id="role-allocation"></ul><p id="role-warning" class="warning"></p></section>
    <p class="domain-note">Domain selection changes gap priorities and examples. The plan structure remains role-based; add the matching <a href="/prep/role-paths/#domain-supplements">domain supplement</a> after the ordered role path.</p>
    <p><a id="role-path-link" href="/prep/role-paths/">Open the ordered role path →</a></p>
    <section class="gate-note"><h3>Do not graduate a critical gap on confidence alone</h3><p>Require two successful closed-book attempts separated in time, no critical rubric dimension still weak, and one unfamiliar follow-up. Use the <a href="/prep/progress/">local retry queue</a> to track that evidence.</p></section>
    <button id="reset-readiness" class="text-button" type="button">Run the check again</button>
  </section>
</PrepLayout>

<script>
  import { INTERVIEW_ROUNDS, KNOWLEDGE_AREAS, ROLE_OVERLAYS, type AreaId, type RoleId, type RoundId } from '../../data/prepCurriculum';
  import { trackPublicEvent } from '../../utils/publicEvents';

  type Domain = 'general' | 'llm' | 'recsys' | 'platform' | 'research' | 'product';
  const roleAreaWeights: Record<RoleId, Record<AreaId, number>> = {
    'applied-scientist': { fundamentals: 1.2, production: .8, 'llm-systems': .8, 'recsys-search': .8, 'system-design': 1.2, experimentation: 1.25, behavioral: 1.15, 'math-research': 1, coding: .65 },
    'ml-engineer': { fundamentals: .9, production: 1.3, 'llm-systems': .8, 'recsys-search': .75, 'system-design': 1.25, experimentation: .75, behavioral: .75, 'math-research': .55, coding: 1.4 },
    'research-engineer': { fundamentals: 1.05, production: 1.25, 'llm-systems': .9, 'recsys-search': .55, 'system-design': .85, experimentation: .65, behavioral: .65, 'math-research': 1.25, coding: 1.4 },
  };
  const domainWeights: Record<Domain, Partial<Record<AreaId, number>>> = {
    general: {}, llm: { 'llm-systems': .8, production: .2 }, recsys: { 'recsys-search': .8, experimentation: .2 }, platform: { production: .8, coding: .25 }, research: { 'math-research': .7, fundamentals: .25 }, product: { experimentation: .55, 'system-design': .35, behavioral: .15 },
  };

  const form = document.querySelector<HTMLFormElement>('#readiness-form');
  const results = document.querySelector<HTMLElement>('#readiness-results');
  const roundError = document.querySelector<HTMLElement>('#round-error');
  let started = false;
  form?.addEventListener('input', () => { if (!started) { started = true; trackPublicEvent('readiness_started'); } }, { once: true });

  document.querySelector('[data-typical-rounds]')?.addEventListener('click', () => {
    if (!form) return;
    const role = String(new FormData(form).get('role')) as RoleId;
    const defaults = new Set(ROLE_OVERLAYS[role].defaultRounds);
    form.querySelectorAll<HTMLInputElement>('input[name="rounds"]').forEach((input) => { input.checked = defaults.has(input.value as RoundId); });
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form || !results) return;
    const data = new FormData(form);
    const role = String(data.get('role')) as RoleId;
    const level = String(data.get('level'));
    const domain = String(data.get('domain')) as Domain;
    const weeklyHours = Number(data.get('hours'));
    const availableWeeks = Number(data.get('runway'));
    const selectedRounds = new Set(data.getAll('rounds').map(String) as RoundId[]);
    if (selectedRounds.size < 2) {
      if (roundError) { roundError.textContent = 'Select at least two actual round formats.'; roundError.hidden = false; }
      form.querySelector<HTMLInputElement>('input[name="rounds"]')?.focus();
      return;
    }
    if (roundError) roundError.hidden = true;

    const roundAreaWeights: Partial<Record<AreaId, number>> = {};
    INTERVIEW_ROUNDS.filter((round) => selectedRounds.has(round.id)).forEach((round) => {
      Object.entries(round.areaWeights).forEach(([area, weight]) => { roundAreaWeights[area as AreaId] = (roundAreaWeights[area as AreaId] ?? 0) + weight; });
    });
    const scored = KNOWLEDGE_AREAS.map((area) => {
      const rating = Number(data.get(`rating:${area.id}`));
      const relevance = roleAreaWeights[role][area.id] + (domainWeights[domain][area.id] ?? 0) + (roundAreaWeights[area.id] ?? 0);
      return { ...area, rating, relevance, score: (5 - rating) * relevance + (rating === 0 ? relevance : 0) };
    }).sort((left, right) => right.score - left.score || left.label.localeCompare(right.label));

    const relevanceTotal = scored.reduce((sum, item) => sum + item.relevance, 0);
    const weightedDeficit = scored.reduce((sum, item) => sum + (5 - item.rating) * item.relevance, 0) / relevanceTotal;
    const criticalWeak = scored.filter((item) => item.rating <= 2 && item.relevance >= 1.5).length;
    const levelHours = level === 'l6' ? 3 : level === 'l5' ? 1.5 : 0;
    const estimatedHours = 5 + selectedRounds.size * 1.25 + weightedDeficit * 5 + criticalWeak * 2 + levelHours;
    const rawWeeks = estimatedHours / weeklyHours;
    let horizon = rawWeeks <= 2.25 ? 2 : rawWeeks <= 4.5 ? 4 : 8;
    if (criticalWeak >= 3 && weeklyHours < 12) horizon = 8;
    const lowHours = Math.max(8, Math.round(estimatedHours * .85));
    const highHours = Math.ceil(estimatedHours * 1.15);
    const runwayStatus = availableWeeks >= horizon ? 'Enough for the recommended plan' : `Short by about ${horizon - availableWeeks} week${horizon - availableWeeks === 1 ? '' : 's'}`;

    const roleMeta = ROLE_OVERLAYS[role];
    const resultTitle = document.querySelector<HTMLElement>('#result-title');
    const summary = document.querySelector<HTMLElement>('#result-summary');
    const planLink = document.querySelector<HTMLAnchorElement>('#plan-link');
    if (resultTitle) resultTitle.textContent = `${horizon}-week ${roleMeta.label} starting plan`;
    if (summary) summary.textContent = availableWeeks >= horizon
      ? `Your evidence and ${weeklyHours}-hour weekly capacity support the ${horizon}-week framework. Treat this as a starting estimate and recalibrate after the first mixed simulation.`
      : `Your current evidence suggests a ${horizon}-week workload, but you reported ${availableWeeks} weeks. Triage to the actual rounds, reduce new topics, and consider moving the loop when possible.`;
    if (planLink) planLink.href = `/prep/plans/#plan-${horizon}-week`;
    const hours = document.querySelector('#result-hours');
    const capacity = document.querySelector('#result-capacity');
    const runway = document.querySelector('#result-runway');
    if (hours) hours.textContent = `${lowHours}–${highHours} hours`;
    if (capacity) capacity.textContent = `${weeklyHours} hours/week`;
    if (runway) runway.textContent = runwayStatus;

    const focusItems = document.querySelectorAll<HTMLElement>('[data-focus-item]');
    scored.slice(0, 3).forEach((item, index) => {
      const link = focusItems[index]?.querySelector<HTMLAnchorElement>('[data-focus-link]');
      const description = focusItems[index]?.querySelector<HTMLElement>('[data-focus-description]');
      const starters = focusItems[index]?.querySelector<HTMLElement>('[data-focus-starters]');
      if (link) { link.href = item.link; link.textContent = item.label; }
      if (description) description.textContent = `${item.description} Current evidence: ${item.rating}/5.`;
      if (starters) {
        const children: Node[] = [document.createTextNode('Start: ')];
        item.starterLinks.forEach((starter, starterIndex) => {
          const starterLink = document.createElement('a');
          starterLink.href = starter.href;
          starterLink.textContent = starter.label;
          children.push(starterLink);
          if (starterIndex < item.starterLinks.length - 1) children.push(document.createTextNode(' · '));
        });
        starters.replaceChildren(...children);
      }
    });
    const roleHeading = document.querySelector('#role-heading');
    const roleSummary = document.querySelector('#role-summary');
    const roleWarning = document.querySelector('#role-warning');
    const allocation = document.querySelector('#role-allocation');
    const rolePathLink = document.querySelector<HTMLAnchorElement>('#role-path-link');
    if (roleHeading) roleHeading.textContent = `${roleMeta.label} workload overlay`;
    if (roleSummary) roleSummary.textContent = roleMeta.summary;
    if (roleWarning) roleWarning.textContent = roleMeta.warning;
    if (allocation) {
      allocation.replaceChildren(...roleMeta.allocation.map((item) => {
        const li = document.createElement('li');
        li.textContent = `${item.percent}% · ${item.label}`;
        return li;
      }));
    }
    if (rolePathLink) rolePathLink.href = `/prep/role-paths/#${role}`;
    results.hidden = false;
    results.focus();
    trackPublicEvent('readiness_completed');
  });

  document.querySelector('#reset-readiness')?.addEventListener('click', () => {
    if (results) results.hidden = true;
    form?.querySelector<HTMLSelectElement>('select')?.focus({ preventScroll: true });
    form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .privacy-note { padding: .75rem .9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg-tint); color: var(--c-muted); font-size: .88rem; }
  .readiness-form { display: grid; gap: 1rem; }
  .panel { margin: 0; padding: clamp(1.1rem, 3vw, 1.6rem); border: 1px solid var(--c-rule); border-radius: var(--radius-lg); background: var(--c-surface); }
  .panel h2, .panel legend { margin: 0 0 .7rem; font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; }
  .panel legend { padding: 0 .35rem; }
  .field-grid, .rating-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem 1rem; }
  label > span { display: block; margin-bottom: .35rem; font-family: var(--font-ui); font-size: .84rem; font-weight: 700; }
  select { width: 100%; padding: .68rem .75rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; }
  .section-intro { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; }
  .section-intro p, .help { margin: 0; color: var(--c-muted); font-size: .88rem; }
  .secondary-button { flex: 0 0 auto; padding: .55rem .7rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; font-size: .8rem; font-weight: 700; cursor: pointer; }
  .choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
  .choice { display: flex; gap: .6rem; min-height: 4.2rem; padding: .72rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); cursor: pointer; }
  .choice input { margin-top: .2rem; accent-color: var(--c-accent-fill); }
  .choice span { margin: 0; }
  .choice strong, .choice small { display: block; }
  .choice small { margin-top: .2rem; color: var(--c-muted); font-weight: 400; line-height: 1.35; }
  .rating-field { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; align-items: center; gap: .7rem; }
  .rating-field span { margin: 0; }
  .form-actions { padding: .4rem 0 1.4rem; }
  .primary-button { display: inline-flex; align-items: center; justify-content: center; padding: .72rem 1rem; border: 0; border-radius: var(--radius); background: var(--c-accent-fill); color: var(--c-on-accent); font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
  .form-error { margin: .6rem 0 0; color: #b91c1c; font-weight: 700; }
  .results { margin-top: 2rem; padding: clamp(1.2rem, 3vw, 2rem); border: 2px solid var(--c-accent); border-radius: var(--radius-lg); background: var(--c-surface); outline: none; }
  .results[hidden] { display: none; }
  .results-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .results-head h2 { margin: 0; }
  .eyebrow { margin: 0 0 .35rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--c-accent); }
  .result-summary { color: var(--c-text-soft); }
  .result-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: .65rem; margin: 1.2rem 0; }
  .result-metrics div { padding: .75rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg-tint); }
  .result-metrics span, .result-metrics strong { display: block; }
  .result-metrics span { color: var(--c-muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; }
  .result-metrics strong { margin-top: .25rem; font-size: .9rem; }
  .focus-list { list-style: none; margin: 0 0 1.3rem; padding: 0; }
  .focus-list li { display: grid; grid-template-columns: 2rem 1fr; gap: .7rem; padding: .85rem 0; border-top: 1px solid var(--c-rule); }
  .focus-rank { font-family: var(--font-mono); color: var(--c-accent); font-size: .75rem; }
  .focus-list h4, .focus-list p { margin: 0; }
  .focus-list p { color: var(--c-text-soft); font-size: .88rem; }
  .focus-list .starter-links { margin-top: .3rem; color: var(--c-muted); font-size: .78rem; }
  .role-result, .gate-note { margin: 1rem 0; padding: 1rem; border-radius: var(--radius); background: var(--c-bg-tint); }
  .role-result h3, .gate-note h3 { margin-top: 0; }
  .role-result ul { columns: 2; }
  .warning { margin-bottom: 0; font-weight: 700; }
  .domain-note { padding: .7rem; border: 1px dashed var(--c-rule); border-radius: var(--radius); color: var(--c-text-soft); font-size: .84rem; }
  .text-button { padding: .6rem 0; border: 0; background: none; color: var(--c-link); font: inherit; text-decoration: underline; cursor: pointer; }
  @media (max-width: 720px) {
    .field-grid, .rating-grid, .choice-grid, .result-metrics { grid-template-columns: 1fr; }
    .rating-field { grid-template-columns: 1fr; gap: .25rem; }
    .section-intro, .results-head { align-items: stretch; flex-direction: column; }
    .role-result ul { columns: 1; }
    .primary-button { width: 100%; }
  }
</style>
