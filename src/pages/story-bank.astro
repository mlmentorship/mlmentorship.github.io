---
import PrepLayout from '../layouts/PrepLayout.astro';

const stories = [
  { label: 'Ambiguous problem', prompt: 'You created clarity when the goal, owner, or path was unclear.' },
  { label: 'Technical failure', prompt: 'A model, experiment, or system failed and you changed the outcome.' },
  { label: 'High-impact project', prompt: 'Your decisions produced a measurable result across a meaningful scope.' },
  { label: 'Disagreement', prompt: 'You challenged a decision, handled conflict, or changed your own position.' },
  { label: 'Trade-off under constraint', prompt: 'You balanced quality, time, cost, risk, or organizational limits.' },
  { label: 'Leadership without authority', prompt: 'You raised the quality or effectiveness of people beyond your own work.' },
];
---

<PrepLayout
  title="Senior ML interview story-bank worksheet"
  description="A private, printable worksheet for building evidence-rich senior ML interview stories."
  heading="Build six stories that carry real evidence."
  lede="Senior behavioral answers are not anecdotes. They are evidence of judgment, ownership, technical depth, and influence. Draft a compact story bank before rehearsing individual prompts."
>
  <section class="privacy-strip">
    <p><strong>Private by default:</strong> entries stay only on this page, are never submitted, and disappear when the page reloads. Avoid names or confidential company details.</p>
    <div>
      <button class="print-button" type="button" data-print>Print worksheet</button>
      <button class="print-button" type="button" data-clear>Clear entries</button>
    </div>
  </section>

  <h2>What every story must prove</h2>
  <ul class="proof-grid">
    <li><strong>Your decision:</strong> what judgment did you personally exercise?</li>
    <li><strong>Your mechanism:</strong> what did you do, not merely participate in?</li>
    <li><strong>Your evidence:</strong> what changed, and how do you know?</li>
    <li><strong>Your calibration:</strong> what would you repeat or change now?</li>
  </ul>

  <form class="story-form" autocomplete="off">
    {stories.map((story, index) => (
      <section class="story-card">
        <header>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><h2>{story.label}</h2><p>{story.prompt}</p></div>
        </header>
        <div class="story-fields">
          <label>
            <span>Story shorthand</span>
            <input type="text" placeholder="A memorable private label—not a company or person name" />
          </label>
          <label>
            <span>Situation and stakes</span>
            <textarea rows="3" placeholder="What mattered? Who was affected? What made the problem difficult?"></textarea>
          </label>
          <label>
            <span>Your decision and actions</span>
            <textarea rows="4" placeholder="What did you decide, why, and what did you personally do?"></textarea>
          </label>
          <label>
            <span>Result and evidence</span>
            <textarea rows="3" placeholder="Use defensible scale, direction, or metrics. Remove confidential details."></textarea>
          </label>
          <label>
            <span>Reflection and likely follow-up</span>
            <textarea rows="3" placeholder="What changed in your judgment? What would a skeptical interviewer ask next?"></textarea>
          </label>
        </div>
      </section>
    ))}
  </form>

  <h2>Coverage check</h2>
  <ul class="checklist">
    <li><label><input type="checkbox" /> At least two stories contain deep technical decisions.</label></li>
    <li><label><input type="checkbox" /> At least two show influence across people or teams.</label></li>
    <li><label><input type="checkbox" /> Every outcome has concrete evidence, not “it went well.”</label></li>
    <li><label><input type="checkbox" /> Every story distinguishes individual contribution from team contribution.</label></li>
    <li><label><input type="checkbox" /> No story exposes names, unreleased work, customer data, or confidential metrics.</label></li>
    <li><label><input type="checkbox" /> Each story can be told in two minutes, with deeper detail available for follow-ups.</label></li>
  </ul>

  <section class="callout">
    <h2>Next step</h2>
    <p>Choose one story and answer <a href="/questions/most-ambitious-project/">“Tell me about your most ambitious project”</a> in Practice Mode. The goal is not to memorize prose; it is to retrieve decisions and evidence reliably.</p>
  </section>
</PrepLayout>

<script>
  const fields = () => Array.from(document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.story-form input, .story-form textarea'));
  let priorHeights: string[] = [];

  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    if (!window.confirm('Clear every story-bank entry on this page?')) return;
    fields().forEach((field) => { field.value = ''; });
    document.querySelectorAll<HTMLInputElement>('.checklist input').forEach((checkbox) => { checkbox.checked = false; });
  });

  window.addEventListener('beforeprint', () => {
    const textareas = Array.from(document.querySelectorAll<HTMLTextAreaElement>('.story-form textarea'));
    priorHeights = textareas.map((textarea) => textarea.style.height);
    textareas.forEach((textarea) => { textarea.style.height = `${textarea.scrollHeight}px`; });
  });
  window.addEventListener('afterprint', () => {
    document.querySelectorAll<HTMLTextAreaElement>('.story-form textarea').forEach((textarea, index) => {
      textarea.style.height = priorHeights[index] ?? '';
    });
  });
</script>

<style>
  .privacy-strip { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg-tint); }
  .privacy-strip p { margin: 0; color: var(--c-text-soft); font-size: .88rem; }
  .privacy-strip > div { display: flex; gap: .5rem; flex: 0 0 auto; }
  .proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem 1.5rem; padding-left: 1.2rem; }
  .story-form { display: grid; gap: 1.2rem; margin-top: 1.5rem; }
  .story-card { padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--c-rule); border-radius: var(--radius-lg); background: var(--c-surface); break-inside: avoid; }
  .story-card > header { display: grid; grid-template-columns: 2rem 1fr; gap: .8rem; margin-bottom: 1rem; }
  .story-card > header > span { padding-top: .15rem; font-family: var(--font-mono); font-size: .75rem; color: var(--c-accent); }
  .story-card h2 { margin: 0 0 .2rem !important; font-size: 1.2rem !important; }
  .story-card header p { margin: 0; color: var(--c-text-soft); font-size: .88rem; }
  .story-fields { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .story-fields label:first-child { grid-column: 1 / -1; }
  .story-fields label > span { display: block; margin-bottom: .3rem; font-size: .8rem; font-weight: 700; }
  input[type='text'], textarea { width: 100%; padding: .65rem .7rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; line-height: 1.45; }
  textarea { resize: vertical; }
  .checklist { list-style: none; padding: 0; }
  .checklist li { padding: .55rem 0; border-bottom: 1px solid var(--c-rule-soft); }
  .checklist label { display: flex; align-items: flex-start; gap: .6rem; }
  .checklist input { margin-top: .35rem; accent-color: var(--c-accent-fill); }
  @media (max-width: 700px) {
    .privacy-strip { align-items: stretch; flex-direction: column; }
    .privacy-strip > div, .privacy-strip button { width: 100%; }
    .proof-grid, .story-fields { grid-template-columns: 1fr; }
    .story-fields label:first-child { grid-column: auto; }
  }
  @media print {
    .privacy-strip { display: none; }
    .story-card { break-inside: avoid-page; margin-bottom: .6rem; }
    input[type='text'], textarea { border-color: #aaa; background: #fff; color: #111; }
  }
</style>
