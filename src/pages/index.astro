---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LIBRARY_VOLUMES } from '../data/library';
import { entriesForChapter, getLibraryEntries } from '../utils/library';
import { getImplementedVisualAudit } from '../utils/visualAudits';
import Subscribe from '../components/Subscribe.astro';
import VisualPostList from '../components/VisualPostList.astro';

const entries = await getLibraryEntries();
const visualEntries = entries.filter((entry) => getImplementedVisualAudit(entry.slug));
const entryBySlug = new Map(entries.map((entry) => [entry.slug, entry]));
const volumeEntriesById = new Map(LIBRARY_VOLUMES.map((volume) => [
  volume.id,
  volume.chapters.flatMap((chapter) => entriesForChapter(entries, chapter)),
]));
const assignedHrefs = [...volumeEntriesById.values()].flatMap((entriesInVolume) => entriesInVolume.map((entry) => entry.href));
if (assignedHrefs.length !== entries.length || new Set(assignedHrefs).size !== entries.length) {
  throw new Error(`Library taxonomy must assign each published entry exactly once. Assigned ${assignedHrefs.length} references across ${new Set(assignedHrefs).size} unique entries; expected ${entries.length}.`);
}

function landingVisual(slug: string, visualId?: string) {
  const entry = entryBySlug.get(slug);
  const audit = entry ? getImplementedVisualAudit(slug) : undefined;
  const selectedVisualId = visualId ?? audit?.visualIds[0];
  if (!entry || !audit || !selectedVisualId) throw new Error(`Landing page visual is not implemented: ${slug}`);
  return {
    slug,
    title: entry.title,
    href: entry.href,
    visualId: selectedVisualId,
    objective: audit.learningObjective || entry.description || entry.title,
  };
}

const featuredPosts = [
  { ...landingVisual('matrices-as-linear-maps'), label: 'Foundations', note: 'Start with the shape behind the formula.' },
  { ...landingVisual('flashattention', 'flashattention-sram-tile-stream'), label: 'Frontier systems', note: 'See the memory movement that makes a kernel fast.' },
  { ...landingVisual('defend-values-under-ethical-pressure'), label: 'Interview judgment', note: 'Make the tradeoff explicit before you defend it.' },
];

const bookVisuals: Record<string, { slug: string; visualId?: string }> = {
  foundations: { slug: 'svd-and-pca' },
  'training-research': { slug: 'cross-entropy-softmax' },
  'evaluation-product': { slug: 'expected-calibration-error' },
  'llms-agents': { slug: 'transformer-architecture' },
  systems: { slug: 'sharded-matrix-multiplication' },
  'retrieval-ranking': { slug: 'tf-idf-and-bm25' },
  'reinforcement-learning': { slug: 'mdps-and-bellman-equations' },
  'vision-language-speech': { slug: 'vision-transformers' },
  'interview-practice': { slug: 'present-technical-ml-project' },
  'coding-interview': { slug: 'stable-softmax' },
};

const bookCards = LIBRARY_VOLUMES.map((volume) => {
  const visualSpec = bookVisuals[volume.id];
  const entriesInVolume = volumeEntriesById.get(volume.id) ?? [];
  if (!visualSpec || !entriesInVolume.some((entry) => entry.slug === visualSpec.slug)) {
    throw new Error(`Book ${volume.id} needs an anchor visual assigned from its own entries.`);
  }
  return { volume, entries: entriesInVolume, visual: landingVisual(visualSpec.slug, visualSpec.visualId) };
});
---

<BaseLayout
  title="A visual field guide for senior ML and AI systems interviews"
  description="A free visual field guide for senior ML, AI systems, and frontier-lab interviews, with ordered lessons, coding traces, role-specific routes, timed practice, and senior-to-principal calibration."
>
  <div class="landing-page">
    <header class="hero">
      <div class="cover-edition"><span>mlmentorship field guide</span><span>2026 edition</span></div>
      <div class="cover-title">
        <p class="eyebrow">ML from Primitives · senior to principal</p>
        <h1>The ML Interview Field Guide</h1>
        <p class="hero-copy">A free visual field guide for senior ML, AI systems, and frontier-lab interviews.</p>
      </div>

      <div class="cover-actions" aria-label="Choose where to begin">
        <a class="cover-primary cover-intent" href="/prep/readiness/" data-home-event="homepage_plan_clicked">
          <span class="cover-intent-context">I have an interview loop</span>
          <strong>Build my prep map</strong>
          <span class="cover-intent-arrow" aria-hidden="true">→</span>
        </a>
        <a class="cover-secondary cover-intent" href="/library/foundations/" data-home-event="homepage_start_clicked">
          <span class="cover-intent-context">Explore every topic</span>
          <strong>Browse the library</strong>
          <span class="cover-intent-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-meta">{visualEntries.length} visual lessons · {LIBRARY_VOLUMES.length} ordered books · free to read</p>
    </header>

    <section class="featured-posts" aria-labelledby="featured-posts-heading">
      <header class="section-head">
        <div><span class="section-kicker" id="featured-posts-heading">A few ideas, seen</span></div>
        <p>Three visual posts across foundations, systems, and interview judgment.</p>
      </header>
      <VisualPostList posts={featuredPosts} eager homeEvents />
    </section>

    <Subscribe placement="home" heading="Keep the field guide close." />

    <section id="curriculum" class="book-library" aria-labelledby="curriculum-heading">
      <header class="section-head">
        <div><span class="section-kicker">The field guide</span><h2 id="curriculum-heading">Ten books, each with a visual sample.</h2></div>
        <p>Each book carries a visual sample from its own lessons.</p>
      </header>
      <div class="book-grid">
        {bookCards.map(({ volume, visual }) => (
          <a class="book-card" data-book-card href={`/library/${volume.id}/`} data-home-event="homepage_curriculum_clicked">
            <header class="book-card-heading">
              <span class="book-card-number">{volume.number}</span>
              <h3>{volume.title}</h3>
            </header>
            <div class="landing-visual book-card-visual" data-landing-visual data-landing-visual-href={visual.href} data-landing-visual-id={visual.visualId} aria-label={`${volume.title} visual preview`} aria-busy="true">
              <p class="landing-visual-placeholder">Loading visual…</p>
            </div>
            <p class="book-card-explanation">{volume.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { trackPublicEvent, type PublicEventName } from '../utils/publicEvents';

  document.querySelectorAll<HTMLElement>('[data-home-event]').forEach((element) => {
    element.addEventListener('click', () => {
      const name = element.dataset.homeEvent as PublicEventName | undefined;
      if (name) trackPublicEvent(name);
    });
  });
</script>

<style>
  .landing-page { width: min(100%, 70rem); margin: 0 auto; padding: clamp(1.8rem, 4vw, 3rem) var(--gutter) 4.5rem; }
  .hero { position: relative; width: 100%; padding: 1.4rem 0 1.2rem 1.65rem; border-top: 1px solid var(--c-rule); border-bottom: 2px solid var(--c-text); border-left: 4px solid var(--c-accent); }
  .cover-edition { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; color: var(--c-muted); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  .cover-title { max-width: 35rem; margin-top: 3.2rem; }
  .eyebrow, .section-kicker { color: var(--c-accent); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 .55rem; }
  .hero h1 { max-width: 44rem; margin: 0 0 .7rem; font-size: 3.35rem; line-height: 1.02; letter-spacing: 0; }
  .hero-copy { max-width: 31rem; margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: 1.08rem; line-height: 1.5; }
  .cover-actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.45rem; }
  .cover-actions a { display: inline-flex; min-height: 2.65rem; align-items: center; justify-content: center; gap: .65rem; padding: .62rem .8rem; border: 1px solid var(--c-rule); border-radius: var(--radius); font-size: .76rem; font-weight: 700; text-decoration: none; }
  .cover-actions .cover-intent { position: relative; min-width: 15rem; align-items: flex-start; flex-direction: column; gap: .18rem; padding: .72rem 2.4rem .72rem .85rem; }
  .cover-intent-context { color: var(--c-muted); font-family: var(--font-mono); font-size: .6rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .cover-intent strong { color: inherit; font-size: .82rem; }
  .cover-intent-arrow { position: absolute; top: 50%; right: .85rem; transform: translateY(-50%); font-size: 1rem; }
  .cover-primary { border-color: var(--c-accent-fill) !important; background: var(--c-accent-fill); color: var(--c-on-accent); }
  .cover-primary .cover-intent-context { color: inherit; }
  .cover-primary:hover { background: var(--c-link-hover); color: var(--c-on-accent); }
  .cover-secondary { background: var(--c-surface); color: var(--c-text-soft); }
  .cover-secondary:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .hero-meta { margin: 1rem 0 0; padding-top: .65rem; border-top: 1px solid var(--c-rule); color: var(--c-muted); font-family: var(--font-mono); font-size: .6rem; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 1.2rem; margin-bottom: .7rem; padding-bottom: .65rem; border-bottom: 1px solid var(--c-rule); }
  .section-head h2 { margin: .22rem 0 0; font-size: clamp(1.35rem, 3vw, 1.72rem); line-height: 1.18; }
  .section-head > p { max-width: 18rem; margin: 0; color: var(--c-muted); font-size: .72rem; line-height: 1.45; text-align: right; }

  @media (max-width: 720px) {
    .section-head { align-items: flex-start; flex-direction: column; gap: .35rem; }
    .section-head > p { max-width: 38rem; text-align: left; }
  }
  @media (max-width: 600px) {
    .landing-page { padding-top: 1.4rem; }
    .hero { min-height: 0; padding-left: 1rem; }
    .cover-title { margin-top: 2rem; }
    .hero h1 { font-size: 2.55rem; }
    .cover-actions { display: grid; grid-template-columns: 1fr; }
    .cover-actions a { width: 100%; }
    .cover-actions .cover-intent { min-width: 0; }
  }

  .featured-posts,
  .book-library { padding-top: 2.8rem; scroll-margin-top: calc(var(--header-height) + .75rem); }
  .landing-visual { min-width: 0; }
  .landing-visual[aria-busy='true'] { opacity: .78; }
  .landing-visual :global(.learning-figure) { width: 100% !important; max-width: none !important; margin: 0 !important; }
  .landing-visual :global(.learning-figure > p),
  .landing-visual :global(.visual-kicker),
  .landing-visual :global(.visual-title) { display: none !important; }
  .landing-visual :global(.diagram-source) { display: none; }
  .landing-visual :global(.visual-scroll) { max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; }
  .landing-visual :global(.visual-wide svg),
  .landing-visual :global(.backprop-visual svg) { min-width: 0; }
  .landing-visual :global(svg) { max-width: 100%; height: auto; }
  .landing-visual-placeholder { min-height: 10rem; display: grid; place-items: center; margin: 0; border: 1px solid var(--c-rule); border-radius: var(--radius); color: var(--c-muted); font-family: var(--font-ui); font-size: .72rem; }
  .landing-visual-error { margin: 0; color: var(--c-muted); font-size: .72rem; }
  .landing-visual-error + a { display: inline-block; margin-top: .35rem; color: var(--c-accent); font-size: .7rem; }
  .book-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .8rem; }
  .book-card { min-width: 0; height: 22rem; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: .65rem; padding: .75rem; overflow: hidden; border: 1px solid var(--c-rule); border-radius: var(--radius-lg); background: var(--c-bg-tint); color: inherit; text-decoration: none; }
  .book-card:hover { border-color: var(--c-accent); background: var(--c-bg); }
  .book-card:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  .book-card-number { color: var(--c-accent); font-family: var(--font-mono); font-size: .7rem; }
  .book-card-heading { height: 2.9rem; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .7rem; align-items: start; min-width: 0; }
  .book-card-heading h3 { display: -webkit-box; overflow: hidden; margin: 0; color: var(--c-text); font-size: .8rem; line-height: 1.2; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .book-card-visual { width: 100%; height: 8.5rem; min-width: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .book-card-visual :global(.learning-figure) { width: 100% !important; height: 100%; max-width: 100% !important; overflow: hidden; }
  .book-card-visual :global(.learning-figure figcaption) { display: none; }
  .book-card-visual :global(.learning-figure > .visual-panel),
  .book-card-visual :global(.learning-figure > .visual-grid--two),
  .book-card-visual :global(.learning-figure > .visual-scroll),
  .book-card-visual :global(.coding-visual) { max-width: 100%; max-height: 100%; overflow: hidden; }
  .book-card-visual :global(.learning-figure > .visual-panel svg),
  .book-card-visual :global(.learning-figure > .visual-scroll svg),
  .book-card-visual :global(.learning-figure > .visual-grid--two svg),
  .book-card-visual :global(.learning-figure > svg) { width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; }
  .book-card-explanation { display: -webkit-box; min-height: 3.9rem; overflow: hidden; margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: .68rem; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
  .book-card-visual .landing-visual-placeholder { width: 100%; min-height: 7rem; }

  @media (max-width: 720px) {
    .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .featured-posts,
    .book-library { padding-top: 2.2rem; }
    .book-card { height: 21rem; }
    .book-card-visual { height: 7rem; }
  }
  @media (min-width: 721px) and (max-width: 1100px) {
    .book-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 420px) {
    .book-grid { grid-template-columns: 1fr; }
  }
</style>
