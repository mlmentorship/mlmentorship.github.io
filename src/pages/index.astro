---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LIBRARY_SHELVES, LIBRARY_VOLUMES } from '../data/library';
import { ROLE_PATHS } from '../data/rolePaths';
import { entriesForChapter, getLibraryEntries } from '../utils/library';
import { SITE } from '../consts';
import Subscribe from '../components/Subscribe.astro';

const entries = await getLibraryEntries();
const volumeStats = LIBRARY_VOLUMES.map((volume) => {
  const volumeEntries = volume.chapters.flatMap((chapter) => entriesForChapter(entries, chapter));
  return { volume, entries: volumeEntries, firstEntry: volumeEntries[0] };
});
const assignedHrefs = volumeStats.flatMap((item) => item.entries.map((entry) => entry.href));
if (assignedHrefs.length !== entries.length || new Set(assignedHrefs).size !== entries.length) {
  throw new Error(`Library taxonomy must assign each published entry exactly once. Assigned ${assignedHrefs.length} references across ${new Set(assignedHrefs).size} unique entries; expected ${entries.length}.`);
}
const volumeStatsById = new Map(volumeStats.map((item) => [item.volume.id, item]));
const shelfVolumeIds = LIBRARY_SHELVES.flatMap((shelf) => shelf.volumeIds);
if (shelfVolumeIds.length !== LIBRARY_VOLUMES.length || new Set(shelfVolumeIds).size !== LIBRARY_VOLUMES.length) {
  throw new Error('Library shelves must assign every volume exactly once.');
}

const questionCount = entries.filter((entry) => entry.category === 'questions').length;
const codingQuestionCount = volumeStatsById.get('coding-interview')?.entries.filter((entry) => entry.category === 'questions').length ?? 0;
if (codingQuestionCount === 0) throw new Error('Homepage coding route needs the coding interview volume.');
const deepCaseSlugs = [
  'personalized-search-ranking',
  'design-multi-team-ml-platform',
  'design-enterprise-agent-platform',
  'design-reasoning-model-fixed-budget',
  'design-real-time-multimodal-assistant',
  'design-ai-coding-product',
  'design-short-form-video-ecosystem',
  'design-foundation-model-data-platform',
  'design-agent-safety-control-plane',
];
const knownSlugs = new Set(entries.map((entry) => entry.slug));
if (deepCaseSlugs.some((slug) => !knownSlugs.has(slug))) throw new Error('Homepage deep-case proof list is stale.');

const valuePoints = [
  { title: 'See the mechanism', copy: 'Every entry leads with a visual. Coding traces expose the state, move, and invariant instead of asking you to memorize a solution.' },
  { title: 'Practice the round', copy: 'Questions cover coding, math, ML breadth, system design, research, product, project, behavioral, and strategy interviews.' },
  { title: 'Calibrate the depth', copy: 'Answers separate reliable execution, senior ownership, staff architecture, principal judgment, and company-dependent upper-IC scope.' },
];

const quickRoutes = [
  {
    cue: 'I know the round',
    title: 'Practice interview questions',
    copy: `${questionCount} questions organized by round, with strong-answer depth and observable rubrics.`,
    href: '/questions/',
    event: 'homepage_practice_clicked',
  },
  {
    cue: 'I want coding practice',
    title: 'Learn algorithms visually',
    copy: `${codingQuestionCount} step-by-step traces for patterns, data structures, and practical AI coding.`,
    href: '/library/coding-interview/',
    event: 'homepage_curriculum_clicked',
  },
  {
    cue: 'I know my role',
    title: 'Follow a role-specific route',
    copy: 'Applied Scientist, Research Scientist, MLE, and Research Engineer expectations without a one-size-fits-all loop.',
    href: SITE.features.prepTools ? '/prep/role-paths/' : '/guides/as-vs-mle-vs-re/',
    event: 'homepage_plan_clicked',
  },
  {
    cue: 'I want a sequence',
    title: `Study the ${LIBRARY_VOLUMES.length} books in order`,
    copy: 'Move from foundations through training, evaluation, frontier systems, specialist tracks, and interview execution.',
    href: '#curriculum',
    event: 'homepage_curriculum_clicked',
  },
];

const depthSamples = [
  { label: 'Reasoning systems', title: 'Train and serve a reasoning model under fixed compute', href: '/questions/design-reasoning-model-fixed-budget/' },
  { label: 'Live multimodal', title: 'Design a real-time multimodal assistant', href: '/questions/design-real-time-multimodal-assistant/' },
  { label: 'Upper-IC agents', title: 'Design an enterprise agent platform', href: '/questions/design-enterprise-agent-platform/' },
];
---

<BaseLayout
  title="Visual-first preparation for senior ML interviews"
  description="A visual-first field guide with ordered ML lessons, interview questions, coding traces, role-specific routes, timed practice, and senior-to-principal calibration."
>
  <div class="landing-page">
    <header class="hero">
      <div class="cover-edition"><span>mlmentorship field guide</span><span>2026 edition</span></div>
      <div class="cover-title">
        <p class="eyebrow">Visual-first · senior to principal</p>
        <h1>The ML Interview Field Guide</h1>
        <p class="hero-copy">A visual book for building the mechanisms, judgment, and answer depth expected across senior Applied Scientist, Research Scientist, Machine Learning Engineer, and Research Engineer interviews.</p>
      </div>

      <div class="cover-author">
        <span>Written and illustrated by</span>
        <strong>Hamidreza Saghir</strong>
        <small>Principal Applied Scientist · ML engineer · researcher</small>
      </div>

      <div class="cover-actions" aria-label="Choose a reading mode">
        <a class="cover-primary" href="/review/" data-home-event="homepage_start_clicked">Begin visual review <span aria-hidden="true">→</span></a>
        <a class="cover-secondary" href="#curriculum" data-home-event="homepage_curriculum_clicked">Browse full lessons <span aria-hidden="true">↓</span></a>
      </div>

      <button class="home-search" type="button" data-home-search aria-controls="search-dialog">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <span><strong>Search a topic or interview question</strong><small>Try “KV cache”, “binary search”, or “system design”</small></span>
        <kbd aria-hidden="true">/</kbd>
      </button>

      <ul class="hero-proof" aria-label="Field guide scope">
        <li><strong>{entries.length} visual lessons</strong><span>mechanisms before summaries</span></li>
        <li><strong>{questionCount} questions</strong><span>practice and answer calibration</span></li>
        <li><strong>{codingQuestionCount} coding traces</strong><span>state, move, and invariant</span></li>
        <li><strong>{LIBRARY_VOLUMES.length} ordered books</strong><span>foundations through execution</span></li>
      </ul>
      <p class="cover-folio">Free to read · no account required · progress stays in this browser</p>
    </header>

    <section class="route-section" aria-labelledby="route-heading">
      <header class="section-head">
        <div><span class="section-kicker">Start here</span><h2 id="route-heading">Choose the shortest route from what you already know.</h2></div>
        <p>You do not need to read the library front to back.</p>
      </header>
      <nav class="route-list" aria-label="Ways to start">
        <ol>
          {quickRoutes.map((route, index) => (
            <li>
              <a href={route.href} data-home-event={route.event}>
                <span class="route-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="route-copy"><small>{route.cue}</small><strong>{route.title}</strong><span>{route.copy}</span></span>
                <span class="route-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      {SITE.features.prepTools && (
        <p class="workbook-line"><span>Active interview loop?</span> <a href="/prep/readiness/" data-workbook-link data-home-event="homepage_plan_clicked">Build a private plan</a><span data-workbook-context> from your role, rounds, available time, and recent evidence. It stays in this browser.</span></p>
      )}
    </section>

    <Subscribe placement="home" />

    <section id="curriculum" class="curriculum" aria-labelledby="curriculum-heading">
      <header class="section-head">
        <div><span class="section-kicker">The curriculum</span><h2 id="curriculum-heading">{LIBRARY_VOLUMES.length} books, ordered from foundations to interview execution.</h2></div>
        <p>Open a book to inspect its chapters, or start reading its first entry now.</p>
      </header>

      {LIBRARY_SHELVES.map((shelf) => (
        <section class="shelf" id={shelf.id}>
          <header><h3>{shelf.title}</h3><p>{shelf.description}</p></header>
          <ol>
            {shelf.volumeIds.map((volumeId) => volumeStatsById.get(volumeId)).filter((item) => item !== undefined).map(({ volume, entries: volumeEntries, firstEntry }) => (
              <li>
                <span class="volume-number">{volume.number}</span>
                <div class="book-copy">
                  <h4><a href={`/library/${volume.id}/`} data-home-event="homepage_curriculum_clicked">{volume.title}</a></h4>
                  <p>{volume.description}</p>
                  <small>{volume.chapters.length} chapters · {volumeEntries.length} entries</small>
                </div>
                <div class="book-actions">
                  {firstEntry && <a class="start-link" href={`/review/#${firstEntry.slug}`} data-home-event="homepage_start_clicked">Start visually <span aria-hidden="true">→</span></a>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>

    <section class="value-section" aria-labelledby="value-heading">
      <header class="section-head">
        <div><span class="section-kicker">Why mlmentorship</span><h2 id="value-heading">Interview performance, not passive completion.</h2></div>
      </header>
      <div class="value-grid">
        {valuePoints.map((item) => <article><h3>{item.title}</h3><p>{item.copy}</p></article>)}
      </div>
      <p class="fit-line">Built for {ROLE_PATHS.map((role, index) => <>{index > 0 && (index === ROLE_PATHS.length - 1 ? ', and ' : ', ')}<a href={SITE.features.prepTools ? `/prep/role-paths/${role.id}/` : '/guides/as-vs-mle-vs-re/'}>{role.shortTitle}</a></>)} candidates. Generic algorithms, SQL, and backend curricula remain external.</p>
    </section>

    <section class="depth-section" aria-labelledby="depth-heading">
      <header class="section-head">
        <div><span class="section-kicker">Inspect the depth</span><h2 id="depth-heading">The design cases connect technical choices to evidence and ownership.</h2></div>
        <a href="/questions/#ml-system-design">All design questions</a>
      </header>
      <ol>
        {depthSamples.map((item, index) => (
          <li><a href={item.href}><span>{String(index + 1).padStart(2, '0')}</span><div><small>{item.label}</small><strong>{item.title}</strong></div><span aria-hidden="true">→</span></a></li>
        ))}
      </ol>
    </section>

    <section class="trust-section">
      <div><span class="section-kicker">Built from practice</span><h2>Specific, current, and honest about scope.</h2></div>
      <p>Written by Hamidreza Saghir, Principal Applied Scientist at Microsoft, with earlier ML engineering, applied-science, and research roles at X, Amazon, and Borealis AI. The site uses public process evidence, never leaked prompts or job-outcome promises. <a href="/about/">About the author and project</a>.</p>
    </section>
  </div>
</BaseLayout>

{SITE.features.prepTools && (
  <script>
    import { currentPlanWeek, loadPrepPlan } from '../utils/prepPlan';

    const workbookLink = document.querySelector<HTMLAnchorElement>('[data-workbook-link]');
    const workbookContext = document.querySelector<HTMLElement>('[data-workbook-context]');
    if (workbookLink && workbookContext) {
      const plan = loadPrepPlan();
      if (plan) {
        workbookLink.href = '/prep/';
        workbookLink.dataset.homeEvent = 'homepage_workbook_clicked';
        workbookLink.textContent = 'Continue my Workbook';
        workbookContext.textContent = ` · ${plan.roleLabel} · week ${currentPlanWeek(plan)} of ${plan.horizon}.`;
      }
    }
  </script>
)}

<script>
  import { trackPublicEvent, type PublicEventName } from '../utils/publicEvents';

  document.querySelector<HTMLButtonElement>('[data-home-search]')?.addEventListener('click', () => {
    document.getElementById('search-trigger')?.click();
  });

  document.querySelectorAll<HTMLElement>('[data-home-event]').forEach((element) => {
    element.addEventListener('click', () => {
      const name = element.dataset.homeEvent as PublicEventName | undefined;
      if (name) trackPublicEvent(name);
    });
  });
</script>

<style>
  .landing-page { width: min(100%, 54rem); margin: 0 auto; padding: clamp(1.8rem, 4vw, 3rem) var(--gutter) 4.5rem; }
  .hero { position: relative; max-width: 50rem; min-height: 34rem; padding: 1.4rem 0 1.2rem 1.65rem; border-top: 1px solid var(--c-rule); border-bottom: 2px solid var(--c-text); border-left: 4px solid var(--c-accent); }
  .cover-edition { display: flex; justify-content: space-between; gap: 1rem; color: var(--c-muted); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  .cover-title { max-width: 43rem; margin-top: 3.2rem; }
  .eyebrow, .section-kicker { color: var(--c-accent); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 .55rem; }
  .hero h1 { max-width: 44rem; margin: 0 0 .7rem; font-size: 3.35rem; line-height: 1.02; letter-spacing: 0; }
  .hero-copy { max-width: 42rem; margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: 1.05rem; line-height: 1.55; }
  .cover-author { display: grid; width: fit-content; margin-top: 1.45rem; padding-top: .65rem; border-top: 1px solid var(--c-rule); }
  .cover-author span, .cover-author small { color: var(--c-muted); font-family: var(--font-ui); font-size: .62rem; }
  .cover-author strong { margin: .08rem 0; font-family: var(--font-display); font-size: .85rem; }
  .cover-actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.3rem; }
  .cover-actions a { display: inline-flex; min-height: 2.65rem; align-items: center; justify-content: center; gap: .65rem; padding: .62rem .8rem; border: 1px solid var(--c-rule); border-radius: var(--radius); font-size: .76rem; font-weight: 700; text-decoration: none; }
  .cover-primary { border-color: var(--c-accent-fill) !important; background: var(--c-accent-fill); color: var(--c-on-accent); }
  .cover-primary:hover { background: var(--c-link-hover); color: var(--c-on-accent); }
  .cover-secondary { background: var(--c-surface); color: var(--c-text-soft); }
  .cover-secondary:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .home-search { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: .75rem; align-items: center; width: 100%; margin-top: 1.15rem; padding: .75rem .85rem; border: 1px solid var(--c-accent); border-radius: var(--radius); background: var(--c-surface); color: var(--c-text); cursor: pointer; text-align: left; }
  .home-search:hover { background: var(--c-accent-soft); }
  .home-search > svg { color: var(--c-accent); }
  .home-search > span, .home-search strong, .home-search small { display: block; }
  .home-search strong { font-size: .82rem; }
  .home-search small { margin-top: .1rem; color: var(--c-muted); font-size: .66rem; font-weight: 400; }
  .home-search kbd { min-width: 1.65rem; padding: .22rem .35rem; border: 1px solid var(--c-rule); border-bottom-width: 2px; border-radius: 3px; background: var(--c-bg); color: var(--c-muted); font-family: var(--font-mono); font-size: .68rem; text-align: center; }
  .hero-proof { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .7rem 1rem; margin: 1rem 0 0; padding: .75rem 0 0; border-top: 1px solid var(--c-rule); list-style: none; }
  .hero-proof li { margin: 0; }
  .hero-proof strong, .hero-proof span { display: block; }
  .hero-proof strong { font-size: .78rem; }
  .hero-proof span { color: var(--c-muted); font-size: .65rem; }
  .cover-folio { margin: .7rem 0 0; color: var(--c-muted); font-family: var(--font-mono); font-size: .58rem; text-align: right; }
  .workbook-line { margin: .7rem 0 0; color: var(--c-muted); font-size: .72rem; line-height: 1.45; }
  .workbook-line > span:first-child { color: var(--c-text-soft); font-weight: 600; }
  .workbook-line a { font-weight: 600; }
  .route-section, .curriculum, .value-section, .depth-section { padding-top: 2.5rem; scroll-margin-top: calc(var(--header-height) + .75rem); }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 1.2rem; margin-bottom: .7rem; padding-bottom: .65rem; border-bottom: 1px solid var(--c-rule); }
  .section-head h2, .trust-section h2 { margin: .22rem 0 0; font-size: clamp(1.35rem, 3vw, 1.72rem); line-height: 1.18; }
  .section-head > p { max-width: 18rem; margin: 0; color: var(--c-muted); font-size: .72rem; line-height: 1.45; text-align: right; }
  .section-head > a { flex: 0 0 auto; color: var(--c-muted); font-size: .72rem; }
  .route-list ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; padding: 0; border-top: 1px solid var(--c-rule); list-style: none; }
  .route-list li { min-width: 0; margin: 0; border-bottom: 1px solid var(--c-rule); }
  .route-list li:nth-child(odd) { padding-right: 1rem; border-right: 1px solid var(--c-rule); }
  .route-list li:nth-child(even) { padding-left: 1rem; }
  .route-list a { display: grid; grid-template-columns: 1.55rem minmax(0, 1fr) auto; gap: .55rem; align-items: start; height: 100%; padding: .8rem 0; color: inherit; text-decoration: none; }
  .route-number { padding-top: .12rem; color: var(--c-accent); font-family: var(--font-mono); font-size: .62rem; }
  .route-copy, .route-copy small, .route-copy strong, .route-copy > span { display: block; min-width: 0; }
  .route-copy small { color: var(--c-muted); font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; }
  .route-copy strong { margin-top: .08rem; font-size: .82rem; }
  .route-copy > span { margin-top: .15rem; color: var(--c-muted); font-family: var(--font-reading); font-size: .7rem; line-height: 1.4; }
  .route-arrow { align-self: center; color: var(--c-muted); font-size: .75rem; }
  .route-list a:hover .route-copy strong { color: var(--c-accent); text-decoration: underline; }
  .shelf { margin-top: 1.45rem; }
  .shelf > header { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: .8rem; align-items: baseline; margin-bottom: .35rem; }
  .shelf > header h3 { margin: 0; font-size: .88rem; }
  .shelf > header p { margin: 0; color: var(--c-muted); font-family: var(--font-reading); font-size: .75rem; line-height: 1.4; }
  .shelf > ol { margin: 0; padding: 0; border-top: 1px solid var(--c-rule); list-style: none; }
  .shelf > ol > li { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 7rem; gap: .7rem; align-items: start; margin: 0; padding: .75rem 0; border-bottom: 1px solid var(--c-rule); }
  .volume-number { padding-top: .12rem; color: var(--c-muted); font-size: .65rem; }
  .book-copy h4, .book-copy p { margin: 0; }
  .book-copy h4 { font-size: .9rem; }
  .book-copy h4 a { color: var(--c-text); text-decoration: none; }
  .book-copy h4 a:hover { color: var(--c-accent); text-decoration: underline; }
  .book-copy p { margin-top: .12rem; color: var(--c-muted); font-family: var(--font-reading); font-size: .75rem; line-height: 1.4; }
  .book-copy small { display: block; margin-top: .25rem; color: var(--c-muted); font-size: .62rem; }
  .book-actions { display: flex; align-items: flex-end; flex-direction: column; gap: .28rem; padding-top: .08rem; }
  .book-actions a { color: var(--c-muted); font-size: .66rem; text-align: right; }
  .book-actions .start-link { color: var(--c-accent); font-weight: 650; text-decoration: none; }
  .book-actions .start-link:hover { text-decoration: underline; }
  .value-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--c-rule); }
  .value-grid article { padding: .85rem .9rem .85rem 0; border-bottom: 1px solid var(--c-rule); }
  .value-grid article:not(:last-child) { margin-right: .9rem; border-right: 1px solid var(--c-rule); }
  .value-grid h3, .value-grid p { margin: 0; }
  .value-grid h3 { font-size: .82rem; }
  .value-grid p { margin-top: .2rem; color: var(--c-muted); font-size: .72rem; line-height: 1.45; }
  .fit-line { margin: .75rem 0 0; color: var(--c-text-soft); font-size: .75rem; }
  .depth-section > ol { margin: 0; padding: 0; border-top: 1px solid var(--c-rule); list-style: none; }
  .depth-section li { margin: 0; border-bottom: 1px solid var(--c-rule); }
  .depth-section li > a { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; gap: .7rem; padding: .75rem 0; color: inherit; text-decoration: none; }
  .depth-section li > a > span { color: var(--c-accent); font-family: var(--font-mono); font-size: .63rem; }
  .depth-section li > a > span:last-child { align-self: center; color: var(--c-muted); }
  .depth-section small, .depth-section strong { display: block; }
  .depth-section small { margin-bottom: .08rem; color: var(--c-muted); font-family: var(--font-mono); font-size: .6rem; text-transform: uppercase; }
  .depth-section strong { font-size: .84rem; }
  .depth-section li > a:hover strong { color: var(--c-accent); text-decoration: underline; }
  .trust-section { display: grid; grid-template-columns: minmax(14rem, .75fr) minmax(0, 1.25fr); gap: 1.8rem; margin-top: 2.7rem; padding: 1.15rem 0; border-top: 2px solid var(--c-text); border-bottom: 1px solid var(--c-rule); }
  .trust-section p { margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: .78rem; line-height: 1.55; }

  @media (max-width: 720px) {
    .section-head { align-items: flex-start; flex-direction: column; gap: .35rem; }
    .section-head > p { max-width: 38rem; text-align: left; }
    .value-grid { grid-template-columns: 1fr; }
    .value-grid article, .value-grid article:not(:last-child) { margin-right: 0; padding-right: 0; border-right: 0; }
    .trust-section { grid-template-columns: 1fr; gap: .8rem; }
  }
  @media (max-width: 600px) {
    .landing-page { padding-top: 1.4rem; }
    .hero { min-height: 0; padding-left: 1rem; }
    .cover-title { margin-top: 2rem; }
    .hero h1 { font-size: 2.55rem; }
    .cover-actions { display: grid; grid-template-columns: 1fr; }
    .cover-actions a { width: 100%; }
    .hero-proof { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
    .cover-folio { text-align: left; }
    .route-list ol { grid-template-columns: 1fr; }
    .route-list li:nth-child(odd), .route-list li:nth-child(even) { padding-right: 0; padding-left: 0; border-right: 0; }
    .shelf > header { grid-template-columns: 1fr; gap: .1rem; }
    .shelf > ol > li { grid-template-columns: 1.6rem minmax(0, 1fr); gap: .55rem; }
    .book-actions { grid-column: 2; align-items: flex-start; }
    .book-actions a { text-align: left; }
  }
</style>
