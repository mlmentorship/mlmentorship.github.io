---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import readingTime from 'reading-time';
import { formatDate } from '../utils/date';

const all = await getCollection('posts', ({ data }) => !data.draft);
const counts = {
  essays: all.filter((p) => p.data.category === 'essays').length,
  interviews: all.filter((p) => p.data.category === 'interviews').length,
  reference: all.filter((p) => p.data.category === 'reference').length,
};

// Latest essays — top 3 by date.
const latestEssays = all
  .filter((p) => p.data.category === 'essays')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((p) => ({
    slug: p.slug.replace(/^\d{4}-\d{2}-\d{2}-/, ''),
    title: p.data.title,
    description: p.data.description,
    date: p.data.date,
    minutes: Math.max(1, Math.round(readingTime(p.body).minutes)),
  }));
---
<BaseLayout title={SITE.title} description={SITE.description}>
  <main class="home">
    <!-- HERO -->
    <section class="block hero">
      <h1 class="display">
        Senior ML &amp; AI<br/>interviews, distilled.
      </h1>
      <p class="lede">
        Most ML interview prep is calibrated for new grads. This isn't.
      </p>
      <p class="sub-lede">
        {counts.interviews + counts.essays + counts.reference} questions,
        essays, and reference notes for engineers preparing for L5+ Applied
        Scientist, MLE, and Research Engineer loops. Free, by a senior
        practitioner.
      </p>
      <p class="hero-ctas">
        <a class="btn-primary" href="/start-here/">Start here <span aria-hidden="true">→</span></a>
        <a class="btn-secondary" href="/interviews/fine-tune-vs-prompt-vs-rag/">See a sample question</a>
      </p>
    </section>

    <hr class="rule" />

    <!-- WHY -->
    <section class="block why">
      <p class="block-eyebrow">What makes this different</p>
      <div class="why-grid">
        <article class="why-card">
          <p class="why-num" aria-hidden="true">01</p>
          <h3 class="why-title">Leveled answers, every question.</h3>
          <p class="why-body">
            Every interview question shows what a passing answer sounds like
            at L4, L5, and L6 separately, so you can calibrate to the bar
            you're targeting.
          </p>
        </article>
        <article class="why-card">
          <p class="why-num" aria-hidden="true">02</p>
          <h3 class="why-title">Senior canon, not bootcamp content.</h3>
          <p class="why-body">
            Built around questions actually asked at senior bars: distributed
            training, LLM evals, agent design, RAG, inference cost. Not
            "explain bias and variance" intro material.
          </p>
        </article>
        <article class="why-card">
          <p class="why-num" aria-hidden="true">03</p>
          <h3 class="why-title">Reference and opinion, side by side.</h3>
          <p class="why-body">
            99 lookup-style references for breadth (attention, KV-cache,
            FlashAttention, the math underneath) sit next to essays that
            take an opinion on contested topics.
          </p>
        </article>
      </div>
    </section>

    <hr class="rule" />

    <!-- LATEST -->
    <section class="block">
      <p class="block-eyebrow">Latest</p>
      <ol class="post-list">
        {latestEssays.map((p, i) => (
          <li>
            <a class="post-row" href={`/essays/${p.slug}/`}>
              <span class="post-row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="post-row-title">{p.title}</h3>
                {p.description && <p class="post-row-desc">{p.description}</p>}
                <p class="post-row-meta">{p.minutes} min read · {formatDate(p.date)}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
      <p class="block-foot">
        <a href="/essays/">All essays <span aria-hidden="true">→</span></a>
      </p>
    </section>

    <!-- QUIET FOOTNOTE -->
    <p class="footnote">
      <a href="/interviews/">{counts.interviews} interview questions</a>
      <span class="footnote-sep" aria-hidden="true">·</span>
      <a href="/essays/">{counts.essays} essays</a>
      <span class="footnote-sep" aria-hidden="true">·</span>
      <a href="/reference/">{counts.reference} reference posts</a>
      <span class="footnote-sep" aria-hidden="true">·</span>
      <span>press <kbd>/</kbd> to search</span>
    </p>
  </main>
</BaseLayout>

<style>
  .home {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) var(--gutter) clamp(3rem, 8vw, 6rem);
  }

  .block {
    padding: clamp(1.8rem, 4vw, 2.6rem) 0;
  }
  .hero {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .rule {
    border: 0;
    border-top: 1px solid var(--c-rule);
    margin: 0;
  }

  .display {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 8vw, 5.2rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--c-text);
    margin: 0 0 1.4rem;
  }

  .lede {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    line-height: 1.4;
    color: var(--c-text-soft);
    margin: 0 0 1.8rem;
    max-width: 36rem;
    letter-spacing: -0.005em;
  }

  /* Small accent stripe above the hero title — quiet design signature */
  .hero {
    position: relative;
  }
  .hero::before {
    content: '';
    display: block;
    width: 2.4rem;
    height: 3px;
    background: var(--c-accent);
    margin-bottom: 1.6rem;
    border-radius: 1.5px;
  }

  .sub-lede {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--c-muted);
    margin: 0 0 1.8rem;
    max-width: 38rem;
  }

  .hero-ctas {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin: 2rem 0 0;
  }
  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background var(--transition), border-color var(--transition), transform var(--transition);
  }
  .btn-primary {
    background: var(--c-accent);
    color: white;
  }
  .btn-primary:hover {
    background: var(--c-link-hover);
    transform: translateY(-1px);
  }
  .btn-secondary {
    background: var(--c-bg-tint);
    color: var(--c-text);
    border: 1px solid var(--c-rule);
    font-weight: 600;
  }
  .btn-secondary:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    background: var(--c-surface);
    transform: translateY(-1px);
  }

  /* WHY block: 3-column card grid */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .why-grid { grid-template-columns: 1fr; }
  }
  .why-card {
    padding: 1.4rem 1.4rem 1.5rem;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), transform var(--transition);
  }
  .why-card:hover {
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }
  .why-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--c-accent);
    margin: 0 0 0.7rem;
    letter-spacing: 0.06em;
  }
  .why-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 0.55rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .why-body {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--c-text-soft);
    margin: 0;
  }

  .block-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-muted);
    margin: 0 0 1.4rem;
  }
  .block-headline {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 1.6rem;
    letter-spacing: -0.018em;
    line-height: 1.2;
  }
  .block-foot {
    margin: 1.6rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }
  .block-foot a {
    color: var(--c-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .block-foot a:hover { text-decoration: underline; }

  /* Quiet footnote at the very bottom of the home page */
  .footnote {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--c-rule);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--c-muted);
    text-align: center;
  }
  .footnote a {
    color: var(--c-text-soft);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footnote a:hover { color: var(--c-accent); }
  .footnote-sep {
    margin: 0 0.6rem;
    color: var(--c-rule);
  }
  .footnote kbd {
    font-family: var(--font-mono);
    background: var(--c-kbd-bg);
    border: 1px solid var(--c-rule);
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
    margin: 0 0.15rem;
  }

  /* Latest essays as a vertical list */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .post-row {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.6rem;
    padding: 1rem 0.6rem 1rem 0.4rem;
    margin: 0 -0.6rem 0 -0.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background var(--transition);
  }
  .post-row:hover { background: var(--c-bg-tint); }
  .post-row-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--c-muted);
    line-height: 1.55;
    padding-top: 0.25rem;
    letter-spacing: 0.04em;
    transition: color var(--transition);
  }
  .post-row:hover .post-row-num {
    color: var(--c-accent);
  }
  .post-row-title {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 0.35rem;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .post-row-desc {
    font-size: 0.95rem;
    color: var(--c-text-soft);
    margin: 0 0 0.55rem;
    line-height: 1.55;
  }
  .post-row-meta {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--c-muted);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Reading paths as bullet list */
  .path-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .path-list a {
    display: grid;
    grid-template-columns: 0.8rem 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.6rem 0.75rem 0.4rem;
    margin: 0 -0.6rem 0 -0.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-text);
    font-size: 1.02rem;
    transition: background var(--transition);
  }
  .path-list a:hover { background: var(--c-bg-tint); }
  .path-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
    display: inline-block;
  }
  .path-arrow {
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 1rem;
    transition: color var(--transition), transform var(--transition);
  }
  .path-list a:hover .path-arrow {
    color: var(--c-accent);
    transform: translateX(3px);
  }

  /* Counts as a single quiet line */
  .counts-line {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--c-text-soft);
    margin: 0 0 0.7rem;
    line-height: 1.7;
  }
  .counts-line a {
    color: var(--c-text-soft);
    text-decoration: none;
    transition: color var(--transition);
  }
  .counts-line a:hover { color: var(--c-accent); }
  .counts-line strong {
    color: var(--c-text);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .counts-sep {
    margin: 0 0.6rem;
    color: var(--c-rule);
  }
  .counts-foot {
    font-size: 0.92rem;
    color: var(--c-muted);
    margin: 0;
  }
  .counts-foot kbd {
    font-family: var(--font-mono);
    background: var(--c-kbd-bg);
    border: 1px solid var(--c-rule);
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
  }

  /* Quiet consulting close */
  .consulting-headline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.5rem);
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 0.8rem;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }
  .consulting-body {
    font-size: 1rem;
    color: var(--c-text-soft);
    line-height: 1.6;
    margin: 0 0 1.2rem;
    max-width: 40rem;
  }
  .consulting-cta {
    margin: 0;
    font-family: var(--font-ui);
  }
  .consulting-cta a {
    color: var(--c-accent);
    font-weight: 600;
    text-decoration: none;
    font-size: 1rem;
  }
  .consulting-cta a:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .post-row { grid-template-columns: 2rem 1fr; }
  }
</style>
