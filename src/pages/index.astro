---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const all = await getCollection('posts', ({ data }) => !data.draft);
const counts = {
  essays: all.filter((p) => p.data.category === 'guides').length,
  interviews: all.filter((p) => p.data.category === 'questions').length,
  reference: all.filter((p) => p.data.category === 'concepts').length,
};
---
<BaseLayout title={SITE.title} description={SITE.description}>
  <main class="home">
    <!-- HERO -->
    <section class="block hero">
      <h1 class="display">
        Senior ML &amp; AI<br/>interviews, distilled.
      </h1>
      <p class="lede">
        Most ML interview prep is calibrated for new grads. This isn't.
      </p>
      <p class="sub-lede">
        {counts.interviews + counts.essays + counts.reference} questions,
        guides, and concept notes for engineers preparing for L5+ Applied
        Scientist, MLE, and Research Engineer loops. Free, by a senior
        practitioner.
      </p>
      <p class="hero-ctas">
        <a class="btn-primary" href="/start-here/">Browse the library <span aria-hidden="true">→</span></a>
      </p>
    </section>

    <hr class="rule" />

    <!-- THREE SECTIONS -->
    <section class="block">
      <p class="block-eyebrow">Where to look</p>
      <ul class="sections-grid">
        <li>
          <a href="/questions/">
            <h3>Questions <span class="sections-count">{counts.interviews}</span></h3>
            <p>The senior ML interview canon. Each one with what L4 / L5 / L6 answers actually sound like.</p>
            <p class="sections-when"><strong>Best when:</strong> you have a specific question and want a level-calibrated answer.</p>
          </a>
        </li>
        <li>
          <a href="/guides/">
            <h3>Guides <span class="sections-count">{counts.essays}</span></h3>
            <p>Long-form opinion pieces on senior ML interviews, system design, and applied practice. Take a position and defend it.</p>
            <p class="sections-when"><strong>Best when:</strong> you want a senior-IC point of view on something contested.</p>
          </a>
        </li>
        <li>
          <a href="/concepts/">
            <h3>Concepts <span class="sections-count">{counts.reference}</span></h3>
            <p>Concise notes on attention, normalization, LLM internals, optimization, and the math underneath.</p>
            <p class="sections-when"><strong>Best when:</strong> you need to look up or refresh a specific concept fast.</p>
          </a>
        </li>
      </ul>
      <p class="block-foot">
        Or follow a <a href="/start-here/">curated reading path</a> by what you're trying to do.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) var(--gutter) clamp(3rem, 8vw, 6rem);
  }

  .block {
    padding: clamp(1.8rem, 4vw, 2.6rem) 0;
  }
  .hero {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .rule {
    border: 0;
    border-top: 1px solid var(--c-rule);
    margin: 0;
  }

  .display {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 8vw, 5.2rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--c-text);
    margin: 0 0 1.4rem;
  }

  .lede {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    line-height: 1.4;
    color: var(--c-text-soft);
    margin: 0 0 1.8rem;
    max-width: 36rem;
    letter-spacing: -0.005em;
  }

  /* Small accent stripe above the hero title — quiet design signature */
  .hero {
    position: relative;
  }
  .hero::before {
    content: '';
    display: block;
    width: 2.4rem;
    height: 3px;
    background: var(--c-accent);
    margin-bottom: 1.6rem;
    border-radius: 1.5px;
  }

  .sub-lede {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--c-muted);
    margin: 0 0 1.8rem;
    max-width: 38rem;
  }

  .hero-ctas {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin: 2rem 0 0;
  }
  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background var(--transition), border-color var(--transition), transform var(--transition);
  }
  .btn-primary {
    background: var(--c-accent);
    color: white;
  }
  .btn-primary:hover {
    background: var(--c-link-hover);
    transform: translateY(-1px);
  }
  .btn-secondary {
    background: var(--c-bg-tint);
    color: var(--c-text);
    border: 1px solid var(--c-rule);
    font-weight: 600;
  }
  .btn-secondary:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    background: var(--c-surface);
    transform: translateY(-1px);
  }

  .hero-foot {
    margin: 1.2rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--c-muted);
  }
  .hero-foot a {
    color: var(--c-text-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: var(--c-rule);
    transition: color var(--transition), text-decoration-color var(--transition);
  }
  .hero-foot a:hover {
    color: var(--c-accent);
    text-decoration-color: var(--c-accent);
  }

  /* WHY block: 3-column card grid */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .why-grid { grid-template-columns: 1fr; }
  }
  .why-card {
    padding: 1.4rem 1.4rem 1.5rem;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), transform var(--transition);
  }
  .why-card:hover {
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }
  .why-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--c-accent);
    margin: 0 0 0.7rem;
    letter-spacing: 0.06em;
  }
  .why-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 0.55rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .why-body {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--c-text-soft);
    margin: 0;
  }

  /* WHERE TO LOOK: three section cards */
  .sections-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 720px) {
    .sections-grid { grid-template-columns: 1fr; }
  }
  .sections-grid > li { margin: 0; padding: 0; }
  .sections-grid a {
    display: block;
    padding: 1.3rem 1.4rem 1.4rem;
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition), transform var(--transition);
  }
  .sections-grid a:hover {
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }
  .sections-grid h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .sections-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-accent);
    font-weight: 500;
  }
  .sections-grid > li > a > p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--c-text-soft);
    margin: 0 0 0.6rem;
  }
  .sections-when {
    font-size: 0.85rem !important;
    color: var(--c-muted) !important;
    margin: 0.8rem 0 0 !important;
  }
  .sections-when strong {
    color: var(--c-text-soft);
    font-weight: 600;
  }

  .block-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-muted);
    margin: 0 0 1.4rem;
  }
  .block-headline {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 1.6rem;
    letter-spacing: -0.018em;
    line-height: 1.2;
  }
  .block-foot {
    margin: 1.6rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }
  .block-foot a {
    color: var(--c-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .block-foot a:hover { text-decoration: underline; }

  /* Quiet footnote at the very bottom of the home page */
  .footnote {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--c-rule);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--c-muted);
    text-align: center;
  }
  .footnote a {
    color: var(--c-text-soft);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footnote a:hover { color: var(--c-accent); }
  .footnote-sep {
    margin: 0 0.6rem;
    color: var(--c-rule);
  }
  .footnote kbd {
    font-family: var(--font-mono);
    background: var(--c-kbd-bg);
    border: 1px solid var(--c-rule);
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
    margin: 0 0.15rem;
  }

  /* Latest essays as a vertical list */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .post-row {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.6rem;
    padding: 1rem 0.6rem 1rem 0.4rem;
    margin: 0 -0.6rem 0 -0.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background var(--transition);
  }
  .post-row:hover { background: var(--c-bg-tint); }
  .post-row-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--c-muted);
    line-height: 1.55;
    padding-top: 0.25rem;
    letter-spacing: 0.04em;
    transition: color var(--transition);
  }
  .post-row:hover .post-row-num {
    color: var(--c-accent);
  }
  .post-row-title {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 0.35rem;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .post-row-desc {
    font-size: 0.95rem;
    color: var(--c-text-soft);
    margin: 0 0 0.55rem;
    line-height: 1.55;
  }
  .post-row-meta {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--c-muted);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Reading paths as bullet list */
  .path-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .path-list a {
    display: grid;
    grid-template-columns: 0.8rem 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 0.6rem 0.75rem 0.4rem;
    margin: 0 -0.6rem 0 -0.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-text);
    font-size: 1.02rem;
    transition: background var(--transition);
  }
  .path-list a:hover { background: var(--c-bg-tint); }
  .path-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
    display: inline-block;
  }
  .path-arrow {
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 1rem;
    transition: color var(--transition), transform var(--transition);
  }
  .path-list a:hover .path-arrow {
    color: var(--c-accent);
    transform: translateX(3px);
  }

  /* Counts as a single quiet line */
  .counts-line {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--c-text-soft);
    margin: 0 0 0.7rem;
    line-height: 1.7;
  }
  .counts-line a {
    color: var(--c-text-soft);
    text-decoration: none;
    transition: color var(--transition);
  }
  .counts-line a:hover { color: var(--c-accent); }
  .counts-line strong {
    color: var(--c-text);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .counts-sep {
    margin: 0 0.6rem;
    color: var(--c-rule);
  }
  .counts-foot {
    font-size: 0.92rem;
    color: var(--c-muted);
    margin: 0;
  }
  .counts-foot kbd {
    font-family: var(--font-mono);
    background: var(--c-kbd-bg);
    border: 1px solid var(--c-rule);
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
  }

  /* Quiet consulting close */
  .consulting-headline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.5rem);
    font-weight: 600;
    color: var(--c-text);
    margin: 0 0 0.8rem;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }
  .consulting-body {
    font-size: 1rem;
    color: var(--c-text-soft);
    line-height: 1.6;
    margin: 0 0 1.2rem;
    max-width: 40rem;
  }
  .consulting-cta {
    margin: 0;
    font-family: var(--font-ui);
  }
  .consulting-cta a {
    color: var(--c-accent);
    font-weight: 600;
    text-decoration: none;
    font-size: 1rem;
  }
  .consulting-cta a:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .post-row { grid-template-columns: 2rem 1fr; }
  }
</style>
