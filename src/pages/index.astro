---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LIBRARY_SHELVES, LIBRARY_VOLUMES } from '../data/library';
import { entriesForChapter, getLibraryEntries } from '../utils/library';
import { SITE } from '../consts';

const entries = await getLibraryEntries();
const volumeStats = LIBRARY_VOLUMES.map((volume) => ({
  volume,
  entries: volume.chapters.flatMap((chapter) => entriesForChapter(entries, chapter)),
}));
const assignedHrefs = volumeStats.flatMap((item) => item.entries.map((entry) => entry.href));
if (assignedHrefs.length !== entries.length || new Set(assignedHrefs).size !== entries.length) {
  throw new Error(`Library taxonomy must assign each published entry exactly once. Assigned ${assignedHrefs.length} references across ${new Set(assignedHrefs).size} unique entries; expected ${entries.length}.`);
}
const volumeStatsById = new Map(volumeStats.map((item) => [item.volume.id, item]));
const shelfVolumeIds = LIBRARY_SHELVES.flatMap((shelf) => shelf.volumeIds);
if (shelfVolumeIds.length !== LIBRARY_VOLUMES.length || new Set(shelfVolumeIds).size !== LIBRARY_VOLUMES.length) {
  throw new Error('Library shelves must assign every volume exactly once.');
}
---

<BaseLayout title="Senior ML & AI interview prep" description={SITE.description}>
  <div class="library-page">
    <header class="library-head">
      <p class="edition">Free field guide for experienced candidates</p>
      <h1>Senior ML &amp; AI interview prep</h1>
      <p class="subtitle">
        Prepare for Applied Scientist, Research Scientist, Machine Learning Engineer, and Research Engineer interviews with concise concepts, realistic questions, and role-specific practice.
      </p>
      <div class="quick-links">
        <a href="/library/foundations/">Start with Book I</a>
        {SITE.features.prepTools && <a href="/prep/">Open your workbook</a>}
      </div>
    </header>

    <section class="volumes" aria-labelledby="curriculum-heading">
      <div class="section-label"><span>Curriculum</span><strong>{LIBRARY_VOLUMES.length} books · {entries.length} entries</strong></div>
      <h2 id="curriculum-heading" class="sr-only">Browse the curriculum by subject</h2>
      <p class="starting-note"><strong>Not sure where to begin?</strong> Start with the Core chapters in Books I and II. Add Role-specific or Specialist chapters only when your role path or interview loop requires them.</p>
      {LIBRARY_SHELVES.map((shelf) => (
        <section class="shelf" id={shelf.id}>
          <header><h2>{shelf.title}</h2><p>{shelf.description}</p></header>
          <ol>
            {shelf.volumeIds.map((volumeId) => volumeStatsById.get(volumeId)).filter((item) => item !== undefined).map(({ volume, entries: volumeEntries }) => (
              <li>
                <a href={`/library/${volume.id}/`}>
                  <span class="volume-number">{volume.number}</span>
                  <div><h3>{volume.title}</h3><p>{volume.description}</p></div>
                  <span class="volume-count">{volumeEntries.length}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>

    <aside class="find-note">
      <strong>Looking for one term?</strong>
      Use Search in the header. Prefer a type-only view? Open <a href="/concepts/">all concepts</a> or <a href="/guides/">all guides</a>. {SITE.features.prepTools
        ? <>Looking for an interview plan? Open the <a href="/prep/">Workbook</a>.</>
        : <>Looking for an ordered route? Use the <a href="/start-here/">reading paths</a>.</>}
    </aside>
  </div>
</BaseLayout>

<style>
  .library-page { width: min(100%, 48rem); margin: 0 auto; padding: clamp(1.7rem, 4vw, 2.8rem) var(--gutter) 4rem; }
  .library-head { max-width: 40rem; padding-bottom: 1.4rem; border-bottom: 1px solid var(--c-rule); }
  .edition { margin: 0 0 .45rem; color: var(--c-muted); font-size: .72rem; font-weight: 500; }
  .library-head h1 { max-width: 42rem; margin: 0 0 .55rem; font-size: clamp(2rem, 5vw, 2.8rem); letter-spacing: -.035em; line-height: 1.08; }
  .subtitle { max-width: 39rem; margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: 1rem; line-height: 1.55; }
  .quick-links { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin-top: .85rem; }
  .quick-links a { color: var(--c-text-soft); font-size: .78rem; font-weight: 550; text-decoration: none; }
  .quick-links a:hover { color: var(--c-text); text-decoration: underline; }

  .volumes { padding-top: 1.5rem; }
  .section-label { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .35rem; font-size: .7rem; }
  .section-label span { color: var(--c-text-soft); font-weight: 600; }
  .section-label strong { color: var(--c-muted); font-weight: 500; }
  .starting-note { max-width: 40rem; margin: .65rem 0 0; color: var(--c-muted); font-size: .78rem; line-height: 1.45; }
  .shelf { margin-top: 1.6rem; }
  .shelf > header { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: .8rem; align-items: baseline; margin-bottom: .35rem; }
  .shelf > header h2 { margin: 0; font-size: .9rem; }
  .shelf > header p { margin: 0; color: var(--c-muted); font-family: var(--font-reading); font-size: .78rem; line-height: 1.4; }
  .volumes ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--c-rule); }
  .volumes li { margin: 0; border-bottom: 1px solid var(--c-rule); }
  .volumes a { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; gap: .7rem; padding: .8rem 0; color: inherit; text-decoration: none; }
  .volume-number, .volume-count { padding-top: .12rem; color: var(--c-muted); font-family: var(--font-ui); font-size: .66rem; }
  .volumes h3 { margin: 0 0 .12rem; font-size: .92rem; }
  .volumes p { margin: 0; color: var(--c-muted); font-family: var(--font-reading); font-size: .8rem; line-height: 1.4; }
  .volumes a:hover h3 { color: var(--c-accent); text-decoration: underline; }
  .volume-count { padding-left: .5rem; }

  .find-note { margin-top: 2rem; padding: .7rem 0; border-top: 1px solid var(--c-rule); color: var(--c-muted); font-size: .76rem; }
  .find-note strong { color: var(--c-text-soft); }

  @media (max-width: 600px) {
    .shelf > header { grid-template-columns: 1fr; gap: .15rem; }
    .volumes a { grid-template-columns: 1.8rem minmax(0, 1fr); gap: .65rem; }
    .volume-count { display: none; }
  }
</style>