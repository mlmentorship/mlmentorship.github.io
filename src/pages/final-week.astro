---
import PrepLayout from '../layouts/PrepLayout.astro';

const groups = [
  {
    title: '7–5 days before · Simulate early',
    items: [
      'Run one realistic full-loop or multi-round simulation.',
      'Write the three highest-impact failures exposed by evidence.',
      'Freeze the topic list: add nothing unless the simulation revealed it.',
      'Schedule final retries for weak answers with at least one day between attempts.',
      'Confirm six behavioral stories cover ambiguity, failure, impact, conflict, trade-offs, and leadership.',
    ],
  },
  {
    title: '4–3 days before · Repair narrowly',
    items: [
      'Retry the weakest technical answer closed-book before reviewing notes.',
      'Practice one system answer with requirements, metrics, failures, and trade-offs.',
      'Rehearse story outlines and evidence—not memorized prose.',
      'Check that every expected round has at least one recent timed attempt.',
      'Prepare two thoughtful questions about the role, team, or technical environment.',
    ],
  },
  {
    title: '2 days before · Reduce volume',
    items: [
      'Run one short mixed session; stop while retrieval is still sharp.',
      'Review only concise outlines, formulas, and known failure points.',
      'Avoid a second full-loop simulation or an all-night question sprint.',
      'Confirm interview time, time zone, format, contacts, and required links.',
      'Test camera, microphone, screen sharing, editor, and backup connection if remote.',
    ],
  },
  {
    title: '1 day before · Protect performance',
    items: [
      'Do at most two light confidence-building answers.',
      'Set up a quiet space, water, charger, notebook, and permitted materials.',
      'Prepare a concise role narrative: why this work, why this level, why now.',
      'Stop preparation at a defined time and protect sleep.',
      'Treat nervousness as activation—not a signal to add more content.',
    ],
  },
  {
    title: 'Interview day · Execute the process',
    items: [
      'Join or arrive early enough to resolve logistics without rushing.',
      'Clarify the objective and constraints before solving.',
      'State an outline, make decisions explicit, and invite alignment.',
      'When stuck, expose assumptions and reason forward instead of going silent.',
      'After each round, write only essential notes and reset for the next one.',
    ],
  },
];
---

<PrepLayout
  title="Final-week ML interview checklist"
  description="A practical final-week checklist for consolidating senior ML interview preparation without cramming."
  heading="Consolidate. Simulate. Then taper."
  lede="The final week should improve retrieval and execution—not maximize new coverage. Use this checklist to close high-impact gaps and protect performance."
>
  <div class="checklist-controls">
    <p><strong data-complete-count>0</strong> of <span data-total-count>{groups.reduce((total, group) => total + group.items.length, 0)}</span> complete</p>
    <div><button class="print-button" type="button" data-print>Print checklist</button><button class="print-button" type="button" data-reset>Reset</button></div>
  </div>
  <div class="progress-track" aria-hidden="true"><span data-progress></span></div>

  <form class="final-checklist">
    {groups.map((group) => (
      <fieldset>
        <legend>{group.title}</legend>
        {group.items.map((item) => (
          <label><input type="checkbox" /><span>{item}</span></label>
        ))}
      </fieldset>
    ))}
  </form>

  <section class="callout">
    <h2>Three things not to do</h2>
    <ul>
      <li>Do not replace sleep with low-quality coverage.</li>
      <li>Do not memorize full scripts that break under follow-up questions.</li>
      <li>Do not reinterpret one weak practice attempt as evidence that everything is weak.</li>
    </ul>
  </section>

  <h2>If time collapses</h2>
  <p>Keep only four actions: one mixed simulation, repair its two largest failures, rehearse the six-story bank, and verify logistics. Remove new topics first.</p>

  <p><a href="/practice/">Review the closed-book practice method →</a></p>
</PrepLayout>

<script>
  const checklist = document.querySelector<HTMLFormElement>('.final-checklist');
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.final-checklist input[type="checkbox"]'));
  const complete = document.querySelector<HTMLElement>('[data-complete-count]');
  const progress = document.querySelector<HTMLElement>('[data-progress]');

  const update = () => {
    const checked = boxes.filter((box) => box.checked).length;
    if (complete) complete.textContent = String(checked);
    if (progress) progress.style.width = `${boxes.length ? checked / boxes.length * 100 : 0}%`;
  };

  checklist?.addEventListener('change', update);
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    checklist?.reset();
    update();
  });
  update();
</script>

<style>
  .checklist-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .checklist-controls p { margin: 0; color: var(--c-text-soft); }
  .checklist-controls > div { display: flex; gap: .5rem; }
  .progress-track { height: .35rem; margin: .8rem 0 1.5rem; overflow: hidden; border-radius: 999px; background: var(--c-rule); }
  .progress-track span { display: block; width: 0; height: 100%; background: var(--c-accent-fill); transition: width 180ms ease; }
  .final-checklist { display: grid; gap: 1rem; }
  fieldset { margin: 0; padding: 1rem; border: 1px solid var(--c-rule); border-radius: var(--radius-lg); break-inside: avoid; }
  legend { padding: 0 .45rem; font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; }
  fieldset label { display: flex; align-items: flex-start; gap: .65rem; padding: .55rem 0; border-bottom: 1px solid var(--c-rule-soft); }
  fieldset label:last-child { border-bottom: 0; }
  fieldset input { flex: 0 0 auto; margin-top: .35rem; accent-color: var(--c-accent-fill); }
  fieldset span { line-height: 1.5; color: var(--c-text-soft); }
  @media (max-width: 620px) {
    .checklist-controls { align-items: stretch; flex-direction: column; }
    .checklist-controls > div, .checklist-controls button { width: 100%; }
  }
  @media print {
    .checklist-controls, .progress-track { display: none; }
    fieldset { margin-bottom: .7rem; }
  }
</style>
