---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && data.category === 'interviews');
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '') },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content, headings } = await post.render();
---
<DocsLayout post={post} headings={headings} rawContent={post.body}>
  <Content />
</DocsLayout>
