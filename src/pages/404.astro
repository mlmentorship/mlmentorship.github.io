---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---
<BaseLayout title="Page not found" description="The requested mlmentorship page could not be found.">
  <section class="notfound">
    <p class="code">404</p>
    <h1>This page is not in the book.</h1>
    <p>The link may be old, or the address may contain a typo. Use search in the header or continue from one of the main sections.</p>
    <nav aria-label="Continue browsing">
      <a href="/#curriculum">Library</a>
      <a href="/questions/">Questions</a>
      <a href="/concepts/">Concepts</a>
      <a href="/guides/">Guides</a>
      {SITE.features.prepTools && <a href="/prep/">Workbook</a>}
    </nav>
  </section>
</BaseLayout>

<style>
  .notfound {
    width: min(100%, 42rem);
    margin: 0 auto;
    padding: clamp(4rem, 12vw, 8rem) var(--gutter);
  }
  .code {
    margin: 0 0 .6rem;
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
  }
  .notfound h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 6vw, 3.4rem);
  }
  .notfound > p:not(.code) { max-width: 36rem; color: var(--c-text-soft); font-family: var(--font-reading); font-size: 1.08rem; line-height: 1.65; }
  .notfound nav { display: flex; flex-wrap: wrap; gap: .65rem 1.2rem; margin-top: 1.8rem; }
  .notfound nav a { color: var(--c-text); font-size: .9rem; font-weight: 650; text-decoration: none; }
  .notfound nav a:hover { color: var(--c-accent); text-decoration: underline; }
</style>
