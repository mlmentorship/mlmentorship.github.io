---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisualReviewCard from '../components/VisualReviewCard.astro';
import { LIBRARY_VOLUMES } from '../data/library';
import { entriesForChapter, getLibraryEntries } from '../utils/library';
import { getImplementedVisualAudit } from '../utils/visualAudits';

const allEntries = await getLibraryEntries();
const reviewEntries = LIBRARY_VOLUMES.flatMap((volume) => volume.chapters.flatMap((chapter, chapterIndex) =>
  entriesForChapter(allEntries, chapter).flatMap((entry) => {
    const audit = getImplementedVisualAudit(entry.slug);
    if (!audit) return [];
    return [{
      slug: entry.slug,
      title: entry.title,
      href: entry.href,
      category: entry.category,
      objective: audit.learningObjective || entry.description || entry.title,
      medium: audit.medium,
      visualId: audit.visualIds[0],
      volumeId: volume.id,
      volumeNumber: volume.number,
      volumeTitle: volume.title,
      volumeShortTitle: volume.shortTitle,
      chapterId: chapter.id,
      chapterIndex: chapterIndex + 1,
      chapterTitle: chapter.title,
    }];
  }),
));
if (reviewEntries.length === 0) throw new Error('Library-wide visual review needs at least one implemented visual.');
const firstEntry = reviewEntries[0];
const reviewData = JSON.stringify(reviewEntries).replace(/</g, '\\u003c');
const categoryLabel = { concepts: 'Concept', questions: 'Question', guides: 'Guide' } as const;
const reviewContents = LIBRARY_VOLUMES.map((volume) => ({
  volume,
  chapters: volume.chapters.map((chapter) => ({
    chapter,
    entries: entriesForChapter(allEntries, chapter)
      .filter((entry) => getImplementedVisualAudit(entry.slug))
      .map((entry) => ({ slug: entry.slug, title: entry.title })),
  })).filter((item) => item.entries.length > 0),
})).filter((item) => item.chapters.length > 0);
---

<BaseLayout
  title="Visual review"
  description="Review the complete ML interview library one visual mental model at a time."
  noindex
  immersive
  pagefindIgnore
>
  <div class="visual-review-mode" data-visual-review-mode data-pagefind-ignore="all">
    <nav class="review-toolbar" aria-label="Visual review context">
      <a href={`/#curriculum`} data-review-back><span aria-hidden="true">←</span> Library</a>
      <p><span data-review-book>Book {firstEntry.volumeNumber} · Chapter {firstEntry.chapterIndex}</span><strong data-review-chapter>{firstEntry.chapterTitle}</strong></p>
      <div class="review-progress-wrap">
        <span data-review-counter>1 / {reviewEntries.length}</span>
        <small>Entire library</small>
      </div>
    </nav>

    <aside class="review-contents" data-review-contents aria-label="Visual review contents">
      <details class="review-contents-details" data-review-contents-details>
        <summary>
          <span>Contents</span>
          <small data-review-contents-location>{firstEntry.volumeShortTitle} · {firstEntry.chapterTitle}</small>
        </summary>
        <div class="review-contents-panel">
          {reviewContents.map(({ volume, chapters }) => (
            <details class="review-contents-volume" data-review-contents-volume={volume.id} open={volume.id === firstEntry.volumeId}>
              <summary><span>{volume.number} · {volume.shortTitle}</span><small>{chapters.length} chapters</small></summary>
              <ol>
                {chapters.map(({ chapter, entries }) => (
                  <li>
                    <details class="review-contents-chapter" data-review-contents-chapter={chapter.id} open={chapter.id === firstEntry.chapterId}>
                      <summary><span>{chapter.title}</span><small>{entries.length}</small></summary>
                      <ol>
                        {entries.map((entry) => (
                          <li><a href={`#${entry.slug}`} data-review-content-entry={entry.slug}>{entry.title}</a></li>
                        ))}
                      </ol>
                    </details>
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </details>
    </aside>

    <div class="review-workspace" data-review-workspace>
      <section class="review-stage" data-review-stage hidden aria-hidden="true" aria-busy="true">
        <VisualReviewCard
          eyebrow={`${categoryLabel[firstEntry.category]} · Visual review`}
          title={firstEntry.title}
          summary={firstEntry.objective}
          headingLevel={1}
          variant="deck"
        >
          <span slot="status" data-review-position>Visual 1 of {reviewEntries.length}</span>
          <p slot="visual" class="review-loading" data-review-loading>Loading the visual…</p>
        </VisualReviewCard>
      </section>

      <aside id="review-explanation" class="review-explanation" data-review-explanation hidden aria-hidden="true" inert aria-label="Full explanation">
        <header>
          <div><span>Full explanation</span><strong tabindex="-1" data-review-explanation-title>{firstEntry.title}</strong></div>
          <div class="explanation-actions">
            <a href={firstEntry.href} data-review-open-article>Open article <span aria-hidden="true">↗</span></a>
            <button type="button" data-review-explanation-close aria-label="Close full explanation">Close</button>
          </div>
        </header>
        <div class="prose review-explanation-body" data-review-explanation-host></div>
      </aside>
    </div>

    <section class="review-fallback" data-review-fallback>
      <p class="fallback-kicker">Visual review</p>
      <h1>Review the complete library visually.</h1>
      <p>JavaScript adds one-visual navigation and the explanation panel. Every lesson remains available through the library.</p>
      <a href="/#curriculum">Browse all books</a>
    </section>

    <nav class="review-bottom" aria-label="Visual review navigation" data-review-controls hidden>
      <button type="button" data-review-previous aria-label="Previous visual" aria-keyshortcuts="ArrowLeft"><span aria-hidden="true">←</span><span>Previous</span></button>
      <button class="explanation-toggle" type="button" data-review-explanation-toggle aria-expanded="false" aria-controls="review-explanation"><span data-review-mode-label>Full explanation</span></button>
      <button type="button" data-review-next aria-label="Next visual" aria-keyshortcuts="ArrowRight"><span>Next</span><span aria-hidden="true">→</span></button>
    </nav>

    <p class="sr-only" aria-live="polite" data-review-announcer></p>
    <script id="visual-review-data" type="application/json" is:inline set:html={reviewData}></script>
  </div>
</BaseLayout>

<script>
  import { absolutizeVisualLinks, extractLearningVisual } from '../utils/visualReviewClient';
  import { enhanceCodingVisuals } from '../utils/codingVisuals';

  interface ReviewEntry {
    slug: string;
    title: string;
    href: string;
    category: 'concepts' | 'questions' | 'guides';
    objective: string;
    medium: string;
    visualId: string;
    volumeId: string;
    volumeNumber: string;
    volumeTitle: string;
    volumeShortTitle: string;
    chapterId: string;
    chapterIndex: number;
    chapterTitle: string;
  }

  const root = document.querySelector<HTMLElement>('[data-visual-review-mode]');
  const dataNode = document.querySelector<HTMLScriptElement>('#visual-review-data');
  let entries: ReviewEntry[] = [];
  try {
    const parsed = JSON.parse(dataNode?.textContent ?? '[]');
    if (Array.isArray(parsed)) entries = parsed as ReviewEntry[];
  } catch (error) {
    console.error('Visual review data could not be read.', error);
  }

  if (root && entries.length > 0) {
    const lifecycle = new AbortController();
    const listenerOptions = { signal: lifecycle.signal };
    const workspace = root.querySelector<HTMLElement>('[data-review-workspace]');
    const stage = root.querySelector<HTMLElement>('[data-review-stage]');
    const fallback = root.querySelector<HTMLElement>('[data-review-fallback]');
    const controls = root.querySelector<HTMLElement>('[data-review-controls]');
    const card = root.querySelector<HTMLElement>('[data-visual-review-card]');
    const title = root.querySelector<HTMLElement>('[data-review-title]');
    const eyebrow = root.querySelector<HTMLElement>('[data-review-eyebrow]');
    const summary = root.querySelector<HTMLElement>('[data-review-summary]');
    const visualHost = root.querySelector<HTMLElement>('[data-review-visual-host]');
    const sourceHost = root.querySelector<HTMLElement>('[data-review-source-host]');
    const sourceDetails = root.querySelector<HTMLDetailsElement>('[data-review-source-details]');
    const position = root.querySelector<HTMLElement>('[data-review-position]');
    const counter = root.querySelector<HTMLElement>('[data-review-counter]');
    const book = root.querySelector<HTMLElement>('[data-review-book]');
    const chapter = root.querySelector<HTMLElement>('[data-review-chapter]');
    const back = root.querySelector<HTMLAnchorElement>('[data-review-back]');
    const previous = root.querySelector<HTMLButtonElement>('[data-review-previous]');
    const next = root.querySelector<HTMLButtonElement>('[data-review-next]');
    const explanation = root.querySelector<HTMLElement>('[data-review-explanation]');
    const explanationTitle = root.querySelector<HTMLElement>('[data-review-explanation-title]');
    const explanationHost = root.querySelector<HTMLElement>('[data-review-explanation-host]');
    const explanationToggle = root.querySelector<HTMLButtonElement>('[data-review-explanation-toggle]');
    const explanationClose = root.querySelector<HTMLButtonElement>('[data-review-explanation-close]');
    const modeLabel = root.querySelector<HTMLElement>('[data-review-mode-label]');
    const openArticle = root.querySelector<HTMLAnchorElement>('[data-review-open-article]');
    const announcer = root.querySelector<HTMLElement>('[data-review-announcer]');
    const contentsLocation = root.querySelector<HTMLElement>('[data-review-contents-location]');
    const contentsEntries = [...root.querySelectorAll<HTMLAnchorElement>('[data-review-content-entry]')];
    const contentsVolumes = [...root.querySelectorAll<HTMLDetailsElement>('[data-review-contents-volume]')];
    const contentsChapters = [...root.querySelectorAll<HTMLDetailsElement>('[data-review-contents-chapter]')];
    const cache = new Map<string, Promise<Document>>();
    const labels = {
      concepts: 'Concept · Visual quick review',
      questions: 'Question · 30-second answer map',
      guides: 'Guide · Decision map',
    } as const;
    let currentIndex = 0;
    let requestToken = 0;
    let touchStartX: number | undefined;
    const desktopExplanation = window.matchMedia('(min-width: 901px)');
    let explanationOpen = false;
    let explanationTransitionTimer: number | undefined;

    function syncContents(entry: ReviewEntry) {
      if (!root) return;
      if (contentsLocation) contentsLocation.textContent = `${entry.volumeShortTitle} · ${entry.chapterTitle}`;
      contentsEntries.forEach((link) => {
        if (link.dataset.reviewContentEntry === entry.slug) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
      contentsVolumes.forEach((volume) => volume.removeAttribute('data-current'));
      contentsChapters.forEach((chapter) => chapter.removeAttribute('data-current'));
      const currentVolume = root.querySelector<HTMLDetailsElement>(`[data-review-contents-volume="${entry.volumeId}"]`);
      const currentChapter = root.querySelector<HTMLDetailsElement>(`[data-review-contents-chapter="${entry.chapterId}"]`);
      currentVolume?.setAttribute('data-current', 'true');
      currentChapter?.setAttribute('data-current', 'true');
      if (currentVolume) currentVolume.open = true;
      if (currentChapter) currentChapter.open = true;
    }

    function fetchArticle(entry: ReviewEntry): Promise<Document> {
      const cached = cache.get(entry.href);
      if (cached) return cached;
      const request = fetch(entry.href, { headers: { Accept: 'text/html' } })
        .then((response) => {
          if (!response.ok) throw new Error(`Article returned ${response.status}`);
          return response.text();
        })
        .then((html) => new DOMParser().parseFromString(html, 'text/html'))
        .catch((error) => {
          cache.delete(entry.href);
          throw error;
        });
      cache.set(entry.href, request);
      return request;
    }

    async function renderMermaid(container: HTMLElement, slug: string) {
      const nodes = [...container.querySelectorAll<HTMLElement>('pre.mermaid')];
      if (nodes.length === 0) return;
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({
        startOnLoad: false,
        theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default',
        fontFamily: 'ui-sans-serif, system-ui, sans-serif',
        flowchart: { curve: 'basis', nodeSpacing: 30, rankSpacing: 42, padding: 12, useMaxWidth: true },
      });
      for (const [index, node] of nodes.entries()) {
        const diagram = node.dataset.diagram ?? node.textContent ?? '';
        node.dataset.diagram = diagram;
        const { svg, bindFunctions } = await mermaid.render(`review-${slug}-${index}-${Date.now()}`, diagram);
        node.innerHTML = svg;
        node.dataset.processed = 'true';
        bindFunctions?.(node);
      }
    }

    function indexFromHash(): number {
      const slug = decodeURIComponent(window.location.hash.slice(1));
      const index = entries.findIndex((entry) => entry.slug === slug);
      return index >= 0 ? index : 0;
    }

    function renderExplanation(article: Document, entry: ReviewEntry) {
      if (!explanationHost || !explanationTitle || !openArticle) return;
      const articleBody = article.querySelector<HTMLElement>('#answer');
      explanationTitle.textContent = entry.title;
      openArticle.href = entry.href;
      if (!articleBody) {
        explanationHost.innerHTML = '<p>The full explanation is unavailable here. Open the article instead.</p>';
        return;
      }
      const body = document.importNode(articleBody, true);
      body.removeAttribute('id');
      body.querySelectorAll('.learning-figure, .diagram-source, pre.mermaid, .mermaid, script').forEach((element) => element.remove());
      absolutizeVisualLinks(body, entry.href);
      explanationHost.replaceChildren(...body.childNodes);
    }

    function setExplanation(open: boolean, focus = true) {
      explanationOpen = open;
      if (explanationTransitionTimer !== undefined) {
        window.clearTimeout(explanationTransitionTimer);
        explanationTransitionTimer = undefined;
      }
      if (open) {
        explanation?.removeAttribute('hidden');
        explanation?.removeAttribute('inert');
        explanation?.setAttribute('aria-hidden', 'false');
        if (desktopExplanation.matches) {
          stage?.style.removeProperty('max-height');
          explanation?.style.removeProperty('max-height');
        } else {
          stage?.style.setProperty('max-height', '0px');
          explanation?.style.setProperty('max-height', `${explanation?.scrollHeight ?? 0}px`);
        }
        window.requestAnimationFrame(() => {
          if (!explanationOpen) return;
          workspace?.classList.remove('is-explanation-closing');
          workspace?.classList.add('is-explanation-open');
          if (!desktopExplanation.matches && explanation) explanation.style.setProperty('max-height', `${explanation.scrollHeight}px`);
          window.requestAnimationFrame(() => {
            if (explanationOpen && !desktopExplanation.matches && explanation) explanation.style.setProperty('max-height', `${explanation.scrollHeight}px`);
          });
          if (focus) explanationClose?.focus({ preventScroll: true });
        });
      } else {
        workspace?.classList.remove('is-explanation-open');
        workspace?.classList.add('is-explanation-closing');
        explanation?.setAttribute('aria-hidden', 'true');
        explanation?.setAttribute('inert', '');
        if (desktopExplanation.matches) {
          stage?.style.removeProperty('max-height');
          explanation?.style.removeProperty('max-height');
        } else {
          stage?.style.setProperty('max-height', `${stage?.scrollHeight ?? 0}px`);
          explanation?.style.setProperty('max-height', '0px');
        }
        explanationTransitionTimer = window.setTimeout(() => {
          if (explanationOpen) return;
          if (explanation) explanation.hidden = true;
          workspace?.classList.remove('is-explanation-closing');
          explanationTransitionTimer = undefined;
        }, 360);
        if (focus) explanationToggle?.focus({ preventScroll: true });
      }
      if (desktopExplanation.matches || !open) {
        stage?.removeAttribute('inert');
        stage?.setAttribute('aria-hidden', 'false');
      } else {
        stage?.setAttribute('inert', '');
        stage?.setAttribute('aria-hidden', 'true');
      }
      explanationToggle?.setAttribute('aria-expanded', String(open));
      explanationToggle?.setAttribute('aria-pressed', String(open));
      if (modeLabel) modeLabel.textContent = open ? 'Visual only' : 'Full explanation';
      window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }

    async function showEntry(index: number, options: { push?: boolean; focus?: boolean } = {}) {
      if (!stage || !card || !title || !eyebrow || !summary || !visualHost || !position || !counter || !book || !chapter || !back || !previous || !next) return;
      const boundedIndex = Math.max(0, Math.min(entries.length - 1, index));
      const entry = entries[boundedIndex];
      const token = ++requestToken;
      currentIndex = boundedIndex;
      syncContents(entry);
      stage.setAttribute('aria-busy', 'true');
      visualHost.setAttribute('aria-busy', 'true');
      visualHost.innerHTML = '<p class="review-loading">Loading the visual…</p>';
      title.textContent = entry.title;
      eyebrow.textContent = labels[entry.category];
      summary.textContent = entry.objective;
      position.textContent = `Visual ${boundedIndex + 1} of ${entries.length}`;
      counter.textContent = `${boundedIndex + 1} / ${entries.length}`;
      book.textContent = `Book ${entry.volumeNumber} · Chapter ${entry.chapterIndex}`;
      chapter.textContent = entry.chapterTitle;
      back.href = `/library/${entry.volumeId}/${entry.chapterId}/`;
      back.innerHTML = '<span aria-hidden="true">←</span> Chapter';
      document.querySelectorAll<HTMLAnchorElement>('[data-reading-mode="full"]').forEach((link) => { link.href = entry.href; });
      previous.disabled = boundedIndex === 0;
      next.disabled = boundedIndex === entries.length - 1;
      if (sourceHost) sourceHost.replaceChildren();
      if (sourceDetails) { sourceDetails.hidden = true; sourceDetails.open = false; }

      try {
        const article = await fetchArticle(entry);
        if (token !== requestToken) return;
        const extracted = extractLearningVisual(article, entry.visualId);
        if (!extracted) throw new Error('No completed learning visual was found');
        const figure = document.importNode(extracted.figure, true);
        absolutizeVisualLinks(figure, entry.href);
        visualHost.replaceChildren(figure);
        enhanceCodingVisuals(visualHost);
        if (extracted.source && sourceHost && sourceDetails) {
          const note = document.importNode(extracted.source, true);
          absolutizeVisualLinks(note, entry.href);
          sourceHost.append(note);
          sourceDetails.hidden = false;
        }
        await renderMermaid(visualHost, entry.slug);
        if (token !== requestToken) return;
        stage.hidden = false;
        stage.setAttribute('aria-hidden', 'false');
        renderExplanation(article, entry);
        setExplanation(explanationOpen, false);
        controls?.removeAttribute('hidden');
        if (fallback) fallback.hidden = true;
        stage.setAttribute('aria-busy', 'false');
        visualHost.setAttribute('aria-busy', 'false');
        if (options.push) history.pushState({ slug: entry.slug }, '', `#${encodeURIComponent(entry.slug)}`);
        else if (!window.location.hash) history.replaceState({ slug: entry.slug }, '', `#${encodeURIComponent(entry.slug)}`);
        if (announcer) announcer.textContent = `${entry.title}, visual ${boundedIndex + 1} of ${entries.length}`;
        if (options.focus) {
          window.scrollTo({ top: 0, behavior: 'auto' });
          (explanationOpen ? explanationClose : title)?.focus({ preventScroll: true });
        }
        for (const adjacent of [entries[boundedIndex - 1], entries[boundedIndex + 1]]) {
          if (adjacent) void fetchArticle(adjacent).catch(() => undefined);
        }
      } catch (error) {
        if (token !== requestToken) return;
        const message = error instanceof Error ? error.message : 'Unknown error';
        const errorPanel = document.createElement('div');
        errorPanel.className = 'review-error';
        errorPanel.innerHTML = '<strong>This visual could not be loaded.</strong>';
        const errorDetail = document.createElement('span');
        errorDetail.textContent = message;
        const articleLink = document.createElement('a');
        articleLink.href = entry.href;
        articleLink.textContent = 'Open the full article';
        errorPanel.append(errorDetail, articleLink);
        visualHost.replaceChildren(errorPanel);
        stage.hidden = false;
        stage.setAttribute('aria-hidden', 'false');
        controls?.removeAttribute('hidden');
        stage.setAttribute('aria-busy', 'false');
        visualHost.setAttribute('aria-busy', 'false');
      }
    }

    previous?.addEventListener('click', () => void showEntry(currentIndex - 1, { push: true, focus: true }), listenerOptions);
    next?.addEventListener('click', () => void showEntry(currentIndex + 1, { push: true, focus: true }), listenerOptions);
    contentsEntries.forEach((link) => link.addEventListener('click', (event) => {
      const index = entries.findIndex((entry) => entry.slug === link.dataset.reviewContentEntry);
      if (index < 0) return;
      event.preventDefault();
      void showEntry(index, { push: true, focus: true });
    }, listenerOptions));
    explanationToggle?.addEventListener('click', () => setExplanation(!explanationOpen), listenerOptions);
    explanationClose?.addEventListener('click', () => setExplanation(false), listenerOptions);
    desktopExplanation.addEventListener('change', () => setExplanation(explanationOpen, false), listenerOptions);
    window.addEventListener('popstate', () => void showEntry(indexFromHash()), listenerOptions);
    window.addEventListener('hashchange', () => {
      const nextIndex = indexFromHash();
      if (nextIndex !== currentIndex) void showEntry(nextIndex);
    }, listenerOptions);
    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement || event.target instanceof HTMLSelectElement) return;
      if (event.key === 'Escape' && explanationOpen) { event.preventDefault(); setExplanation(false); return; }
      if (event.key === 'ArrowLeft' && currentIndex > 0) { event.preventDefault(); void showEntry(currentIndex - 1, { push: true, focus: true }); }
      if (event.key === 'ArrowRight' && currentIndex < entries.length - 1) { event.preventDefault(); void showEntry(currentIndex + 1, { push: true, focus: true }); }
    }, listenerOptions);
    stage?.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX; }, { passive: true, signal: lifecycle.signal });
    stage?.addEventListener('touchend', (event) => {
      if (touchStartX === undefined || explanationOpen) return;
      const distance = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      touchStartX = undefined;
      if (Math.abs(distance) < 60) return;
      if (distance > 0 && currentIndex > 0) void showEntry(currentIndex - 1, { push: true, focus: true });
      if (distance < 0 && currentIndex < entries.length - 1) void showEntry(currentIndex + 1, { push: true, focus: true });
    }, { passive: true, signal: lifecycle.signal });
    document.addEventListener('astro:before-preparation', () => lifecycle.abort(), { once: true, signal: lifecycle.signal });

    void showEntry(indexFromHash());
  }
</script>

<style>
  .visual-review-mode {
    min-height: calc(100dvh - var(--header-height));
    padding-bottom: 4.5rem;
    background: var(--c-bg-tint);
  }
  .review-toolbar {
    position: sticky;
    top: var(--header-height);
    z-index: 40;
    display: grid;
    grid-template-columns: minmax(5rem, 1fr) minmax(0, 2fr) minmax(5rem, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: 3.2rem;
    padding: .45rem max(var(--gutter), calc((100vw - 88rem) / 2));
    border-bottom: 1px solid var(--c-rule);
    background: color-mix(in srgb, var(--c-bg) 94%, transparent);
    backdrop-filter: blur(12px);
  }
  .review-toolbar > a { color: var(--c-text-soft); font-size: .72rem; text-decoration: none; }
  .review-toolbar > a:hover { color: var(--c-accent); }
  .review-toolbar p { min-width: 0; margin: 0; text-align: center; }
  .review-toolbar p span,
  .review-toolbar p strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .review-toolbar p span { color: var(--c-muted); font-size: .6rem; }
  .review-toolbar p strong { margin-top: .05rem; color: var(--c-text); font-size: .76rem; }
  .review-progress-wrap { display: grid; justify-items: end; gap: .05rem; }
  .review-progress-wrap span { color: var(--c-text-soft); font-family: var(--font-mono); font-size: .66rem; }
  .review-progress-wrap small { color: var(--c-muted); font-size: .56rem; }
  .review-contents {
    position: fixed;
    top: calc(var(--header-height) + 3.9rem);
    right: max(var(--gutter), calc((100vw - 96rem) / 2));
    z-index: 39;
    width: min(20rem, calc(100vw - 2rem));
    pointer-events: none;
  }
  .review-contents-details { pointer-events: auto; }
  .review-contents-details > summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: .55rem;
    align-items: center;
    width: fit-content;
    min-width: 8rem;
    margin-left: auto;
    padding: .5rem .65rem;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-bg) 96%, transparent);
    box-shadow: 0 .35rem 1rem color-mix(in srgb, var(--c-text) 7%, transparent);
    color: var(--c-text);
    cursor: pointer;
    font-family: var(--font-ui);
