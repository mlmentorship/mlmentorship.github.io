---
import { SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/'
    || pathname.startsWith('/library/')
    || pathname.startsWith('/concepts/')
    || pathname.startsWith('/guides/');
  if (href === '/prep/') return pathname.startsWith('/prep/');
  return pathname === href || pathname.startsWith(href);
}

const visibleNav = SITE.nav.filter((item) => item.href !== '/prep/' || SITE.features.prepTools);
const navItems: Array<{ label: string; href: string; external?: boolean }> = SITE.features.bookingCTA
  ? [...visibleNav.slice(0, -1), { label: 'Mock', href: '/interview/' }, visibleNav[visibleNav.length - 1]]
  : [...visibleNav];
---

<header class="masthead" data-pagefind-ignore="all">
  <div class="container bar">
    <a class="brand" href="/" aria-label="mlmentorship contents">
      <span class="brand-name"><strong>ml</strong>mentorship</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ active: isActive(item.href) }, item.external && 'external']}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="bar-end">
      <Search />
      <ThemeToggle />
      <details class="mobile-nav">
        <summary class="menu-trigger" aria-label="Navigation menu">
          <span></span><span></span><span></span>
        </summary>
        <nav class="nav-mobile" aria-label="Mobile">
          <ul>
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[{ active: isActive(item.href) }, item.external && 'external']}
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: .8rem;
    min-height: var(--header-height);
    padding: .45rem var(--gutter);
    max-width: var(--container);
    margin: 0 auto;
  }
  .brand {
    color: var(--c-text);
    line-height: 1;
    text-decoration: none;
  }
  .brand:hover { color: var(--c-text); text-decoration: none; }
  .brand-name {
    font-family: var(--font-display);
    font-size: .92rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .brand-name strong { color: var(--c-accent); font-weight: 750; }

  .nav-desktop { margin-left: auto; }
  .nav-desktop ul {
    display: flex;
    gap: 1.05rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop a {
    position: relative;
    padding: .4rem 0;
    color: var(--c-text-soft);
    font-family: var(--font-ui);
    font-size: .76rem;
    font-weight: 550;
    letter-spacing: 0;
    text-decoration: none;
  }
  .nav-desktop a:hover { color: var(--c-accent); }
  .nav-desktop a.active { color: var(--c-text); }
  .nav-desktop a.active::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--c-accent);
    content: '';
  }
  .ext { margin-left: 0.2rem; font-size: 0.75em; opacity: 0.6; }

  .bar-end { display: inline-flex; align-items: center; gap: .2rem; }
  .mobile-nav { display: none; position: relative; }
  .menu-trigger {
    display: flex;
    width: 32px;
    height: 32px;
    cursor: pointer;
    list-style: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 0;
    border: 1px solid var(--c-rule);
    border-radius: 50%;
    background: var(--c-bg);
  }
  .menu-trigger::-webkit-details-marker { display: none; }
  .menu-trigger span {
    display: block;
    width: 15px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--c-text);
  }
  .mobile-nav[open] .menu-trigger { border-color: var(--c-accent); }
  .mobile-nav[open] .menu-trigger span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .mobile-nav[open] .menu-trigger span:nth-child(2) { opacity: 0; }
  .mobile-nav[open] .menu-trigger span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .nav-mobile {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.45rem;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-md);
  }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile li { margin: 0; }
  .nav-mobile a {
    display: block;
    padding: .6rem .65rem;
    border-radius: var(--radius);
    color: var(--c-text-soft);
    font-family: var(--font-ui);
    font-size: .78rem;
    font-weight: 550;
    letter-spacing: 0;
    text-decoration: none;
  }
  .nav-mobile a:hover { background: var(--c-bg-tint); color: var(--c-text); }
  .nav-mobile a.active { background: var(--c-accent-soft); color: var(--c-accent); }

  @media (max-width: 760px) {
    .nav-desktop { display: none; }
    .mobile-nav { display: block; }
  }
  @media (max-width: 420px) {
    .brand-name { font-size: .9rem; }
    .bar { gap: 0.5rem; }
  }
</style>