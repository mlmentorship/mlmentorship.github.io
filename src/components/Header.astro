---
// Header.astro, site masthead with a sliding mobile menu
import { SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  if (href === '/prep/') {
    return ['/prep/', '/readiness/', '/practice/', '/story-bank/', '/plans/', '/final-week/'].includes(pathname);
  }
  return pathname === href || pathname.startsWith(href);
}

// Append the mock-interview link only when the booking CTA feature flag is on.
const navItems: Array<{ label: string; href: string; external?: boolean }> = SITE.features.bookingCTA
  ? [...SITE.nav.slice(0, -1), { label: 'Mock', href: '/interview/' }, SITE.nav[SITE.nav.length - 1]]
  : [...SITE.nav];
---

<header class="masthead" data-pagefind-ignore="all">
  <div class="container bar">
    <a class="brand" href="/" aria-label="mlmentorship home">
      <span class="brand-mark" aria-hidden="true">ml</span>
      <span class="brand-name">mentorship</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ active: isActive(item.href) }, item.external && 'external']}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="bar-end">
      <Search />
      <ThemeToggle />
      <button id="menu-trigger" class="menu-trigger" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="nav-mobile" aria-label="Mobile" inert>
    <ul>
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[{ active: isActive(item.href) }, item.external && 'external']}
            rel={item.external ? 'noopener' : undefined}
          >
            {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--c-rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.1rem var(--gutter);
    max-width: var(--container);
    margin: 0 auto;
  }
  .brand {
    display: flex; flex-direction: row; align-items: center; gap: 0.55rem; line-height: 1.1;
    text-decoration: none;
    color: inherit;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 28px;
    padding: 0 6px;
    border-radius: 6px;
    background: var(--c-accent-fill);
    color: var(--c-on-accent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    color: var(--c-text-soft);
    letter-spacing: -0.012em;
  }
  .brand-name strong { color: var(--c-text); font-weight: 700; }
  .brand-sub {
    font-family: var(--font-ui);
    font-size: 0.64rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--c-muted);
    margin-top: 2px;
  }

  .nav-desktop { margin-left: auto; }
  .nav-desktop ul {
    list-style: none; display: flex; gap: 1.6rem;
    padding: 0; margin: 0;
  }
  .nav-desktop a {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--c-text-soft);
    text-decoration: none;
    padding: .5rem 0;
    position: relative;
    transition: color var(--transition);
  }
  .nav-desktop a:hover { color: var(--c-accent); }
  .nav-desktop a.active { color: var(--c-text); }
  .nav-desktop a.external .ext {
    margin-left: 0.2rem;
    font-size: 0.75em;
    opacity: 0.55;
    vertical-align: 0.05em;
  }
  .nav-desktop a.active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 2px;
    height: 2px;
    background: var(--c-accent);
  }

  .bar-end { display: inline-flex; gap: .6rem; align-items: center; }

  .menu-trigger {
    display: none;
    background: none; border: 1px solid var(--c-rule);
    width: 38px; height: 38px; border-radius: var(--radius);
    cursor: pointer; padding: 0;
    flex-direction: column; justify-content: center; align-items: center; gap: 4px;
  }
  .menu-trigger span {
    display: block; width: 18px; height: 1.5px;
    background: var(--c-text); border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }
  .menu-trigger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  .menu-trigger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-trigger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .nav-mobile {
    max-height: 0; overflow: hidden;
    transition: max-height var(--transition);
    border-top: 1px solid transparent;
  }
  .nav-mobile.is-open {
    max-height: 500px;
    border-top-color: var(--c-rule);
  }
  .nav-mobile ul {
    list-style: none; padding: .8rem var(--gutter); margin: 0;
    display: flex; flex-direction: column; gap: .2rem;
  }
  .nav-mobile a {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: .8rem 0;
    text-decoration: none;
    color: var(--c-text);
    border-bottom: 1px solid var(--c-rule);
  }
  .nav-mobile a.active { color: var(--c-accent); }
  .nav-mobile li:last-child a { border-bottom: none; }

  @media (max-width: 720px) {
    .nav-desktop { display: none; }
    .menu-trigger { display: inline-flex; }
    .brand-sub { display: none; }
  }
</style>

<script>
  function bindMenu() {
    const trigger = document.getElementById('menu-trigger');
    const menu = document.getElementById('mobile-menu');
    if (!trigger || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) menu.removeAttribute('inert'); else menu.setAttribute('inert', '');
    };

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) menu.querySelector('a')?.focus();
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        trigger.focus();
      }
    });
  }
  bindMenu();
  document.addEventListener('astro:after-swap', bindMenu);
</script>
