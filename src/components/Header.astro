---
import { SITE } from '../consts';
import { findLibraryLocation } from '../data/library';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';

const pathname = Astro.url.pathname;
const pathParts = pathname.split('/').filter(Boolean);
const articleSlug = pathParts.length === 2 && ['concepts', 'questions', 'guides'].includes(pathParts[0]) ? pathParts[1] : undefined;
const currentBookId = articleSlug
  ? findLibraryLocation(articleSlug)?.volume.id
  : pathParts[0] === 'library'
    ? pathParts[1]
    : undefined;
const isCodingRoute = currentBookId === 'coding-interview';
const isReviewRoute = pathname === '/review/' || pathname.startsWith('/review/');
const showReadingMode = Boolean(articleSlug) || isReviewRoute;
const visualModeHref = articleSlug ? `/review/#${articleSlug}` : '/review/';
const fullModeHref = articleSlug ? '#full-explanation' : '/#curriculum';
const visualModeActive = pathname === '/' || isReviewRoute;
const readingModes = [
  { label: 'Visual', description: 'Visual review mode', href: visualModeHref, active: visualModeActive, dataKey: 'visual' },
  { label: 'Full', description: 'Full lesson mode', href: fullModeHref, active: !visualModeActive, dataKey: 'full' },
];
function isActive(href: string) {
  if (href === '/#curriculum') return pathname === '/'
    || (!isCodingRoute && (pathname.startsWith('/library/') || pathname.startsWith('/concepts/') || pathname.startsWith('/guides/')));
  if (href === '/library/coding-interview/') return isCodingRoute;
  if (href === '/questions/') return !isCodingRoute && pathname.startsWith('/questions/');
  if (href === '/prep/') return pathname.startsWith('/prep/');
  return pathname === href || pathname.startsWith(href);
}

const visibleNav = SITE.nav.filter((item) => item.href !== '/prep/' || SITE.features.prepTools);
const navItems: Array<{ label: string; href: string; external?: boolean }> = [...visibleNav];
---

<header class="masthead" data-pagefind-ignore="all">
  <div class="container bar">
    <a class="brand" href="/" aria-label="mlmentorship contents">
      <span class="brand-name"><strong>ml</strong>mentorship</span>
    </a>

    {showReadingMode && (
      <nav class="reading-mode-switch reading-mode-switch--persistent" aria-label="Reading mode" data-reading-mode-nav>
        {readingModes.map((mode) => (
          <a
            href={mode.href}
            class:list={[mode.active && 'active']}
            aria-current={mode.active ? 'page' : undefined}
            aria-label={mode.description}
            data-reading-mode={mode.dataKey}
          >{mode.label}</a>
        ))}
      </nav>
    )}

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ active: isActive(item.href) }, item.external && 'external']}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="bar-end">
      <Search />
      <ThemeToggle />
      <details class="mobile-nav">
        <summary class="menu-trigger" aria-label="Navigation menu">
          <span></span><span></span><span></span>
        </summary>
        <nav class="nav-mobile" aria-label="Mobile">
          <ul>
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[{ active: isActive(item.href) }, item.external && 'external']}
                  rel={item.external ? 'noopener' : undefined}
                >
                  {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const readingModeNav = document.querySelector<HTMLElement>('[data-reading-mode-nav]');

  function syncReadingMode() {
    const visualActive = window.location.pathname === '/review/'
      || (window.location.pathname === '/' && window.location.hash !== '#curriculum');
    const reviewIndex = window.location.pathname === '/review/' && !window.location.hash;
    readingModeNav?.toggleAttribute('hidden', reviewIndex);
    document.querySelectorAll<HTMLAnchorElement>('[data-reading-mode]').forEach((link) => {
      const active = link.dataset.readingMode === (visualActive ? 'visual' : 'full');
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  syncReadingMode();
  window.addEventListener('hashchange', syncReadingMode);
  window.addEventListener('popstate', syncReadingMode);
  window.addEventListener('review-route-change', syncReadingMode);
  document.addEventListener('astro:page-load', syncReadingMode);
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: .8rem;
    min-height: var(--header-height);
    padding: .45rem var(--gutter);
    max-width: var(--container);
    margin: 0 auto;
  }
  .brand {
    color: var(--c-text);
    line-height: 1;
    text-decoration: none;
  }
  .brand:hover { color: var(--c-text); text-decoration: none; }
  .brand-name {
    font-family: var(--font-display);
    font-size: .92rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .brand-name strong { color: var(--c-accent); font-weight: 750; }

  .reading-mode-switch {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    background: var(--c-bg-tint);
    font-family: var(--font-ui);
  }
  .reading-mode-switch--persistent { flex: 0 0 auto; }
  .reading-mode-switch a {
    min-width: 3.35rem;
    padding: .3rem .5rem;
    border-radius: 2px;
    color: var(--c-muted);
    font-size: .67rem;
    font-weight: 650;
    text-align: center;
    text-decoration: none;
  }
  .reading-mode-switch a:hover { color: var(--c-text); }
  .reading-mode-switch a.active { background: var(--c-surface); color: var(--c-accent); box-shadow: 0 0 0 1px var(--c-rule); }

  .nav-desktop { margin-left: auto; }
  .nav-desktop ul {
    display: flex;
    gap: 1.05rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop a {
    position: relative;
    padding: .4rem 0;
    color: var(--c-text-soft);
    font-family: var(--font-ui);
    font-size: .76rem;
    font-weight: 550;
    letter-spacing: 0;
    text-decoration: none;
  }
  .nav-desktop a:hover { color: var(--c-accent); }
  .nav-desktop a.active { color: var(--c-text); }
  .nav-desktop a.active::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--c-accent);
    content: '';
  }
  .ext { margin-left: 0.2rem; font-size: 0.75em; opacity: 0.6; }

  .bar-end { display: inline-flex; align-items: center; gap: .2rem; }
  .mobile-nav { display: none; position: relative; }
  .menu-trigger {
    display: flex;
    width: 32px;
    height: 32px;
    cursor: pointer;
    list-style: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 0;
    border: 1px solid var(--c-rule);
    border-radius: 50%;
    background: var(--c-bg);
  }
  .menu-trigger::-webkit-details-marker { display: none; }
  .menu-trigger span {
    display: block;
    width: 15px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--c-text);
  }
  .mobile-nav[open] .menu-trigger { border-color: var(--c-accent); }
  .mobile-nav[open] .menu-trigger span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .mobile-nav[open] .menu-trigger span:nth-child(2) { opacity: 0; }
  .mobile-nav[open] .menu-trigger span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .nav-mobile {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(18rem, calc(100vw - 2rem));
    padding: 0.45rem;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-md);
  }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile li { margin: 0; }
  .nav-mobile a {
    display: block;
    padding: .6rem .65rem;
    border-radius: var(--radius);
    color: var(--c-text-soft);
    font-family: var(--font-ui);
    font-size: .78rem;
    font-weight: 550;
    letter-spacing: 0;
    text-decoration: none;
  }
  .nav-mobile a:hover { background: var(--c-bg-tint); color: var(--c-text); }
  .nav-mobile a.active { background: var(--c-accent-soft); color: var(--c-accent); }

  @media (max-width: 940px) {
    .nav-desktop { display: none; }
    .reading-mode-switch--persistent a { min-width: 2.9rem; padding: .3rem .35rem; font-size: .62rem; }
    .bar-end { margin-left: auto; }
    .mobile-nav { display: block; }
  }
  @media (max-width: 420px) {
    .brand-name { font-size: .9rem; }
    .bar { gap: 0.5rem; }
    .reading-mode-switch--persistent a { min-width: 2.5rem; padding: .28rem .25rem; font-size: .6rem; }
  }
</style>