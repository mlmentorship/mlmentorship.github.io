---
// Search overlay using Pagefind. The pagefind index is generated at build time
// (`pagefind --site dist`) and served from /pagefind/. We load the UI script
// at runtime via a script tag rather than Vite-resolved import, so the build
// doesn't fail.
---

<button id="search-trigger" class="search-trigger" aria-label="Search, Control or Command K" aria-keyshortcuts="Meta+K Control+K" type="button" data-pagefind-ignore="all">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7"/>
    <path d="m21 21-4.3-4.3"/>
  </svg>
  <span class="search-trigger-label">Search</span>
  <kbd class="search-trigger-kbd" aria-hidden="true">⌘K</kbd>
</button>

<dialog id="search-dialog" class="search-dialog" aria-label="Search the site" data-pagefind-ignore="all">
  <div class="search-inner">
    <button class="search-close" type="button" data-search-close aria-label="Close search">×</button>
    <aside id="search-topic-hint" class="search-topic-hint" hidden>
      <strong data-topic-hint-title></strong>
      <p data-topic-hint-copy></p>
      <a data-topic-hint-link></a>
    </aside>
    <div id="pagefind-host"></div>
    <p class="search-hint" id="search-hint" hidden>Search index not available in dev. Run <code>npm run build &amp;&amp; npm run preview</code> to use search locally.</p>
  </div>
</dialog>

<style is:global>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    background: transparent;
    border: 0;
    color: var(--c-text-soft);
    padding: .35rem .45rem;
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: .76rem;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }
  .search-trigger:hover { background: var(--c-bg-tint); color: var(--c-text); }
  .search-trigger-label { line-height: 1; }
  .search-trigger-kbd {
    display: none;
  }

  .search-dialog {
    width: min(680px, 92vw);
    max-height: 80vh;
    margin: 6vh auto auto;
    padding: 0;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-text);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .search-dialog::backdrop {
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(2px);
  }
  .search-inner { padding: 1rem; min-height: 4rem; }
  .search-close { display: grid; width: 2rem; height: 2rem; margin: 0 0 .65rem auto; place-items: center; border: 1px solid var(--c-rule); border-radius: 50%; background: var(--c-bg); color: var(--c-text-soft); cursor: pointer; font-size: 1.15rem; line-height: 1; }
  .search-close:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .search-hint {
    color: var(--c-muted);
    font-size: 0.9rem;
    margin: 0;
    padding: 1rem;
  }
  .search-hint code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--c-code-bg);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
  }
  .search-topic-hint { margin: 0 0 .8rem; padding: .75rem .85rem; border-left: 3px solid var(--c-accent); background: var(--c-bg-tint); }
  .search-topic-hint strong, .search-topic-hint p, .search-topic-hint a { display: block; }
  .search-topic-hint strong { font-size: .85rem; }
  .search-topic-hint p { margin: .15rem 0 .35rem; color: var(--c-text-soft); font-size: .8rem; line-height: 1.4; }
  .search-topic-hint a { width: fit-content; font-size: .78rem; font-weight: 650; text-decoration: none; }
  .search-topic-hint a:hover { text-decoration: underline; }

  @media (max-width: 480px) {
    .search-trigger-label,
    .search-trigger-kbd { display: none; }
    .search-trigger { width: 32px; height: 32px; justify-content: center; padding: 0; }
  }

  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--c-accent);
    --pagefind-ui-text: var(--c-text);
    --pagefind-ui-background: var(--c-surface);
    --pagefind-ui-border: var(--c-rule);
    --pagefind-ui-tag: var(--c-bg-tint);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-image-border-radius: var(--radius);
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-ui);
  }
  .pagefind-ui__search-input {
    font-family: var(--font-ui) !important;
    background: var(--c-bg) !important;
    border: 1px solid var(--c-rule) !important;
  }
  .pagefind-ui__result-link { color: var(--c-text) !important; font-weight: 600 !important; }
  .pagefind-ui__result-excerpt { color: var(--c-text-soft) !important; }
  .pagefind-ui__result mark { background: var(--c-highlight) !important; color: var(--c-text) !important; }
</style>

<!-- Pagefind UI bundle: served from /pagefind/ at the static site root, populated by `pagefind --site dist` at build time. Missing in dev. -->
<script is:inline define:vars={{}}>
  (function () {
    const trigger = document.getElementById('search-trigger');
    const dialog = document.getElementById('search-dialog');
    const hint = document.getElementById('search-hint');
    const topicHint = document.getElementById('search-topic-hint');
    const topicHints = [
      {
        terms: ['cuped', 'variance reduction', 'minimum detectable effect'],
        title: 'This advanced experiment topic is covered inside broader entries.',
        copy: 'Start with hypothesis testing and A/B testing. Use the causal-inference entry when assignment or identification is the main issue.',
        label: 'Open hypothesis testing',
        href: '/concepts/hypothesis-testing-confidence-intervals/',
      },
      {
        terms: ['sql', 'leetcode', 'data structures', 'general algorithms', 'object oriented design', 'oop interview'],
        title: 'This interview dependency is intentionally external.',
        copy: 'mlmentorship tracks these rounds in readiness, but does not duplicate dedicated coding or SQL curricula.',
        label: 'Open the readiness check',
        href: '/prep/readiness/',
      },
      {
        terms: ['cuda', 'triton kernel', 'pallas'],
        title: 'Low-level kernel programming is specialist material.',
        copy: 'Start with hardware, profiling, and roofline reasoning here, then use a current framework-specific kernel course.',
        label: 'Open hardware and performance',
        href: '/library/systems/hardware-performance/',
      },
    ];
    const aliases = new Map([
      ['cross val', 'cross validation'],
      ['zero 3', 'FSDP ZeRO'],
      ['zero stage 3', 'FSDP ZeRO'],
      ['mfu', 'model FLOPs utilization MFU'],
      ['cot monitoring', 'chain of thought monitorability'],
      ['lora', 'LoRA adapter'],
      ['rlvr', 'verifiable rewards'],
      ['gqa', 'grouped query attention'],
    ]);
    let pagefindLoaded = false;
    let pagefindFailed = false;

    function loadScript(src) {
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('failed to load ' + src));
        document.head.appendChild(s);
      });
    }

    async function loadPagefind() {
      if (pagefindLoaded || pagefindFailed) return;
      try {
        // Load both the UI script and its CSS.
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(css);
        await loadScript('/pagefind/pagefind-ui.js');
        // PagefindUI is now globally available
        // eslint-disable-next-line no-new
        new window.PagefindUI({
          element: '#pagefind-host',
          pageSize: 8,
          showSubResults: false,
          showEmptyFilters: false,
          resetStyles: false,
          showImages: false,
          excerptLength: 24,
          processTerm: (term) => aliases.get(term.trim().toLowerCase()) || term,
        });
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input && topicHint) {
          input.addEventListener('input', () => {
            const term = input.value.trim().toLowerCase();
            const match = topicHints.find((item) => item.terms.some((candidate) => term.includes(candidate)));
            topicHint.hidden = !match;
            if (!match) return;
            topicHint.querySelector('[data-topic-hint-title]').textContent = match.title;
            topicHint.querySelector('[data-topic-hint-copy]').textContent = match.copy;
            const link = topicHint.querySelector('[data-topic-hint-link]');
            link.textContent = match.label;
            link.href = match.href;
          });
        }
        pagefindLoaded = true;
      } catch (err) {
        pagefindFailed = true;
        if (hint) hint.hidden = false;
      }
    }

    function openDialog() {
      if (!dialog) return;
      loadPagefind().then(() => {
        dialog.showModal();
        requestAnimationFrame(() => {
          const input = dialog.querySelector('.pagefind-ui__search-input');
          if (input) {
            input.setAttribute('id', 'site-search-input');
            input.setAttribute('name', 'q');
            input.focus();
          }
        });
      });
    }

    if (trigger) trigger.addEventListener('click', openDialog);
    document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());

    document.addEventListener('keydown', (e) => {
      const tag = (document.activeElement && document.activeElement.tagName || '').toLowerCase();
      const isTyping = tag === 'input' || tag === 'textarea' || (document.activeElement && document.activeElement.isContentEditable);
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openDialog();
        return;
      }
      if (!isTyping && e.key === '/' && !(dialog && dialog.open)) {
        e.preventDefault();
        openDialog();
      }
      if (e.key === 'Escape' && dialog && dialog.open) {
        dialog.close();
      }
    });

    if (dialog) {
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  })();
</script>
