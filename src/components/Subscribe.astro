---
// A progressive Beehiiv embed. The provider loads only when an eligible
// prompt approaches the viewport. The repeated entry prompt is shown once per
// browser session, with longer local suppression after success or opt-out.
import { SITE } from '../consts';

type Placement = 'home' | 'entry' | 'review' | 'workbook';

interface Props {
  placement?: Placement;
  heading?: string;
}

const {
  placement = 'entry',
  heading = placement === 'home' || placement === 'review'
    ? 'Get ML from Primitives notes when they are worth sending.'
    : 'Get the next ML from Primitives note.',
} = Astro.props;
const headingId = `email-signup-${placement}-heading`;
const hasEmail =
  SITE.newsletter.provider === 'beehiiv' &&
  SITE.newsletter.formId.length > 0;
---

<aside
  class:list={['subscribe', `subscribe--${placement}`]}
  id={placement === 'home' ? 'email-notes' : undefined}
  aria-labelledby={headingId}
  data-email-signup
  data-email-placement={placement}
  data-email-enabled={hasEmail ? 'true' : 'false'}
  data-email-form={SITE.newsletter.formId}
  data-pagefind-ignore="all"
>
  <div class="inner">
    <div class="copy">
      <p class="eyebrow">ML from Primitives</p>
      <h2 id={headingId} class="title">{heading}</h2>
      <p class="blurb">{SITE.newsletter.blurb}</p>
    </div>

    <div class="signup-panel">
      {hasEmail && (
        <div class="provider-frame">
          <div class="beehiiv-embedded" data-email-provider-host></div>
          <p class="form-status" data-email-status aria-live="polite">Loading the email form...</p>
        </div>
      )}

      {hasEmail && <p class="terms">Subscribe through Beehiiv. Unsubscribe any time. <a href="/privacy/">Privacy details</a>.</p>}
      <div class="alternatives" data-email-actions>
        <span>{hasEmail ? 'Prefer a feed?' : 'Follow via'} <a href="/rss.xml">RSS</a> · <a href={`https://blogtrottr.com/?subscribe=${SITE.url}/rss.xml`} rel="noopener">RSS by email</a></span>
        {placement === 'entry' && <button type="button" data-email-dismiss>Not now</button>}
      </div>
    </div>
  </div>
</aside>

<script>
  import { trackPublicEvent } from '../utils/publicEvents';
  import { WORKBOOK_UNLOCK_KEY } from '../utils/newsletter';

  type Placement = 'home' | 'entry' | 'review' | 'workbook';

  const eventNames = {
    home: {
      viewed: 'email_signup_viewed_home',
      attempted: 'email_signup_attempted_home',
      confirmationSent: 'email_signup_confirmation_sent_home',
    },
    entry: {
      viewed: 'email_signup_viewed_entry',
      attempted: 'email_signup_attempted_entry',
      confirmationSent: 'email_signup_confirmation_sent_entry',
      dismissed: 'email_signup_dismissed_entry',
    },
    review: {
      viewed: 'email_signup_viewed_review',
      attempted: 'email_signup_attempted_review',
      confirmationSent: 'email_signup_confirmation_sent_review',
    },
    workbook: {
      viewed: 'email_signup_viewed_workbook',
      attempted: 'email_signup_attempted_workbook',
      confirmationSent: 'email_signup_confirmation_sent_workbook',
    },
  } as const;

  function loadBeehiiv(formId: string, host: HTMLElement | null, onError: () => void): void {
    if (!host || host.dataset.beehiivLoaded === 'true') return;
    host.dataset.beehiivLoaded = 'true';

    if (!document.querySelector('script[data-mlmentorship-beehiiv-attribution]')) {
      const attribution = document.createElement('script');
      attribution.async = true;
      attribution.type = 'text/javascript';
      attribution.src = 'https://subscribe-forms.beehiiv.com/attribution.js';
      attribution.dataset.mlmentorshipBeehiivAttribution = '';
      document.head.appendChild(attribution);
    }

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://subscribe-forms.beehiiv.com/v3/loader.js';
    script.dataset.beehiivForm = formId;
    script.dataset.mlmentorshipBeehiiv = '';
    script.addEventListener('error', onError, { once: true });
    host.appendChild(script);
  }

  document.querySelectorAll<HTMLElement>('[data-email-signup]').forEach((signup) => {
    if (signup.dataset.emailReady === 'true') return;
    signup.dataset.emailReady = 'true';

    const placement = signup.dataset.emailPlacement as Placement;
    const events = eventNames[placement];

    const emailEnabled = signup.dataset.emailEnabled === 'true';
    const formId = signup.dataset.emailForm ?? '';
    const status = signup.querySelector<HTMLElement>('[data-email-status]');
    const embed = signup.querySelector<HTMLElement>('[data-email-provider-host]');
    const actions = signup.querySelector<HTMLElement>('[data-email-actions]');
    let loaded = false;
    let viewed = false;
    let completed = false;
    let stopPositionChecks = () => {};

    const hide = () => {
      signup.hidden = true;
      loadObserver?.disconnect();
      viewObserver?.disconnect();
      stopPositionChecks();
    };
    const markCompleted = () => {
      if (completed) return;
      completed = true;
      try { window.localStorage.setItem(WORKBOOK_UNLOCK_KEY, '1'); } catch { /* The form still works. */ }
      actions?.setAttribute('hidden', '');
      trackPublicEvent(events.confirmationSent);
      window.dispatchEvent(new Event('workbook-email-unlocked'));
    };
    const handleProviderMessage = (event: MessageEvent) => {
      if (event.origin !== 'https://subscribe-forms.beehiiv.com') return;
      const payload = typeof event.data === 'string' ? event.data : JSON.stringify(event.data ?? '');
      if (!/\b(success|confirmed|subscribed|thank\s*you|double[- ]?opt[- ]?in)\b/i.test(payload)) return;
      if (/\b(error|failed|invalid|declined)\b/i.test(payload)) return;
      markCompleted();
    };
    window.addEventListener('message', handleProviderMessage);
    const loadForm = () => {
      if (loaded || !emailEnabled || !formId) return;
      loaded = true;
      loadBeehiiv(formId, embed, () => {
        if (status) status.textContent = 'The email form is unavailable. RSS by email still works.';
      });
      window.setTimeout(() => {
        if (status && embed && !embed.querySelector('form, iframe')) {
          status.textContent = 'The email form is taking longer than expected. RSS by email still works.';
        }
      }, 8000);
    };
    const markViewed = () => {
      if (viewed) return;
      viewed = true;
      trackPublicEvent(events.viewed);
    };

    const observer = embed && status ? new MutationObserver(() => {
      if (embed.querySelector('form, iframe')) {
        status.hidden = true;
      }
      const success = embed.querySelector<HTMLElement>('[class*="success"], [data-success="true"]');
      if (success && getComputedStyle(success).display !== 'none') markCompleted();
    }) : undefined;
    observer?.observe(embed!, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] });

    signup.addEventListener('submit', (event) => {
      if (event.target instanceof HTMLFormElement && signup.contains(event.target) && signup.dataset.emailStarted !== 'true') {
        signup.dataset.emailStarted = 'true';
        trackPublicEvent(events.attempted);
      }
    }, true);

    signup.querySelector<HTMLButtonElement>('[data-email-dismiss]')?.addEventListener('click', () => {
      if (placement === 'entry') trackPublicEvent(eventNames.entry.dismissed);
      hide();
    });

    let loadObserver: IntersectionObserver | undefined;
    let viewObserver: IntersectionObserver | undefined;
    signup.hidden = false;
    if ('IntersectionObserver' in window) {
      loadObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          loadForm();
          loadObserver?.disconnect();
        }
      }, { rootMargin: '500px 0px' });
      viewObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.3)) {
          markViewed();
          viewObserver?.disconnect();
        }
      }, { threshold: 0.3 });
      loadObserver.observe(signup);
      viewObserver.observe(signup);

      const checkPosition = () => {
        const bounds = signup.getBoundingClientRect();
        if (bounds.top < window.innerHeight + 500 && bounds.bottom > -500) loadForm();
        const visiblePixels = Math.max(0, Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, 0));
        if (bounds.height > 0 && visiblePixels / bounds.height >= 0.3) markViewed();
        if (loaded && viewed) stopPositionChecks();
      };
      stopPositionChecks = () => {
        window.removeEventListener('scroll', checkPosition);
        window.removeEventListener('resize', checkPosition);
      };
      window.addEventListener('scroll', checkPosition, { passive: true });
      window.addEventListener('resize', checkPosition, { passive: true });
      checkPosition();
    } else {
      loadForm();
      markViewed();
    }
  });
</script>

<style>
  .subscribe { width: min(100%, 70rem); margin: 2.2rem auto 0; padding: 1.1rem 1rem; border: 1px solid var(--c-rule); border-left: 3px solid var(--c-accent); background: var(--c-bg-tint); }
  .inner { max-width: none; margin: 0; display: grid; grid-template-columns: minmax(0, .9fr) minmax(18rem, 1.1fr); gap: 1.4rem; align-items: center; }
  .eyebrow {
    margin: 0 0 .25rem;
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: .62rem;
    font-weight: 600;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .title {
    margin: 0 0 .25rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -.01em;
  }
  .blurb {
    margin: 0;
    color: var(--c-text-soft);
    font-family: var(--font-reading);
    font-size: .76rem;
    line-height: 1.5;
  }
  .provider-frame {
    height: 10.6rem;
    min-height: 0;
    display: grid;
    align-items: center;
    overflow: hidden;
  }
  .form-status { margin: .7rem 0 0; color: var(--c-muted); font-size: .72rem; }
  .terms, .alternatives {
    color: var(--c-muted);
    font-family: var(--font-ui);
    font-size: .65rem;
    line-height: 1.45;
  }
  .terms { margin: .45rem 0 0; }
  .alternatives { display: flex; flex-wrap: wrap; gap: .25rem .7rem; margin-top: .25rem; }
  .alternatives[hidden] { display: none; }
  .terms a, .alternatives a, .alternatives button { color: var(--c-text-soft); }
  .alternatives button {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .terms a:hover, .alternatives a:hover, .alternatives button:hover { color: var(--c-accent); }

  /* Beehiiv supplies behavior; these overrides keep the managed form native to the site. */
  .beehiiv-embedded {
    width: 100%;
    min-width: 0;
    min-height: 2.45rem;
  }
  .subscribe :global(iframe) {
    width: 122% !important;
    min-height: 12.95rem !important;
    margin-left: -11% !important;
    border: 0 !important;
    background: transparent !important;
    transform: scale(.82);
    transform-origin: center center;
  }
  :global(html[data-theme='dark']) .subscribe :global(iframe) { filter: invert(.92); }
  .subscribe :global(form) {
    display: flex !important;
    gap: .5rem !important;
    align-items: stretch !important;
    width: 100% !important;
    margin: 0 !important;
  }
  .subscribe :global(input[type="email"]) {
    flex: 1 1 13rem !important;
    min-height: 2.45rem !important;
    min-width: 0 !important;
    padding: .55rem .68rem !important;
    border: 1px solid var(--c-rule) !important;
    border-radius: var(--radius) !important;
    background: var(--c-bg) !important;
    color: var(--c-text) !important;
    font-family: var(--font-ui) !important;
    font-size: .8rem !important;
  }
  .subscribe :global(input[type="email"]:focus) {
    border-color: var(--c-accent) !important;
    outline: 2px solid var(--c-accent) !important;
    outline-offset: 1px;
  }
  .subscribe :global(button),
  .subscribe :global(input[type="submit"]) {
    flex: 0 0 auto !important;
    width: auto !important;
    min-height: 2.45rem !important;
    padding: .55rem .78rem !important;
    border: 1px solid var(--c-accent-fill) !important;
    border-radius: var(--radius) !important;
    background: var(--c-accent-fill) !important;
    color: var(--c-on-accent) !important;
    font-family: var(--font-ui) !important;
    font-size: .76rem !important;
    font-weight: 650 !important;
  }
  .subscribe :global(button:hover),
  .subscribe :global(input[type="submit"]:hover) { background: var(--c-link-hover) !important; }
  .subscribe :global([class*="success"]) { margin: 0 !important; }
  .subscribe :global([class*="success"] h4),
  .subscribe :global([class*="success"] h3) {
    margin: 0 0 .2rem !important;
    color: var(--c-text) !important;
    font-family: var(--font-display) !important;
    font-size: 1rem !important;
    font-weight: 650 !important;
  }
  .subscribe :global([class*="success"] p) {
    margin: 0 !important;
    color: var(--c-text-soft) !important;
    font-family: var(--font-ui) !important;
    font-size: .72rem !important;
    line-height: 1.45 !important;
  }

  @media (max-width: 680px) {
    .subscribe { padding: 1rem .85rem; }
    .subscribe .inner { grid-template-columns: 1fr; gap: .75rem; }
  }
  @media (max-width: 420px) {
    .subscribe :global(form) { flex-direction: column !important; }
    .subscribe :global(input[type="email"]) { flex-basis: auto !important; }
    .subscribe :global(button),
    .subscribe :global(input[type="submit"]) { width: 100% !important; }
  }
</style>
