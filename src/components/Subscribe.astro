---
// A progressive MailerLite embed. The provider loads only when an eligible
// prompt approaches the viewport. The repeated entry prompt is shown once per
// browser session, with longer local suppression after success or opt-out.
import { SITE } from '../consts';

type Placement = 'home' | 'entry';

interface Props {
  placement?: Placement;
  heading?: string;
}

const {
  placement = 'entry',
  heading = placement === 'home'
    ? 'Get new field notes when they are worth sending.'
    : 'Get the next useful field note.',
} = Astro.props;
const headingId = `email-signup-${placement}-heading`;
const hasEmail =
  SITE.newsletter.provider === 'mailerlite' &&
  SITE.newsletter.accountId.length > 0 &&
  SITE.newsletter.formId.length > 0;
---

<aside
  class:list={['subscribe', `subscribe--${placement}`]}
  id={placement === 'home' ? 'email-notes' : undefined}
  aria-labelledby={headingId}
  data-email-signup
  data-email-placement={placement}
  data-email-enabled={hasEmail ? 'true' : 'false'}
  data-email-account={SITE.newsletter.accountId}
  hidden
  data-pagefind-ignore="all"
>
  <div class="inner">
    <div class="copy">
      <p class="eyebrow">Field notes by email</p>
      <h2 id={headingId} class="title">{heading}</h2>
      <p class="blurb">{SITE.newsletter.blurb}</p>
    </div>

    <div class="signup-panel">
      {hasEmail && (
        <div class="provider-frame">
          <div class="ml-embedded" data-form={SITE.newsletter.formId}></div>
          <p class="form-status" data-email-status aria-live="polite">Loading the email form…</p>
        </div>
      )}

      {hasEmail && <p class="terms">Double opt-in through MailerLite. Unsubscribe any time. <a href="/privacy/">Privacy details</a>.</p>}
      <div class="alternatives" data-email-actions>
        <span>{hasEmail ? 'Prefer a feed?' : 'Follow via'} <a href="/rss.xml">RSS</a> · <a href={`https://blogtrottr.com/?subscribe=${SITE.url}/rss.xml`} rel="noopener">RSS by email</a></span>
        {hasEmail && <button type="button" data-email-already>Already subscribed</button>}
        {placement === 'entry' && <button type="button" data-email-dismiss>Not now</button>}
      </div>
    </div>
  </div>
</aside>

<script>
  import { trackPublicEvent } from '../utils/publicEvents';

  type Placement = 'home' | 'entry';
  type MailerLiteWindow = Window & {
    ml?: ((command: string, value: string | boolean) => void) & { q?: unknown[][] };
    ml_webform_after_success?: () => void;
  };

  const SESSION_KEY = 'mlmentorship:email-signup:seen';
  const SUPPRESS_UNTIL_KEY = 'mlmentorship:email-signup:suppress-until';
  const SIX_MONTHS_MS = 180 * 24 * 60 * 60 * 1000;
  const eventNames = {
    home: {
      viewed: 'email_signup_viewed_home',
      attempted: 'email_signup_attempted_home',
      confirmationSent: 'email_signup_confirmation_sent_home',
    },
    entry: {
      viewed: 'email_signup_viewed_entry',
      attempted: 'email_signup_attempted_entry',
      confirmationSent: 'email_signup_confirmation_sent_entry',
      dismissed: 'email_signup_dismissed_entry',
    },
  } as const;

  type StorageName = 'localStorage' | 'sessionStorage';

  function storageGet(storageName: StorageName, key: string): string | null {
    try { return window[storageName].getItem(key); } catch (_) { return null; }
  }

  function storageSet(storageName: StorageName, key: string, value: string): void {
    try { window[storageName].setItem(key, value); } catch (_) { /* The form still works. */ }
  }

  function loadMailerLite(accountId: string, onError: () => void): void {
    const mlWindow = window as MailerLiteWindow;
    if (!mlWindow.ml) {
      const queued = ((command: string, value: string | boolean) => {
        (queued.q = queued.q || []).push([command, value]);
      }) as NonNullable<MailerLiteWindow['ml']>;
      mlWindow.ml = queued;
    }
    mlWindow.ml('enablePopups', false);
    mlWindow.ml('account', accountId);

    if (document.querySelector('script[data-mlmentorship-mailerlite]')) return;
    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://assets.mailerlite.com/js/universal.js';
    script.dataset.mlmentorshipMailerlite = '';
    script.addEventListener('error', onError, { once: true });
    document.head.appendChild(script);
  }

  function setImportant(element: HTMLElement | null, styles: Record<string, string>): void {
    if (!element) return;
    Object.entries(styles).forEach(([property, value]) => element.style.setProperty(property, value, 'important'));
  }

  function normalizeMailerLiteForm(embed: HTMLElement): void {
    if (embed.dataset.emailNormalized === 'true') return;
    const form = embed.querySelector<HTMLElement>('form.ml-block-form');
    if (!form) return;
    embed.dataset.emailNormalized = 'true';

    document.querySelectorAll<HTMLStyleElement>('style').forEach((style) => {
      if (style.textContent?.includes('assets.mlcdn.com/fonts.css')) {
        style.textContent = style.textContent.replace(/@import\s+url\(["']?https:\/\/assets\.mlcdn\.com\/fonts\.css[^;]*;/g, '');
      }
    });

    setImportant(form, { display: 'flex', gap: '.5rem', 'align-items': 'stretch', width: '100%' });
    setImportant(form.querySelector('.ml-form-formContent'), { flex: '1 1 auto', width: 'auto', margin: '0' });
    setImportant(form.querySelector('.ml-form-fieldRow'), { width: '100%', margin: '0' });
    setImportant(form.querySelector('.ml-field-group'), { width: '100%', margin: '0' });
    setImportant(form.querySelector('input[type="email"]'), {
      width: '100%',
      'min-width': '0',
      'min-height': '2.45rem',
      padding: '.55rem .68rem',
      border: '1px solid var(--c-rule)',
      'border-radius': 'var(--radius)',
      background: 'var(--c-bg)',
      color: 'var(--c-text)',
      'font-family': 'var(--font-ui)',
      'font-size': '.8rem',
    });
    setImportant(form.querySelector('.ml-form-embedSubmit'), { flex: '0 0 auto', width: 'auto', margin: '0', float: 'none', 'text-align': 'left' });
    form.querySelectorAll<HTMLElement>('.ml-form-embedSubmit button').forEach((button) => setImportant(button, {
      width: 'auto',
      'min-height': '2.45rem',
      padding: '.55rem .78rem',
      border: '1px solid var(--c-accent-fill)',
      'border-radius': 'var(--radius)',
      background: 'var(--c-accent-fill)',
      color: 'var(--c-on-accent)',
      'font-family': 'var(--font-ui)',
      'font-size': '.76rem',
      'font-weight': '650',
    }));
  }

  document.querySelectorAll<HTMLElement>('[data-email-signup]').forEach((signup) => {
    if (signup.dataset.emailReady === 'true') return;
    signup.dataset.emailReady = 'true';

    const placement = signup.dataset.emailPlacement as Placement;
    const events = eventNames[placement];
    const suppressUntil = Number(storageGet('localStorage', SUPPRESS_UNTIL_KEY) ?? '0');
    const seenThisSession = placement === 'entry' && storageGet('sessionStorage', SESSION_KEY) === '1';
    if (suppressUntil > Date.now() || seenThisSession) return;

    const emailEnabled = signup.dataset.emailEnabled === 'true';
    const accountId = signup.dataset.emailAccount ?? '';
    const status = signup.querySelector<HTMLElement>('[data-email-status]');
    const embed = signup.querySelector<HTMLElement>('.ml-embedded');
    const actions = signup.querySelector<HTMLElement>('[data-email-actions]');
    let loaded = false;
    let viewed = false;
    let completed = false;
    let stopPositionChecks = () => {};

    const hide = () => {
      signup.hidden = true;
      loadObserver?.disconnect();
      viewObserver?.disconnect();
      stopPositionChecks();
    };
    const suppressForSixMonths = () => {
      storageSet('localStorage', SUPPRESS_UNTIL_KEY, String(Date.now() + SIX_MONTHS_MS));
    };
    const markCompleted = () => {
      if (completed) return;
      completed = true;
      suppressForSixMonths();
      actions?.setAttribute('hidden', '');
      trackPublicEvent(events.confirmationSent);
    };
    const loadForm = () => {
      if (loaded || !emailEnabled || !accountId) return;
      loaded = true;
      loadMailerLite(accountId, () => {
        if (status) status.textContent = 'The email form is unavailable. RSS by email still works.';
      });
      window.setTimeout(() => {
        if (status && !embed?.querySelector('.ml-block-form')) {
          status.textContent = 'The email form is taking longer than expected. RSS by email still works.';
        }
      }, 8000);
    };
    const markViewed = () => {
      if (viewed) return;
      viewed = true;
      storageSet('sessionStorage', SESSION_KEY, '1');
      trackPublicEvent(events.viewed);
    };

    const observer = embed && status ? new MutationObserver(() => {
      if (embed.querySelector('.ml-block-form')) {
        normalizeMailerLiteForm(embed);
        status.hidden = true;
      }
      const success = embed.querySelector<HTMLElement>('.row-success');
      if (success && getComputedStyle(success).display !== 'none') markCompleted();
    }) : undefined;
    observer?.observe(embed!, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] });

    const mlWindow = window as MailerLiteWindow;
    const previousSuccess = mlWindow.ml_webform_after_success;
    mlWindow.ml_webform_after_success = () => {
      previousSuccess?.();
      markCompleted();
    };

    signup.addEventListener('submit', (event) => {
      if (event.target instanceof HTMLFormElement && event.target.matches('.ml-block-form') && signup.dataset.emailStarted !== 'true') {
        signup.dataset.emailStarted = 'true';
        trackPublicEvent(events.attempted);
      }
    }, true);

    signup.querySelector<HTMLButtonElement>('[data-email-already]')?.addEventListener('click', () => {
      suppressForSixMonths();
      hide();
    });
    signup.querySelector<HTMLButtonElement>('[data-email-dismiss]')?.addEventListener('click', () => {
      storageSet('sessionStorage', SESSION_KEY, '1');
      if (placement === 'entry') trackPublicEvent(eventNames.entry.dismissed);
      hide();
    });

    let loadObserver: IntersectionObserver | undefined;
    let viewObserver: IntersectionObserver | undefined;
    signup.hidden = false;
    if ('IntersectionObserver' in window) {
      loadObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          loadForm();
          loadObserver?.disconnect();
        }
      }, { rootMargin: '500px 0px' });
      viewObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.3)) {
          markViewed();
          viewObserver?.disconnect();
        }
      }, { threshold: 0.3 });
      loadObserver.observe(signup);
      viewObserver.observe(signup);

      const checkPosition = () => {
        const bounds = signup.getBoundingClientRect();
        if (bounds.top < window.innerHeight + 500 && bounds.bottom > -500) loadForm();
        const visiblePixels = Math.max(0, Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, 0));
        if (bounds.height > 0 && visiblePixels / bounds.height >= 0.3) markViewed();
        if (loaded && viewed) stopPositionChecks();
      };
      stopPositionChecks = () => {
        window.removeEventListener('scroll', checkPosition);
        window.removeEventListener('resize', checkPosition);
      };
      window.addEventListener('scroll', checkPosition, { passive: true });
      window.addEventListener('resize', checkPosition, { passive: true });
      checkPosition();
    } else {
      loadForm();
      markViewed();
    }
  });
</script>

<style>
  .subscribe {
    margin: 2.3rem 0 0;
    padding: 1.1rem 0;
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
  }
  .inner { max-width: 46rem; margin: 0 auto; }
  .subscribe--home { margin-top: .8rem; }
  .subscribe--home .inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(18rem, 1.1fr); gap: 1.4rem; align-items: center; }
  .eyebrow {
    margin: 0 0 .25rem;
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: .62rem;
    font-weight: 600;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .title {
    margin: 0 0 .25rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -.01em;
  }
  .blurb {
    margin: 0;
    color: var(--c-text-soft);
    font-family: var(--font-reading);
    font-size: .76rem;
    line-height: 1.5;
  }
  .provider-frame { min-height: 2.45rem; }
  .form-status { margin: .7rem 0 0; color: var(--c-muted); font-size: .72rem; }
  .terms, .alternatives {
    color: var(--c-muted);
    font-family: var(--font-ui);
    font-size: .65rem;
    line-height: 1.45;
  }
  .terms { margin: .45rem 0 0; }
  .alternatives { display: flex; flex-wrap: wrap; gap: .25rem .7rem; margin-top: .25rem; }
  .alternatives[hidden] { display: none; }
  .terms a, .alternatives a, .alternatives button { color: var(--c-text-soft); }
  .alternatives button {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .terms a:hover, .alternatives a:hover, .alternatives button:hover { color: var(--c-accent); }

  /* MailerLite supplies behavior; these overrides keep its managed form native to the site. */
  .subscribe :global(.ml-form-embedContent) { display: none !important; }
  .subscribe :global(.ml-form-embedContainer),
  .subscribe :global(.ml-form-align-center),
  .subscribe :global(.ml-form-embedWrapper) {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    background: transparent !important;
  }
  .subscribe :global(.ml-form-embedBody),
  .subscribe :global(.ml-form-successBody) { padding: 0 !important; }
  .subscribe :global(.ml-form-formContent) { margin: 0 !important; }
  .subscribe :global(.ml-block-form) { display: flex !important; gap: .5rem; align-items: stretch; }
  .subscribe :global(.ml-form-fieldRow) { flex: 1 1 13rem; margin: 0 !important; }
  .subscribe :global(.ml-field-group) { margin: 0 !important; }
  .subscribe :global(input.form-control) {
    min-height: 2.45rem !important;
    padding: .55rem .68rem !important;
    border: 1px solid var(--c-rule) !important;
    border-radius: var(--radius) !important;
    background: var(--c-bg) !important;
    color: var(--c-text) !important;
    font-family: var(--font-ui) !important;
    font-size: .8rem !important;
  }
  .subscribe :global(input.form-control:focus) {
    border-color: var(--c-accent) !important;
    outline: 2px solid var(--c-accent) !important;
    outline-offset: 1px;
  }
  .subscribe :global(.ml-form-embedSubmit) { flex: 0 0 auto; margin: 0 !important; }
  .subscribe :global(.ml-form-embedSubmit button.primary) {
    width: auto !important;
    min-height: 2.45rem !important;
    padding: .55rem .78rem !important;
    border: 1px solid var(--c-accent-fill) !important;
    border-radius: var(--radius) !important;
    background: var(--c-accent-fill) !important;
    color: var(--c-on-accent) !important;
    font-family: var(--font-ui) !important;
    font-size: .76rem !important;
    font-weight: 650 !important;
  }
  .subscribe :global(.ml-form-embedSubmit button.primary:hover) { background: var(--c-link-hover) !important; }
  .subscribe :global(.ml-form-successContent) { margin: 0 !important; }
  .subscribe :global(.ml-form-successContent h4) {
    margin: 0 0 .2rem !important;
    color: var(--c-text) !important;
    font-family: var(--font-display) !important;
    font-size: 1rem !important;
    font-weight: 650 !important;
  }
  .subscribe :global(.ml-form-successContent p) {
    margin: 0 !important;
    color: var(--c-text-soft) !important;
    font-family: var(--font-ui) !important;
    font-size: .72rem !important;
    line-height: 1.45 !important;
  }

  @media (max-width: 680px) {
    .subscribe--home .inner { grid-template-columns: 1fr; gap: .75rem; }
  }
  @media (max-width: 420px) {
    .subscribe :global(.ml-block-form) { flex-direction: column; }
    .subscribe :global(.ml-form-fieldRow) { flex-basis: auto; }
    .subscribe :global(.ml-form-embedSubmit button.primary) { width: 100% !important; }
  }
</style>
