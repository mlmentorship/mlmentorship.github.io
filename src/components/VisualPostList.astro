---
import type { LibraryEntry } from '../utils/library';
import { getImplementedVisualAudit } from '../utils/visualAudits';

interface Props {
  posts: Array<Pick<LibraryEntry, 'slug' | 'title' | 'href' | 'description'> & {
    label?: string;
    note?: string;
    objective?: string;
    visualId?: string;
  }>;
  eager?: boolean;
  homeEvents?: boolean;
}

const { posts, eager = false, homeEvents = false } = Astro.props;
const previews = posts.map((post) => {
  const audit = getImplementedVisualAudit(post.slug);
  return {
    ...post,
    label: post.label ?? (post.href.startsWith('/questions/') ? 'Interview question' : post.href.startsWith('/guides/') ? 'Guide' : 'Concept'),
    objective: post.objective ?? audit?.learningObjective ?? post.description,
    visualId: post.visualId ?? audit?.visualIds[0],
  };
});
---

<div class="featured-post-list">
  {previews.map((post) => (
    <article class:list={['featured-post', { 'featured-post--text': !post.visualId }]} data-post-slug={post.slug}>
      <div class="featured-post-copy">
        <p class="featured-post-label">{post.label}</p>
        <h3><a href={post.href}>{post.title}</a></h3>
        {(post.note || post.objective) && <p>{post.note} {post.objective}</p>}
        <div class="post-links">
          <a href={post.href} data-home-event={homeEvents ? 'homepage_start_clicked' : undefined}>Read the post <span aria-hidden="true">→</span></a>
          {post.visualId && <a href={`/review/#${post.slug}`}>Visual mode <span aria-hidden="true">→</span></a>}
        </div>
      </div>
      {post.visualId && (
        <div class="landing-visual featured-post-visual" data-landing-visual data-landing-visual-load={eager ? 'eager' : undefined} data-landing-visual-href={post.href} data-landing-visual-id={post.visualId} role="group" tabindex="0" aria-label={`${post.title} visual preview`} aria-busy="true">
          <p class="landing-visual-placeholder">Loading visual...</p>
          <noscript><a href={post.href}>Read {post.title}</a></noscript>
        </div>
      )}
    </article>
  ))}
</div>

<script>
  import { initializeVisualPreviews } from '../utils/visualReviewClient';
  initializeVisualPreviews();
</script>

<style>
  .featured-post-list { border-top: 1px solid var(--c-rule); }
  .featured-post { display: grid; grid-template-columns: minmax(13rem, .7fr) minmax(0, 1.3fr); gap: 2rem; min-height: 17rem; align-items: center; padding: 1.2rem 0; border-bottom: 1px solid var(--c-rule); }
  .featured-post--text { grid-template-columns: 1fr; min-height: 0; }
  .featured-post-copy { min-width: 0; max-width: 24rem; }
  .featured-post-label { margin: 0; color: var(--c-accent); font-family: var(--font-mono); font-size: .62rem; font-weight: 700; text-transform: uppercase; }
  .featured-post-copy h3 { margin: .35rem 0 .5rem; font-size: 1.45rem; line-height: 1.2; }
  .featured-post-copy h3 a { color: inherit; text-decoration: none; }
  .featured-post-copy h3 a:hover { color: var(--c-accent); }
  .featured-post-copy > p:not(.featured-post-label) { margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: .8rem; line-height: 1.5; }
  .post-links { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; margin-top: .8rem; }
  .post-links a { display: inline-flex; align-items: center; gap: .45rem; color: var(--c-text-soft); font-size: .72rem; font-weight: 650; text-decoration: none; }
  .post-links a:hover { color: var(--c-accent); }
  .landing-visual { min-width: 0; height: 15rem; overflow: auto; overscroll-behavior: contain; }
  .landing-visual[aria-busy='true'] { opacity: .78; }
  .landing-visual :global(.learning-figure) { width: 100% !important; min-height: 100%; max-width: none !important; margin: 0 !important; overflow: visible; }
  .landing-visual :global(.learning-figure > p),
  .landing-visual :global(.visual-kicker),
  .landing-visual :global(.visual-title),
  .landing-visual :global(.diagram-source),
  .landing-visual :global(figcaption) { display: none !important; }
  .landing-visual :global(.learning-figure > .visual-panel),
  .landing-visual :global(.learning-figure > .visual-grid--two),
  .landing-visual :global(.learning-figure > .visual-scroll) { height: auto; min-height: 0; max-height: none; overflow: visible; }
  .landing-visual :global(.learning-figure > .visual-panel) { display: grid; align-content: center; }
  .landing-visual :global(.learning-figure > .visual-grid--two) { align-items: center; }
  .landing-visual :global(svg) { width: 100%; height: auto; min-width: 0; max-width: 100%; max-height: 10rem; object-fit: contain; }
  .landing-visual-placeholder { min-height: 15rem; display: grid; place-items: center; margin: 0; border: 1px solid var(--c-rule); border-radius: var(--radius); color: var(--c-muted); font-family: var(--font-ui); font-size: .72rem; }
  .landing-visual :global(.landing-visual-error) { margin: 0; color: var(--c-muted); font-size: .72rem; }
  .landing-visual :global(.landing-visual-error + a) { display: inline-block; margin-top: .35rem; color: var(--c-accent); font-size: .72rem; }
  @media (max-width: 720px) {
    .featured-post { grid-template-columns: 1fr; gap: 1rem; }
    .featured-post-copy { max-width: none; }
    .featured-post-copy h3 { font-size: 1.25rem; }
    .landing-visual { height: 14rem; }
    .landing-visual :global(svg) { max-height: 9rem; }
    .landing-visual-placeholder { min-height: 14rem; }
  }
</style>
