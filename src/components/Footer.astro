---
import { SITE, HSAGHIR_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore="all">
  <div class="container inner">
    <p class="colophon"><a href="/">{SITE.title}</a> is a free ML interview field guide with a private local workbook.</p>
    <nav aria-label="Footer">
      <a href="/">Contents</a>
      <a href="/about/">About</a>
      <a href="/#email-notes">Email notes</a>
      <a href="/feedback/">Corrections</a>
      <a href="/privacy/">Privacy</a>
      <a href="/rss.xml">RSS</a>
      <a href={HSAGHIR_URL} rel="noopener">Personal site <span aria-hidden="true">↗</span></a>
    </nav>
    <p class="copyright">© {year} {SITE.author}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding: 1rem 0 1.2rem;
    border-top: 1px solid var(--c-rule);
  }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.7rem 2rem; align-items: baseline; }
  .colophon,
  .copyright { margin: 0; color: var(--c-muted); font-family: var(--font-ui); font-size: .72rem; }
  .colophon a { color: var(--c-text); font-weight: 650; text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.45rem 1rem; }
  nav a { color: var(--c-text-soft); font-family: var(--font-ui); font-size: .7rem; font-weight: 500; text-decoration: none; }
  nav a:hover { color: var(--c-accent); text-decoration: underline; }
  .copyright { grid-column: 1 / -1; font-size: 0.7rem; }

  @media (max-width: 680px) {
    .inner { grid-template-columns: 1fr; }
    nav { justify-content: flex-start; }
  }
</style>