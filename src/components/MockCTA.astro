---
// MockCTA.astro: Conversion CTA shown at the bottom of interview Q&A pages.
---
<aside class="mock-cta" data-pagefind-ignore="all">
  <div class="mock-cta-inner">
    <p class="mock-cta-eyebrow">Want real signal?</p>
    <h2 class="mock-cta-headline">Practice with a senior interviewer.</h2>
    <p class="mock-cta-body">
      Mock interview at the level you're targeting (L4, L5, or L6), with structured feedback and written notes. Limited slots, $300 USD.
    </p>
    <p class="mock-cta-actions">
      <a class="mock-cta-button" href="/interview/">Book a mock <span aria-hidden="true">→</span></a>
    </p>
  </div>
</aside>

<style>
  .mock-cta {
    margin-top: 3rem;
    padding: 1.8rem 1.6rem 2rem;
    border: 1px solid var(--c-accent);
    background: var(--c-accent-soft);
    border-radius: var(--radius-lg);
  }
  .mock-cta-inner { max-width: 38rem; }
  .mock-cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-accent);
    margin: 0 0 0.6rem;
    font-weight: 600;
  }
  .mock-cta-headline {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 0.6rem;
    color: var(--c-text);
  }
  .mock-cta-body {
    color: var(--c-text-soft);
    font-size: 0.95rem;
    margin: 0 0 1rem;
  }
  .mock-cta-actions { margin: 0; }
  .mock-cta-button {
    display: inline-block;
    background: var(--c-accent-fill);
    color: var(--c-on-accent);
    text-decoration: none;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.92rem;
    transition: background var(--transition);
  }
  .mock-cta-button:hover { background: var(--c-link-hover); }

  :root[data-theme='dark'] .mock-cta {
    background: color-mix(in srgb, var(--c-accent) 12%, transparent);
  }
</style>
