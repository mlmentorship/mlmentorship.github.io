---
// TableOfContents.astro, renders from Astro's generated `headings`
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 2 && (
  <aside class="toc" aria-label="Table of contents">
    <p class="toc-title">Contents</p>
    <ol>
      {items.map((h) => (
        <li class:list={[`depth-${h.depth}`]}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </aside>
)}

<style>
  .toc {
    font-family: var(--font-head);
    font-size: 0.85rem;
    border-left: 2px solid var(--c-rule);
    padding: .2rem 0 .2rem 1rem;
    margin: 1.5rem 0 2rem;
    color: var(--c-muted);
  }
  .toc-title {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    margin: 0 0 .5rem;
  }
  .toc ol { list-style: none; padding: 0; margin: 0; }
  .toc li { margin: .25rem 0; }
  .toc li.depth-3 { padding-left: 1rem; font-size: 0.82rem; }
  .toc a { color: var(--c-muted); border: none; display: block; padding: 1px 0; transition: color var(--transition); }
  .toc a:hover { color: var(--c-link); }
  .toc a.active { color: var(--c-accent); font-weight: 600; }
</style>

<script is:inline>
  // Scrollspy: highlight the TOC entry whose section is currently in view.
  (function () {
    const toc = document.querySelector('aside.toc');
    if (!toc) return;
    const links = Array.from(toc.querySelectorAll('a[href^="#"]'));
    if (!links.length) return;
    const map = new Map();
    const targets = [];
    links.forEach((a) => {
      const id = decodeURIComponent(a.getAttribute('href').slice(1));
      const el = document.getElementById(id);
      if (el) { map.set(el, a); targets.push(el); }
    });
    if (!targets.length) return;
    let current = null;
    const setActive = (el) => {
      const a = map.get(el);
      if (!a || a === current) return;
      if (current) current.classList.remove('active');
      a.classList.add('active');
      current = a;
    };
    const onScroll = () => {
      const offset = 120;
      let active = targets[0];
      for (const t of targets) {
        if (t.getBoundingClientRect().top - offset <= 0) active = t;
        else break;
      }
      setActive(active);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
