---
import type { PracticeModeDefinition } from '../data/prepCurriculum';

interface Props {
  title: string;
  slug: string;
  mode: PracticeModeDefinition;
}

const { title, slug, mode } = Astro.props;
const initialTimer = `${String(mode.minutes).padStart(2, '0')}:00`;
---

<section class="practice-launch" data-practice data-slug={slug} data-title={title} data-mode={mode.id} data-minutes={mode.minutes} data-pagefind-ignore="all">
  <div>
    <p class="practice-eyebrow">{mode.label} · active recall</p>
    <h2>Practice before you read</h2>
    <p>{mode.minutes} minutes. {mode.instruction}</p>
    <p class="practice-last" data-practice-last hidden></p>
  </div>
  <div class="practice-actions">
    <button class="practice-start" type="button" data-practice-start>Start {mode.label.toLowerCase()} practice</button>
    <div class="practice-links">
      <a class="workbook-return" href="/prep/#queue">Back to my workbook</a>
      <a href="/prep/#how-practice-works">How practice works</a>
    </div>
  </div>

  <dialog class="practice-dialog" data-practice-dialog aria-labelledby={`practice-title-${slug}`}>
    <div class="practice-dialog-inner">
      <header class="dialog-head">
        <div><p class="practice-eyebrow">{mode.label} · closed-book attempt</p><h2 id={`practice-title-${slug}`}>{title}</h2><p>{mode.instruction}</p></div>
        <button class="dialog-close" type="button" data-practice-close aria-label="Close practice mode">×</button>
      </header>

      <section data-practice-phase>
        <div class="timer-row"><p><strong data-practice-timer role="timer" aria-label="Practice time remaining">{initialTimer}</strong><span>recommended time</span></p><button class="secondary-button" type="button" data-practice-pause>Pause</button></div>
        <p class="sr-only" data-practice-timer-status role="status" aria-live="polite"></p>
        <label class="scratchpad-label" for={`scratchpad-${slug}`}>Private scratchpad</label>
        <textarea id={`scratchpad-${slug}`} data-practice-notes rows="10" placeholder="Outline or work through the answer. This text stays in memory and is never saved or sent."></textarea>
        <p class="local-note">Closing or reloading clears the scratchpad. Only score, weak rubric dimensions, attempt count, and retry date can be stored locally.</p>
        <button class="reveal-button" type="button" data-practice-reveal>Stop and score the attempt</button>
      </section>

      <section class="rubric-phase" data-rubric-phase hidden>
        <p class="rubric-intro" tabindex="-1">Mark every dimension that needs work before choosing the overall score.</p>
        <div class="rubric-grid">
          {mode.rubric.map((item) => (
            <label class="rubric-item"><input type="checkbox" data-dimension={item.id} data-coaching={item.coaching} /><span><strong>{item.label}</strong><small>{item.question}</small></span></label>
          ))}
        </div>
        <fieldset class="self-score">
          <legend>Overall evidence from this attempt</legend>
          <button type="button" data-practice-score="Weak">Weak · retry in 2 days</button>
          <button type="button" data-practice-score="Review">Review · retry in 1 week</button>
          <button type="button" data-practice-score="Confident">Confident · counts toward graduation</button>
        </fieldset>
        <p class="score-status" data-score-status aria-live="polite"></p>
        <section class="coaching" data-coaching-panel hidden><h3>Next corrective drill</h3><ul data-coaching-list></ul><p>Repair the behavior, then retry closed-book after spacing. Reading the answer immediately is diagnosis, not proof of improvement.</p></section>
        <div class="compare-actions"><button class="compare-button" type="button" data-practice-compare>Close and compare with the answer</button><a href="/prep/#queue">Open workbook</a></div>
      </section>
    </div>
  </dialog>
</section>

<script>
  import { loadPrepProgress, savePracticeProgress, type PracticeScore } from '../utils/prepProgress';
  import { setActivityComplete } from '../utils/activityProgress';
  import { trackPublicEvent } from '../utils/publicEvents';

  document.querySelectorAll<HTMLElement>('[data-practice]').forEach((root) => {
    const slug = root.dataset.slug ?? 'question';
    const title = root.dataset.title ?? 'Interview question';
    const mode = root.dataset.mode ?? 'practice';
    const totalSeconds = Number(root.dataset.minutes ?? 8) * 60;
    const dialog = root.querySelector<HTMLDialogElement>('[data-practice-dialog]');
    const practicePhase = root.querySelector<HTMLElement>('[data-practice-phase]');
    const rubricPhase = root.querySelector<HTMLElement>('[data-rubric-phase]');
    const timer = root.querySelector<HTMLElement>('[data-practice-timer]');
    const pause = root.querySelector<HTMLButtonElement>('[data-practice-pause]');
    const notes = root.querySelector<HTMLTextAreaElement>('[data-practice-notes]');
    const last = root.querySelector<HTMLElement>('[data-practice-last]');
    const scoreStatus = root.querySelector<HTMLElement>('[data-score-status]');
    const timerStatus = root.querySelector<HTMLElement>('[data-practice-timer-status]');
    const coachingPanel = root.querySelector<HTMLElement>('[data-coaching-panel]');
    const coachingList = root.querySelector<HTMLUListElement>('[data-coaching-list]');
    const scoreButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-practice-score]')];
    let remaining = totalSeconds;
    let interval: number | undefined;
    let paused = false;
    let deadline = 0;
    let scoreSubmitted = false;

    const updateTimer = () => {
      if (!timer) return;
      const minutes = Math.floor(remaining / 60).toString().padStart(2, '0');
      const seconds = (remaining % 60).toString().padStart(2, '0');
      timer.textContent = `${minutes}:${seconds}`;
    };
    const stopTimer = () => { if (interval !== undefined) window.clearInterval(interval); interval = undefined; };
    const refreshRemaining = () => {
      if (paused || deadline === 0) return;
      remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
      updateTimer();
      if (remaining === 0) {
        stopTimer();
        if (timerStatus) timerStatus.textContent = 'Practice time is up. Stop and score this attempt.';
      }
    };
    const startTimer = () => {
      stopTimer();
      deadline = Date.now() + remaining * 1000;
      interval = window.setInterval(refreshRemaining, 250);
    };
    const reset = () => {
      remaining = totalSeconds;
      paused = false;
      if (pause) pause.textContent = 'Pause';
      if (notes) notes.value = '';
      if (scoreStatus) scoreStatus.textContent = '';
      if (timerStatus) timerStatus.textContent = '';
      scoreSubmitted = false;
      scoreButtons.forEach((button) => { button.disabled = false; button.removeAttribute('aria-pressed'); });
      if (practicePhase) practicePhase.hidden = false;
      if (rubricPhase) rubricPhase.hidden = true;
      if (coachingPanel) coachingPanel.hidden = true;
      root.querySelectorAll<HTMLInputElement>('[data-dimension]').forEach((input) => { input.checked = false; });
      updateTimer();
    };
    const showLast = () => {
      if (!last) return;
      const saved = loadPrepProgress().find((record) => record.slug === slug);
      if (!saved) { last.hidden = true; return; }
      const gate = saved.successfulAttempts >= 2 && saved.weakDimensions.length === 0 ? ' · evidence gate met' : '';
      last.textContent = `Last score on this device: ${saved.score} · ${saved.attempts} attempt${saved.attempts === 1 ? '' : 's'}${gate}.`;
      last.hidden = false;
    };

    root.querySelector('[data-practice-start]')?.addEventListener('click', () => {
      if (!dialog) return;
      reset(); dialog.showModal(); notes?.focus(); startTimer(); trackPublicEvent('practice_started');
    });
    pause?.addEventListener('click', () => {
      refreshRemaining();
      paused = !paused;
      pause.textContent = paused ? 'Resume' : 'Pause';
      if (paused) stopTimer();
      else startTimer();
    });
    root.querySelector('[data-practice-reveal]')?.addEventListener('click', () => {
      stopTimer();
      if (practicePhase) practicePhase.hidden = true;
      if (rubricPhase) rubricPhase.hidden = false;
      root.querySelector<HTMLElement>('.rubric-intro')?.focus();
      trackPublicEvent('rubric_revealed');
    });
    root.querySelectorAll<HTMLButtonElement>('[data-practice-score]').forEach((button) => {
      button.addEventListener('click', () => {
        if (scoreSubmitted) return;
        const score = button.dataset.practiceScore as PracticeScore | undefined;
        if (!score) return;
        const checked = [...root.querySelectorAll<HTMLInputElement>('[data-dimension]:checked')];
        const weakDimensions = checked.map((input) => input.dataset.dimension).filter((value): value is string => Boolean(value));
        try {
          const record = savePracticeProgress({ slug, title, mode, score, weakDimensions });
          scoreSubmitted = true;
          scoreButtons.forEach((scoreButton) => { scoreButton.disabled = true; scoreButton.setAttribute('aria-pressed', scoreButton === button ? 'true' : 'false'); });
          if (score === 'Confident' && weakDimensions.length === 0) setActivityComplete(`entry:${slug}`);
          if (scoreStatus) scoreStatus.textContent = record.dueOn
            ? `Saved on this device. Retry due ${record.dueOn}. Evidence gate: ${record.successfulAttempts}/2 spaced successes.`
            : `Saved on this device. Evidence gate: ${record.successfulAttempts}/2 spaced successes; confirm in a mixed session.`;
        } catch {
          if (scoreStatus) scoreStatus.textContent = 'Score selected, but local progress could not be saved.';
        }
        if (coachingList) {
          const coaching = checked.map((input) => input.dataset.coaching).filter((value): value is string => Boolean(value));
          const messages = coaching.length > 0 ? coaching : [score === 'Confident' ? 'Use a different prompt or follow-up next time; do not repeat the same script.' : 'Choose the weakest observable behavior and define one corrective drill before retrying.'];
          coachingList.replaceChildren(...messages.map((message) => { const item = document.createElement('li'); item.textContent = message; return item; }));
        }
        if (coachingPanel) coachingPanel.hidden = false;
        showLast();
        trackPublicEvent('self_score_selected');
      });
    });

    const close = () => { stopTimer(); reset(); dialog?.close(); };
    root.querySelector('[data-practice-close]')?.addEventListener('click', close);
    root.querySelector('[data-practice-compare]')?.addEventListener('click', () => { close(); document.querySelector('#answer')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    dialog?.addEventListener('cancel', () => { stopTimer(); reset(); });
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    document.addEventListener('visibilitychange', refreshRemaining);
    showLast(); updateTimer();
    if (new URLSearchParams(window.location.search).get('practice') === '1') {
      const startButton = root.querySelector<HTMLButtonElement>('[data-practice-start]');
      window.setTimeout(() => startButton?.click(), 0);
      const url = new URL(window.location.href);
      url.searchParams.delete('practice');
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }
  });
</script>

<style>
  .practice-launch { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; max-width: var(--measure); margin: 0 auto 1.6rem; padding: .8rem 0; border-top: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule); }
  .practice-launch h2 { margin: 0 0 .2rem; font-size: 1rem; }
  .practice-launch p { margin: 0; color: var(--c-text-soft); font-size: .88rem; }
  .practice-eyebrow { margin: 0 0 .3rem !important; font-family: var(--font-mono); font-size: .66rem !important; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--c-accent) !important; }
  .practice-last { margin-top: .45rem !important; color: var(--c-muted) !important; }
  .practice-actions { display: flex; flex-direction: column; align-items: flex-end; gap: .45rem; flex: 0 0 auto; }
  .practice-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem .7rem; }
  .practice-actions a { font-size: .76rem; }
  .practice-actions .workbook-return { color: var(--c-accent); font-weight: 700; }
  .practice-start, .reveal-button, .compare-button { padding: .58rem .75rem; border: 0; border-radius: var(--radius); background: var(--c-accent-fill); color: var(--c-on-accent); font: inherit; font-size: .84rem; font-weight: 700; cursor: pointer; }
  .practice-dialog { width: min(46rem, 94vw); max-height: 92vh; padding: 0; border: 1px solid var(--c-rule); border-radius: var(--radius-lg); background: var(--c-surface); color: var(--c-text); box-shadow: var(--shadow-lg); }
  .practice-dialog::backdrop { background: rgba(15, 23, 42, .62); backdrop-filter: blur(3px); }
  .practice-dialog-inner { padding: clamp(1.1rem, 4vw, 2rem); overflow-y: auto; max-height: 92vh; }
  .dialog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 1px solid var(--c-rule); }
  .dialog-head h2 { margin: 0; font-size: clamp(1.2rem, 3vw, 1.65rem); }
  .dialog-head p:last-child { margin: .35rem 0 0; color: var(--c-text-soft); font-size: .84rem; }
  .dialog-close { flex: 0 0 auto; width: 2rem; height: 2rem; border: 1px solid var(--c-rule); border-radius: 50%; background: var(--c-bg); color: var(--c-text); font-size: 1.2rem; cursor: pointer; }
  .timer-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .timer-row p { display: flex; align-items: baseline; gap: .55rem; margin: 0; }
  .timer-row strong { font-family: var(--font-mono); font-size: 1.65rem; }
  .timer-row span { color: var(--c-muted); font-size: .76rem; }
  .secondary-button { padding: .5rem .75rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; cursor: pointer; }
  .scratchpad-label { display: block; margin-bottom: .35rem; font-weight: 700; }
  textarea { width: 100%; padding: .8rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; line-height: 1.5; resize: vertical; }
  .local-note { margin: .4rem 0 1rem !important; color: var(--c-muted) !important; font-size: .75rem !important; }
  .rubric-phase[hidden], .coaching[hidden] { display: none; }
  .rubric-intro { color: var(--c-text-soft); }
  .rubric-grid { display: grid; gap: .55rem; margin: 1rem 0; }
  .rubric-item { display: flex; gap: .7rem; padding: .75rem; border: 1px solid var(--c-rule); border-radius: var(--radius); cursor: pointer; }
  .rubric-item input { margin-top: .25rem; accent-color: var(--c-accent-fill); }
  .rubric-item strong, .rubric-item small { display: block; }
  .rubric-item small { margin-top: .15rem; color: var(--c-text-soft); font-size: .8rem; line-height: 1.4; }
  .self-score { margin: 1.2rem 0; padding: 1rem; border: 1px solid var(--c-rule); border-radius: var(--radius); }
  .self-score legend { padding: 0 .4rem; font-weight: 700; }
  .self-score button { display: block; width: 100%; margin: .45rem 0 0; padding: .65rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); text-align: left; cursor: pointer; }
  .self-score button:hover { border-color: var(--c-accent); background: var(--c-accent-soft); }
  .score-status { min-height: 1.5rem; color: var(--c-muted); }
  .coaching { padding: .9rem; border-left: 3px solid var(--c-accent); background: var(--c-bg-tint); }
  .coaching h3 { margin: 0 0 .5rem; font-size: 1rem; }
  .coaching li, .coaching p { font-size: .82rem; }
  .compare-actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
  @media (max-width: 680px) {
    .practice-launch { align-items: stretch; flex-direction: column; }
    .practice-actions { align-items: stretch; }
    .practice-actions a { text-align: center; }
    .practice-links { justify-content: center; }
    .practice-dialog { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; border: 0; border-radius: 0; }
    .practice-dialog-inner { max-height: 100dvh; padding: 1rem; }
    .dialog-head { position: sticky; top: -1rem; z-index: 2; padding-top: 1rem; background: var(--c-surface); }
    textarea { height: 7rem; min-height: 7rem; }
    .compare-actions { align-items: stretch; flex-direction: column; }
  }
</style>
