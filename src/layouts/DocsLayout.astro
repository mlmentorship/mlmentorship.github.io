---
import type { MarkdownHeading } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import MockCTA from '../components/MockCTA.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Subscribe from '../components/Subscribe.astro';
import PracticeMode from '../components/PracticeMode.astro';
import { formatDate } from '../utils/date';
import readingTime from 'reading-time';
import { SITE } from '../consts';
import { getSubcategoryMap, type Category } from '../utils/subcategories';
import { getPracticeMode } from '../data/prepCurriculum';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  rawContent: string;
}
const { post, headings, rawContent } = Astro.props;
const { title, description, date, updated } = post.data;
const stats = readingTime(rawContent);
const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '');
const category = post.data.category as Category;

const CATEGORY_META: Record<Category, { singular: string; plural: string }> = {
  questions: { singular: 'Question', plural: 'Questions' },
  guides: { singular: 'Guide', plural: 'Guides' },
  concepts: { singular: 'Concept', plural: 'Concepts' },
};
const categoryMeta = CATEGORY_META[category];
const subcategoryConfig = getSubcategoryMap(category);
const currentSubcategory = subcategoryConfig?.map[slug];
const practiceMode = getPracticeMode(slug, currentSubcategory);

const categoryPosts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category))
  .map((entry) => ({
    slug: entry.slug.replace(/^\d{4}-\d{2}-\d{2}-/, ''),
    title: entry.data.title,
    date: entry.data.date,
    subcategory: subcategoryConfig?.map[entry.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')] ?? 'Other',
  }))
  .sort((a, b) => {
    if (category === 'guides') return b.date.getTime() - a.date.getTime();
    if (subcategoryConfig) {
      const aRank = subcategoryConfig.order.indexOf(a.subcategory);
      const bRank = subcategoryConfig.order.indexOf(b.subcategory);
      const normalizedARank = aRank === -1 ? subcategoryConfig.order.length : aRank;
      const normalizedBRank = bRank === -1 ? subcategoryConfig.order.length : bRank;
      if (normalizedARank !== normalizedBRank) return normalizedARank - normalizedBRank;
    }
    return a.title.localeCompare(b.title);
  });

const currentIndex = categoryPosts.findIndex((entry) => entry.slug === slug);
const previousPost = currentIndex > 0 ? categoryPosts[currentIndex - 1] : undefined;
const nextPost = currentIndex >= 0 && currentIndex < categoryPosts.length - 1
  ? categoryPosts[currentIndex + 1]
  : undefined;
---
<BaseLayout
  title={title}
  description={description}
  image={`/og/${post.slug}.png`}
  article
  publishedTime={date}
  modifiedTime={updated}
>
  <div class="docs-layout">
    <nav class="docs-sidebar" aria-label="Section navigation" data-pagefind-ignore="all">
      <SectionNav category={post.data.category} currentSlug={slug} />
    </nav>

    <article class="docs-article" itemscope itemtype="https://schema.org/BlogPosting">
      <header class="docs-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore="all">
          <a href="/start-here/">Start here</a>
          <span aria-hidden="true">/</span>
          <a href={`/${category}/`}>{categoryMeta.plural}</a>
          {currentSubcategory && (
            <>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{currentSubcategory}</span>
            </>
          )}
        </nav>
        <h1 itemprop="headline">{title}</h1>
        {description && <p class="lede" itemprop="description">{description}</p>}
        <div class="docs-meta">
          <span>Reviewed <time itemprop="dateModified" datetime={(updated ?? date).toISOString()}>{formatDate(updated ?? date)}</time></span>
          <span class="dot">·</span>
          <span>{Math.max(1, Math.round(stats.minutes))} min read</span>
          {currentIndex >= 0 && (
            <>
              <span class="dot">·</span>
              <span>{currentIndex + 1} of {categoryPosts.length}</span>
            </>
          )}
        </div>
      </header>

      {SITE.features.prepTools && category === 'questions' && <PracticeMode title={title} slug={slug} mode={practiceMode} />}

      <div id="answer" class="prose docs-body" itemprop="articleBody">
        <slot />
      </div>

      <nav class="journey-nav" aria-label={`Continue through ${categoryMeta.plural}`} data-pagefind-ignore="all">
        <div class="journey-context">
          <span>{currentSubcategory ?? categoryMeta.plural}</span>
          <a href={`/${category}/`}>View all {categoryPosts.length} {categoryMeta.plural.toLowerCase()}</a>
        </div>
        <div class="journey-links">
          {previousPost ? (
            <a class="journey-link journey-link--previous" href={`/${category}/${previousPost.slug}/`}>
              <span>← Previous {categoryMeta.singular.toLowerCase()}</span>
              <strong>{previousPost.title}</strong>
            </a>
          ) : <span></span>}
          {nextPost ? (
            <a class="journey-link journey-link--next" href={`/${category}/${nextPost.slug}/`}>
              <span>Next {categoryMeta.singular.toLowerCase()} →</span>
              <strong>{nextPost.title}</strong>
            </a>
          ) : <span></span>}
        </div>
      </nav>

      {SITE.features.bookingCTA && category === 'questions' && <MockCTA />}
      <Subscribe variant="inline" heading="Get new posts" />
      <AuthorCard />
    </article>

    <aside class="docs-toc" aria-label="On this page" data-pagefind-ignore="all">
      <TableOfContents headings={headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr) 14rem;
    gap: 2.5rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
    /* No overflow / max-height: rely on the single page scroll. */
  }

  .docs-article { min-width: 0; }
  .docs-head { margin-bottom: 1.8rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--c-rule); }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
    margin: 0 0 1rem;
  }
  .breadcrumbs a { color: var(--c-accent); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--c-link-hover); text-decoration: underline; }
  .docs-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }
  .lede {
    font-size: 1.05rem;
    color: var(--c-text-soft);
    line-height: 1.55;
    margin: 0 0 1rem;
  }
  .docs-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--c-muted);
  }
  .dot { margin: 0 0.4rem; opacity: 0.5; }

  .docs-body { font-size: 1rem; line-height: 1.65; }
  #answer { scroll-margin-top: 5.5rem; }
  .docs-body :global(h2) { margin-top: 2.2rem; }
  .docs-body :global(h3) { margin-top: 1.6rem; }

  .journey-nav {
    margin: 3rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--c-rule);
  }
  .journey-context {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--c-muted);
  }
  .journey-context > span {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .journey-context a { color: var(--c-text-soft); }
  .journey-context a:hover { color: var(--c-accent); }
  .journey-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .journey-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    color: var(--c-text);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  .journey-link:hover { border-color: var(--c-accent); background: var(--c-bg-tint); }
  .journey-link > span {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-muted);
  }
  .journey-link strong {
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .journey-link--next { text-align: right; }

  .docs-toc {
    position: sticky;
    top: 5rem;
    align-self: start;
    font-size: 0.85rem;
  }
  .docs-toc :global(.toc) {
    border-left: 2px solid var(--c-rule);
    padding-left: 0.8rem;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .docs-layout {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 2rem;
    }
    .docs-toc { display: none; }
  }
  @media (max-width: 800px) {
    .docs-layout {
      grid-template-columns: 1fr;
      padding: 1rem var(--gutter) 3rem;
    }
    .docs-sidebar { display: none; }
    .journey-links { grid-template-columns: 1fr; }
    .journey-link--next { text-align: left; }
  }
</style>
