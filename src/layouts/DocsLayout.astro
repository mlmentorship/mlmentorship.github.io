---
import type { MarkdownHeading } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PracticeMode from '../components/PracticeMode.astro';
import CompletionToggle from '../components/CompletionToggle.astro';
import BookReaderNav from '../components/BookReaderNav.astro';
import VisualReviewCard from '../components/VisualReviewCard.astro';
import Subscribe from '../components/Subscribe.astro';
import { formatDate } from '../utils/date';
import readingTime from 'reading-time';
import { SITE } from '../consts';
import { getSubcategoryMap, type Category } from '../utils/subcategories';
import { getPracticeMode } from '../data/prepCurriculum';
import { findLibraryLocation, getLibraryShelf } from '../data/library';
import { entriesForChapter, getLibraryEntries } from '../utils/library';
import { getImplementedVisualAudit } from '../utils/visualAudits';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  rawContent: string;
}
const { post, headings, rawContent } = Astro.props;
const { title, description, date, updated, reviewed, aliases, difficulty, priority } = post.data;
const stats = readingTime(rawContent);
const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '');
const category = post.data.category as Category;
const visualAudit = getImplementedVisualAudit(slug);

const CATEGORY_META: Record<Category, { singular: string; plural: string }> = {
  questions: { singular: 'Question', plural: 'Questions' },
  guides: { singular: 'Guide', plural: 'Guides' },
  concepts: { singular: 'Concept', plural: 'Concepts' },
};
const categoryMeta = CATEGORY_META[category];
const subcategoryConfig = getSubcategoryMap(category);
const currentSubcategory = subcategoryConfig?.map[slug];
const practiceMode = getPracticeMode(slug, currentSubcategory);
const libraryLocation = findLibraryLocation(slug);
const libraryShelf = libraryLocation ? getLibraryShelf(libraryLocation.volume.id) : undefined;
const chapterIndex = libraryLocation ? libraryLocation.volume.chapters.findIndex((chapter) => chapter.id === libraryLocation.chapter.id) : -1;
const displayDate = reviewed ?? updated ?? date;
const displayDateLabel = reviewed ? 'Reviewed' : updated ? 'Updated' : 'Published';
const scopePriority = priority ?? libraryLocation?.chapter.priority;
const scopeDifficulty = difficulty ?? libraryLocation?.chapter.difficulty;
const correctionIssueUrl = `https://github.com/mlmentorship/mlmentorship.github.io/issues/new?title=${encodeURIComponent(`[Correction] ${title}`)}&body=${encodeURIComponent(`Page: ${SITE.url}/${category}/${slug}/\nTitle: ${title}\n\nWhat is incorrect or unclear?\n\n\nProposed correction\n\n\nSupporting evidence\n\n\nPlease do not include confidential, proprietary, personal, or secret information.`)}`;
const correctionEmailUrl = `mailto:${SITE.email}?subject=${encodeURIComponent(`Correction: ${title}`)}&body=${encodeURIComponent(`Page: ${SITE.url}/${category}/${slug}/\n\nWhat is incorrect or unclear?\n\n`)}`;

const categoryPosts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category))
  .map((entry) => ({
    slug: entry.slug.replace(/^\d{4}-\d{2}-\d{2}-/, ''),
    title: entry.data.title,
    date: entry.data.date,
    subcategory: subcategoryConfig?.map[entry.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')] ?? 'Other',
  }))
  .sort((a, b) => {
    if (category === 'guides') return b.date.getTime() - a.date.getTime();
    if (subcategoryConfig) {
      const aRank = subcategoryConfig.order.indexOf(a.subcategory);
      const bRank = subcategoryConfig.order.indexOf(b.subcategory);
      const normalizedARank = aRank === -1 ? subcategoryConfig.order.length : aRank;
      const normalizedBRank = bRank === -1 ? subcategoryConfig.order.length : bRank;
      if (normalizedARank !== normalizedBRank) return normalizedARank - normalizedBRank;
    }
    return a.title.localeCompare(b.title);
  });

const libraryEntries = await getLibraryEntries();
const orderedChapterEntries = libraryLocation ? entriesForChapter(libraryEntries, libraryLocation.chapter) : [];
const bookChapters = libraryLocation ? libraryLocation.volume.chapters.map((chapter) => ({
  chapter,
  entries: entriesForChapter(libraryEntries, chapter),
})) : [];
const sectionPosts = orderedChapterEntries.length > 0
  ? orderedChapterEntries.map((entry) => ({ slug: entry.slug, title: entry.title, href: entry.href }))
  : currentSubcategory
    ? categoryPosts.filter((entry) => entry.subcategory === currentSubcategory).map((entry) => ({ ...entry, href: `/${category}/${entry.slug}/` }))
    : categoryPosts.map((entry) => ({ ...entry, href: `/${category}/${entry.slug}/` }));
const sectionIndex = sectionPosts.findIndex((entry) => entry.slug === slug);
const bookEntries = bookChapters.flatMap(({ entries }) => entries.map((entry) => ({ slug: entry.slug, title: entry.title, href: entry.href })));
const navigationPosts = bookEntries.length > 0 ? bookEntries : sectionPosts;
const navigationIndex = navigationPosts.findIndex((entry) => entry.slug === slug);
const previousPost = navigationIndex > 0 ? navigationPosts[navigationIndex - 1] : undefined;
const nextPost = navigationIndex >= 0 && navigationIndex < navigationPosts.length - 1
  ? navigationPosts[navigationIndex + 1]
  : undefined;
const pageHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const chapterTitle = libraryLocation?.chapter.title ?? currentSubcategory ?? categoryMeta.plural;
const quickReviewLabel: Record<Category, string> = {
  concepts: 'Visual quick review',
  questions: '30-second answer map',
  guides: 'Decision map',
};
const fullContentLabel: Record<Category, string> = {
  concepts: 'Full explanation',
  questions: 'Full interview answer',
  guides: 'Full guide',
};
---
<BaseLayout
  title={title}
  description={description}
  image={`/og/${post.slug}.png`}
  article
  publishedTime={date}
  modifiedTime={updated ?? reviewed}
>
  {libraryLocation && <BookReaderNav
    volume={libraryLocation.volume}
    currentChapter={libraryLocation.chapter}
    currentSlug={slug}
    chapters={bookChapters}
    previousEntry={previousPost ? { href: previousPost.href, title: previousPost.title } : undefined}
    nextEntry={nextPost ? { href: nextPost.href, title: nextPost.title } : undefined}
    mobileOnly
  />}
  <div class="docs-shell">
    <div class="docs-layout">
      <article class="docs-article" itemscope itemtype="https://schema.org/BlogPosting">
      <header class="docs-head">
        <nav class="breadcrumbs" aria-label="Chapter context" data-pagefind-ignore="all">
          {libraryLocation ? (
            <>
              <a href={`/library/${libraryLocation.volume.id}/${libraryLocation.chapter.id}/`}>{chapterTitle}</a>
              <span aria-hidden="true">·</span>
              <span>Chapter {chapterIndex + 1}</span>
              {sectionIndex >= 0 && <><span aria-hidden="true">·</span><span>{sectionIndex + 1} of {sectionPosts.length}</span></>}
            </>
          ) : (
            <a href={`/${category}/`}>{categoryMeta.plural}</a>
          )}
        </nav>
        <h1 itemprop="headline" data-pagefind-weight="10">{title}</h1>
        {description && <p class="lede" itemprop="description">{description}</p>}
        <div class="search-meta sr-only" aria-hidden="true">
          <span data-pagefind-filter="Type">{categoryMeta.singular}</span>
          {libraryShelf && <span data-pagefind-filter="Shelf">{libraryShelf.title}</span>}
          {libraryLocation && <span data-pagefind-filter="Book">{libraryLocation.volume.shortTitle}</span>}
          {aliases.length > 0 && <span data-pagefind-weight="8">{aliases.join(' ')}</span>}
        </div>
        <div class="docs-meta">
          <span>{displayDateLabel} <time datetime={displayDate.toISOString()}>{formatDate(displayDate)}</time></span>
          <span class="dot">·</span>
          <span>{Math.max(1, Math.round(stats.minutes))} min read</span>
          {scopePriority && <><span class="dot">·</span><span>{scopePriority}</span></>}
          {scopeDifficulty && <><span class="dot">·</span><span>{scopeDifficulty}</span></>}
        </div>
      </header>

      {SITE.features.prepTools && category === 'questions' && <PracticeMode title={title} slug={slug} mode={practiceMode} />}

      {visualAudit && (
        <div data-article-quick-review data-visual-id={visualAudit.visualIds[0]} data-pagefind-ignore="all">
          <VisualReviewCard
            id="quick-review"
            eyebrow={quickReviewLabel[category]}
            summary={visualAudit.learningObjective || description}
            loading
          >
            <span slot="status">Visual first · depth when needed</span>
          </VisualReviewCard>
          <noscript><style is:inline>[data-article-quick-review] { display: none !important; }</style></noscript>
        </div>
      )}

      {visualAudit && (
        <div id="full-explanation" class="full-explanation-divider" data-full-explanation hidden data-pagefind-ignore="all">
          <span>{fullContentLabel[category]}</span>
          <small>{Math.max(1, Math.round(stats.minutes))} min read</small>
        </div>
      )}

      {pageHeadings.length > 2 && <nav class="reader-tools" aria-label="On this page" data-pagefind-ignore="all">
        <details class="reader-tool">
          <summary>
            <span>On this page</span>
            <small>{pageHeadings.length} sections</small>
          </summary>
          <div class="reader-menu">
            <ol>{pageHeadings.map((heading) => (
              <li class:list={[`depth-${heading.depth}`]}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}</ol>
          </div>
        </details>
      </nav>}

      <div id="answer" class="prose docs-body" itemprop="articleBody">
        <slot />
      </div>

      {category !== 'questions' && <CompletionToggle itemId={`entry:${slug}`} />}

      <Subscribe placement="entry" />

      <nav class="journey-nav" aria-label={`Continue through ${libraryLocation ? libraryLocation.volume.title : categoryMeta.plural}`} data-pagefind-ignore="all">
        <div class="journey-context">
          <span>{chapterTitle}</span>
          <a href={libraryLocation ? `/library/${libraryLocation.volume.id}/${libraryLocation.chapter.id}/` : `/${category}/`}>{libraryLocation ? 'Chapter contents' : `All ${categoryMeta.plural.toLowerCase()}`}</a>
        </div>
        <div class="journey-links">
          {previousPost ? (
            <a class="journey-link journey-link--previous" href={previousPost.href} data-astro-prefetch>
              <span>← Previous entry</span>
              <strong>{previousPost.title}</strong>
            </a>
          ) : <span></span>}
          {nextPost ? (
            <a class="journey-link journey-link--next" href={nextPost.href} data-astro-prefetch>
              <span>Next entry →</span>
              <strong>{nextPost.title}</strong>
            </a>
          ) : <span></span>}
        </div>
      </nav>

      <p class="correction-link" data-pagefind-ignore="all">Found an error or stale claim? <a href={correctionIssueUrl} rel="noopener">Report a correction <span aria-hidden="true">↗</span></a> or <a href={correctionEmailUrl}>send a private note</a>.</p>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  import { extractLearningVisual } from '../utils/visualReviewClient';
  import { enhanceCodingVisuals } from '../utils/codingVisuals';

  function promoteArticleVisual() {
    const wrapper = document.querySelector<HTMLElement>('[data-article-quick-review]');
    const articleBody = document.querySelector<HTMLElement>('#answer');
    if (!wrapper || !articleBody || wrapper.dataset.ready === 'true') return;

    const card = wrapper.querySelector<HTMLElement>('[data-visual-review-card]');
    const host = wrapper.querySelector<HTMLElement>('[data-review-visual-host]');
    const extracted = extractLearningVisual(articleBody, wrapper.dataset.visualId);
    if (!card || !host || !extracted) {
      wrapper.hidden = true;
      return;
    }

    const visualNodes: Node[] = extracted.marker
      ? [extracted.marker, extracted.figure]
      : [extracted.figure];
    host.replaceChildren(...visualNodes);
    host.setAttribute('aria-busy', 'false');
    if (extracted.source) {
      const sourceHost = wrapper.querySelector<HTMLElement>('[data-review-source-host]');
      const sourceDetails = wrapper.querySelector<HTMLDetailsElement>('[data-review-source-details]');
      sourceHost?.append(extracted.source);
      if (sourceDetails) sourceDetails.hidden = false;
    }

    card.hidden = false;
    const divider = document.querySelector<HTMLElement>('[data-full-explanation]');
    if (divider) divider.hidden = false;
    wrapper.dataset.ready = 'true';
  }

  promoteArticleVisual();
  enhanceCodingVisuals();
  document.addEventListener('astro:page-load', promoteArticleVisual);
  document.addEventListener('astro:page-load', () => enhanceCodingVisuals());
</script>

<style>
  .docs-shell {
    width: min(100%, var(--measure));
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.2rem) var(--gutter) 3.5rem;
  }
  .docs-layout { min-width: 0; }

  .docs-article { min-width: 0; }
  .docs-head { max-width: var(--measure); margin: 0 auto 1rem; }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .35rem;
    font-family: var(--font-ui);
    font-size: .72rem;
    font-weight: 500;
    color: var(--c-muted);
    margin: 0 0 .75rem;
  }
  .breadcrumbs a { color: var(--c-text-soft); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--c-text); text-decoration: underline; }
  .docs-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 1.95rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.018em;
    margin: 0 0 .45rem;
  }
  .lede {
    font-size: .98rem;
    color: var(--c-text-soft);
    line-height: 1.5;
    margin: 0 0 .7rem;
  }
  .docs-meta {
    font-family: var(--font-ui);
    font-size: .72rem;
    color: var(--c-muted);
  }
  .dot { margin: 0 .28rem; opacity: .55; }

  .docs-body {
    font-family: var(--font-reading);
    font-size: 1rem;
    line-height: 1.68;
  }
  #answer { scroll-margin-top: var(--sticky-offset); }
  .docs-body :global(h2) { margin-top: 1.9rem; }
  .docs-body :global(h3) { margin-top: 1.4rem; }
  .docs-body :global(h2), .docs-body :global(h3) { scroll-margin-top: var(--sticky-offset); }

  .reader-tools { max-width: var(--measure); margin: .9rem auto 1.5rem; }
  .reader-tool {
    padding: 0;
    border-bottom: 1px solid var(--c-rule);
    font-family: var(--font-ui);
  }
  .reader-tool summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: .5rem 0;
    cursor: pointer;
    list-style: none;
    color: var(--c-text);
    font-size: .76rem;
    font-weight: 550;
  }
  .reader-tool summary::-webkit-details-marker { display: none; }
  .reader-tool summary::after { content: '+'; color: var(--c-muted); font-family: var(--font-mono); }
  .reader-tool[open] summary::after { content: '−'; }
  .reader-tool summary small {
    margin-left: auto;
    color: var(--c-muted);
    font-family: var(--font-ui);
    font-size: .68rem;
    font-weight: 400;
  }
  .reader-menu { padding: .2rem 0 1rem; }
  .reader-tool ol {
    max-height: 45vh;
    overflow-y: auto;
    margin: 0;
    padding: 0.1rem 0 0.2rem 1.2rem;
  }
  .reader-tool li { margin: 0.25rem 0; color: var(--c-muted); }
  .reader-tool li.depth-3 { margin-left: 0.8rem; font-size: 0.92em; }
  .reader-tool a { color: var(--c-text-soft); text-decoration: none; }
  .reader-tool a:hover { color: var(--c-accent); text-decoration: underline; }
  .reader-tool a[aria-current='page'] { color: var(--c-accent); font-weight: 650; }

  .full-explanation-divider {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem 0 .75rem;
    padding-bottom: .45rem;
    border-bottom: 1px solid var(--c-rule);
    color: var(--c-text);
    font-family: var(--font-ui);
  }
  .full-explanation-divider[hidden] { display: none; }
  .full-explanation-divider span { font-size: .78rem; font-weight: 650; }
  .full-explanation-divider small { color: var(--c-muted); font-size: .67rem; }

  .journey-nav {
    max-width: var(--measure);
    margin-right: auto;
    margin-left: auto;
    margin-top: 2.5rem;
    padding: .8rem 0 0;
    border-top: 1px solid var(--c-rule);
  }
  .journey-context {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .55rem;
    font-family: var(--font-ui);
    font-size: .72rem;
    color: var(--c-muted);
  }
  .journey-context > span {
    font-weight: 550;
  }
  .journey-context a { color: var(--c-text-soft); }
  .journey-context a:hover { color: var(--c-accent); }
  .journey-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .journey-link {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    min-width: 0;
    padding: .6rem 0;
    color: var(--c-text);
    text-decoration: none;
    transition: color var(--transition);
  }
  .journey-link:hover { color: var(--c-accent); }
  .journey-link > span {
    font-family: var(--font-ui);
    font-size: .68rem;
    font-weight: 500;
    color: var(--c-muted);
  }
  .journey-link strong {
    font-family: var(--font-display);
    font-size: .84rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .journey-link--next { text-align: right; }
  .correction-link {
    max-width: var(--measure);
    margin: 1rem auto 0;
    color: var(--c-muted);
    font-family: var(--font-ui);
    font-size: .68rem;
  }
  .correction-link a { color: var(--c-text-soft); }

  @media (max-width: 800px) {
    .docs-shell {
      padding: 1rem var(--gutter) 3rem;
    }
    .journey-links { grid-template-columns: 1fr; }
    .journey-link--next { text-align: left; }
  }
  @media (min-width: 861px) {
    .breadcrumbs { display: none; }
    #answer,
    .docs-body :global(h2),
    .docs-body :global(h3) { scroll-margin-top: calc(var(--header-height) + .75rem); }
  }
</style>
