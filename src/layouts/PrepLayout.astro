---
import BaseLayout from './BaseLayout.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  eyebrow?: string;
}

const { title, description, heading, lede, eyebrow = 'Free prep resources' } = Astro.props;
const pathname = Astro.url.pathname;
const sectionLabel = pathname.startsWith('/prep/readiness/') ? 'Build a plan'
  : pathname.startsWith('/prep/role-paths/') ? 'Role guide'
  : pathname.startsWith('/prep/level-paths/') ? 'Level guide'
  : pathname.startsWith('/prep/simulations/') ? 'Simulation'
  : pathname.startsWith('/prep/labs/') ? 'Lab'
  : pathname.startsWith('/prep/frontier-labs/') ? 'Interview formats'
  : pathname.startsWith('/prep/story-bank/') ? 'Story bank'
  : pathname.startsWith('/prep/presentation/') ? 'Presentation'
  : pathname.startsWith('/prep/values/') ? 'Values'
  : pathname.startsWith('/prep/final-week/') ? 'Final week'
  : pathname.startsWith('/prep/plans/') ? 'Planning appendix'
  : null;
const workbookHome = pathname === '/prep/';
const workbookEmailGateEnabled = workbookHome && SITE.newsletter.provider === 'beehiiv' && SITE.newsletter.formId.length > 0;
const journeyItems = [
  { id: 'plan', number: '01', label: 'Plan', href: '/prep/readiness/', active: pathname.startsWith('/prep/readiness/') || pathname.startsWith('/prep/plans/') },
  { id: 'map', number: '02', label: 'Your map', href: '/prep/', active: pathname === '/prep/' },
  { id: 'practice', number: '03', label: 'Practice', href: '/prep/#queue', active: false },
  { id: 'simulate', number: '04', label: 'Simulate', href: '/prep/simulations/', active: pathname.startsWith('/prep/simulations/') },
  { id: 'final-week', number: '05', label: 'Final week', href: '/prep/final-week/', active: pathname.startsWith('/prep/final-week/') },
];
const optionalLinks = [
  { label: 'Role guide', href: '/prep/role-paths/', active: pathname.startsWith('/prep/role-paths/') || pathname.startsWith('/prep/level-paths/') },
  { label: 'Stories', href: '/prep/story-bank/', active: pathname.startsWith('/prep/story-bank/') },
  { label: 'Special formats', href: '/prep/frontier-labs/', active: pathname.startsWith('/prep/frontier-labs/') },
  { label: 'Labs', href: '/prep/labs/', active: pathname.startsWith('/prep/labs/') },
  { label: 'Presentation', href: '/prep/presentation/', active: pathname.startsWith('/prep/presentation/') },
  { label: 'Values', href: '/prep/values/', active: pathname.startsWith('/prep/values/') },
];
const optionalActive = optionalLinks.some((link) => link.active);
---

<BaseLayout title={title} description={description}>
  <div class="prep-page">
    <nav class="workbook-trail" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      {pathname === '/prep/' ? <span aria-current="page">Workbook</span> : <a href="/prep/">Workbook</a>}
      {sectionLabel && <><span aria-hidden="true">/</span><span aria-current="page">{sectionLabel}</span></>}
    </nav>

    <nav class="prep-journey" aria-label="Workbook journey">
      <p>Core journey</p>
      <ol>
        {journeyItems.map((item) => (
          <li class:list={{ active: item.active }}>
            <a data-journey-step={item.id} href={item.href} aria-current={item.active ? 'page' : undefined}>
              <span>{item.number}</span><strong>{item.label}</strong>
            </a>
          </li>
        ))}
      </ol>
      <details class="prep-more" open={optionalActive}>
        <summary>More prep <span>Role, stories, and confirmed specialist formats</span></summary>
        <div>{optionalLinks.map((link) => <a class={link.active ? 'active' : undefined} href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}</div>
      </details>
    </nav>

    {workbookEmailGateEnabled && (
      <section class="workbook-gate" data-workbook-gate aria-labelledby="workbook-gate-heading">
        <p class="prep-eyebrow">Private workbook</p>
        <h1 id="workbook-gate-heading">Subscribe to get the workbook by email.</h1>
        <p>The field guide remains free. Subscribe to ML from Primitives to receive the printable workbook, then use this browser-local workspace to plan your loop and track practice.</p>
        <div class="workbook-preview">
          <p class="workbook-preview-label">Inside the workbook</p>
          <ul>
            <li><strong>Turn your actual loop into a plan.</strong><span>Role, rounds, runway, and weekly capacity become one next action.</span></li>
            <li><strong>Practice from evidence.</strong><span>Track closed-book attempts, clear gaps, retries, and mixed practice checks.</span></li>
            <li><strong>Prepare the human rounds.</strong><span>Shape project decisions, behavioral stories, pushback, simulations, and final-week logistics.</span></li>
          </ul>
        </div>
        <Subscribe placement="workbook" heading="Get the printable workbook by email." />
      </section>
    )}

    <div class="workbook-content" data-workbook-content hidden={workbookEmailGateEnabled}>
      <header class="prep-hero">
        <p class="prep-eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p>{lede}</p>
        <p class="prep-download"><a href="/downloads/mlmentorship-workbook.pdf" download>Download the printable route guide</a><span>Linked examples and blank tracking sheets. Print your saved map below for your own routes and dates.</span></p>
      </header>

      <article class="prep-content">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  import { WORKBOOK_UNLOCK_KEY } from '../utils/newsletter';

  const content = document.querySelector<HTMLElement>('[data-workbook-content]');
  const gate = document.querySelector<HTMLElement>('[data-workbook-gate]');
  const unlockKey = WORKBOOK_UNLOCK_KEY;

  function isUnlocked(): boolean {
    try { return window.localStorage.getItem(unlockKey) === '1'; } catch { return false; }
  }

  function syncWorkbookAccess(): void {
    if (!content || !gate) return;
    const unlocked = isUnlocked();
    content.hidden = !unlocked;
    gate.hidden = unlocked;
    if (unlocked && window.location.hash) {
      requestAnimationFrame(() => document.getElementById(window.location.hash.slice(1))?.scrollIntoView({ block: 'start' }));
    }
  }

  syncWorkbookAccess();
  const journeyLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-journey-step]')];
  function syncJourneyState(): void {
    const path = window.location.pathname;
    const hash = window.location.hash;
    const activeStep = path === '/prep/readiness/' || path.startsWith('/prep/plans/') ? 'plan'
      : path.startsWith('/prep/simulations/') ? 'simulate'
        : path.startsWith('/prep/final-week/') ? 'final-week'
          : path === '/prep/' && hash === '#queue' ? 'practice'
            : path === '/prep/' ? 'map'
              : null;
    journeyLinks.forEach((link) => {
      const active = link.dataset.journeyStep === activeStep;
      link.parentElement?.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }
  syncJourneyState();
  window.addEventListener('hashchange', syncJourneyState);
  window.addEventListener('popstate', syncJourneyState);
  window.addEventListener('storage', syncWorkbookAccess);
  window.addEventListener('workbook-email-unlocked', syncWorkbookAccess);
  document.addEventListener('visibilitychange', syncWorkbookAccess);
</script>

<style>
  .prep-page { max-width: 46rem; margin: 0 auto; padding: clamp(1.3rem, 3vw, 2.2rem) var(--gutter) 4rem; }
  .workbook-gate { padding: 1.2rem 0 1.5rem; border-bottom: 1px solid var(--c-rule); }
  .workbook-gate h1 { margin: 0 0 .5rem; font-size: clamp(1.7rem, 4vw, 2.15rem); line-height: 1.14; letter-spacing: -.02em; }
  .workbook-gate > p:not(.prep-eyebrow) { max-width: 38rem; margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: .94rem; line-height: 1.5; }
  .workbook-preview { margin: 1.1rem 0 0; padding: .85rem 1rem; border-left: 3px solid var(--c-accent); background: var(--c-bg-tint); }
  .workbook-preview-label { margin: 0 0 .55rem; color: var(--c-accent); font-family: var(--font-mono); font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .workbook-preview ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin: 0; padding: 0; list-style: none; }
  .workbook-preview li { display: grid; gap: .2rem; margin: 0; }
  .workbook-preview strong { color: var(--c-text); font-size: .74rem; line-height: 1.3; }
  .workbook-preview span { color: var(--c-muted); font-family: var(--font-reading); font-size: .68rem; line-height: 1.4; }
  .workbook-gate :global(.subscribe) { width: 100%; margin-top: 1.25rem; }
  .workbook-trail { display: flex; flex-wrap: wrap; gap: .3rem; margin-bottom: 1.1rem; color: var(--c-muted); font-family: var(--font-ui); font-size: .68rem; }
  .workbook-trail a { color: var(--c-text-soft); text-decoration: none; }
  .workbook-trail a:hover { color: var(--c-accent); text-decoration: underline; }
  .prep-journey { margin: 0 0 1.35rem; padding: .65rem 0 .7rem; border-top: 1px solid var(--c-rule); border-bottom: 1px solid var(--c-rule); }
  .prep-journey > p { margin: 0 0 .45rem; color: var(--c-muted); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  .prep-journey ol { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .3rem; margin: 0; padding: 0; list-style: none; }
  .prep-journey li { min-width: 0; margin: 0; }
  .prep-journey li a { display: flex; min-height: 3rem; flex-direction: column; justify-content: center; gap: .12rem; padding: .35rem .45rem; border-top: 2px solid var(--c-rule); color: var(--c-text-soft); text-decoration: none; }
  .prep-journey li a:hover, .prep-journey li.active a { border-top-color: var(--c-accent); color: var(--c-accent); }
  .prep-journey li a span { font-family: var(--font-mono); font-size: .58rem; }
  .prep-journey li a strong { color: inherit; font-size: .76rem; }
  .prep-more { margin-top: .55rem; padding-top: .55rem; border-top: 1px solid var(--c-rule-soft); }
  .prep-more summary { display: flex; align-items: baseline; justify-content: space-between; gap: .8rem; cursor: pointer; color: var(--c-text-soft); font-size: .76rem; font-weight: 700; }
  .prep-more summary span { color: var(--c-muted); font-size: .7rem; font-weight: 400; }
  .prep-more > div { display: flex; flex-wrap: wrap; gap: .35rem .75rem; margin-top: .55rem; }
  .prep-more a { color: var(--c-muted); font-size: .74rem; text-decoration: none; }
  .prep-more a:hover, .prep-more a.active { color: var(--c-accent); text-decoration: underline; }
  .prep-hero { max-width: 42rem; margin-bottom: 1.4rem; padding-bottom: .9rem; border-bottom: 1px solid var(--c-rule); }
  .prep-eyebrow { margin: 0 0 .4rem !important; color: var(--c-muted) !important; font-size: .68rem !important; font-weight: 500; }
  .prep-hero h1 { margin: 0 0 .45rem; font-size: clamp(1.65rem, 4vw, 2.15rem); line-height: 1.14; letter-spacing: -.02em; }
  .prep-hero > p:not(.prep-eyebrow):not(.prep-download) { max-width: 40rem; margin: 0; color: var(--c-text-soft); font-family: var(--font-reading); font-size: .94rem; line-height: 1.5; }
  .prep-download { display: flex; flex-wrap: wrap; gap: .25rem .7rem; align-items: baseline; margin-top: .7rem !important; font-family: var(--font-ui) !important; font-size: .72rem !important; }
  .prep-download a { color: var(--c-accent); font-weight: 650; text-decoration: none; }
  .prep-download a:hover { text-decoration: underline; }
  .prep-download span { color: var(--c-muted); }
  .prep-content :global(h2) { margin: 2rem 0 .6rem; font-size: 1.2rem; scroll-margin-top: var(--sticky-offset); }
  .prep-content :global(h3) { margin: 1.35rem 0 .4rem; font-size: 1rem; }
  .prep-content :global(p), .prep-content :global(li) { overflow-wrap: anywhere; line-height: 1.55; }
  .prep-content :global(.intro) { max-width: 44rem; padding: 1rem 1.1rem; border-left: 3px solid var(--c-accent); background: var(--c-bg-tint); color: var(--c-text-soft); }
  .prep-content :global(.resource-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 1.4rem 0 2rem; }
  .prep-content :global(.resource-card) { display: block; padding: .85rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-surface); color: inherit; text-decoration: none; }
  .prep-content :global(.resource-card:hover) { border-color: var(--c-muted); }
  .prep-content :global(.resource-card h2), .prep-content :global(.resource-card h3) { margin: 0 0 .45rem; font-size: 1.08rem; }
  .prep-content :global(.resource-card p) { margin: 0; color: var(--c-text-soft); font-size: .9rem; }
  .prep-content :global(.step-list) { list-style: none; margin: 1.2rem 0; padding: 0; counter-reset: prep-step; }
  .prep-content :global(.step-list > li) { position: relative; margin: 0; padding: 1rem 0 1rem 3rem; border-top: 1px solid var(--c-rule); counter-increment: prep-step; }
  .prep-content :global(.step-list > li::before) { content: counter(prep-step, decimal-leading-zero); position: absolute; left: 0; top: 1.2rem; font-family: var(--font-mono); font-size: .76rem; color: var(--c-accent); }
  .prep-content :global(.callout) { margin: 1.3rem 0; padding: .8rem .9rem; border-left: 2px solid var(--c-rule); background: var(--c-bg-tint); }
  .prep-content :global(.callout > :first-child) { margin-top: 0; }
  .prep-content :global(.callout > :last-child) { margin-bottom: 0; }
  .prep-content :global(.print-button) { padding: .65rem .9rem; border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-bg); color: var(--c-text); font: inherit; font-weight: 600; cursor: pointer; }
  .prep-content :global(.print-button:hover) { border-color: var(--c-accent); color: var(--c-accent); }
  @media (max-width: 640px) {
    .workbook-preview ul { grid-template-columns: 1fr; gap: .6rem; }
    .prep-content :global(.resource-grid) { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .prep-journey ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .prep-journey li:nth-child(4), .prep-journey li:nth-child(5) { margin-top: .2rem; }
    .prep-more summary span { display: none; }
  }
  @media print {
    :global(.masthead), :global(footer), .workbook-trail, .prep-journey, .prep-content :global(.print-button) { display: none !important; }
    .prep-page { max-width: none; padding: 0; }
    .prep-hero { margin-bottom: 1rem; }
  }
</style>
