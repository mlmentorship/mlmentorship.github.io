---
// DocsIndexLayout: a quiet single-column archive page.
import BaseLayout from './BaseLayout.astro';

interface Props {
  category?: 'guides' | 'questions' | 'concepts';
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="docs-layout">
    <div class="docs-article">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .docs-layout {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(1.3rem, 3vw, 2.2rem) var(--gutter) 3.5rem;
  }

  .docs-article { min-width: 0; }

  @media (max-width: 800px) {
    .docs-layout {
      padding: 1rem var(--gutter) 3rem;
    }
  }
</style>
