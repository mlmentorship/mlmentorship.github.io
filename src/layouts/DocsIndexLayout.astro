---
// DocsIndexLayout: section-archive page styled like a docs page,
// with the persistent left sidebar and global category strip.
// Mirrors DocsLayout but takes raw content as a slot rather than a post.
import BaseLayout from './BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';

interface Props {
  category?: 'guides' | 'questions' | 'concepts';
  title: string;
  description?: string;
}
const { category, title, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="docs-layout">
    <nav class="docs-sidebar" aria-label="Section navigation" data-pagefind-ignore="all">
      <SectionNav category={category} />
    </nav>

    <main class="docs-article">
      <slot />
    </main>

    {/* Empty placeholder so the 3-column grid matches DocsLayout and the
        sidebar position stays stable when navigating between index and post. */}
    <aside class="docs-toc-placeholder" aria-hidden="true"></aside>
  </div>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr) 14rem;
    gap: 2.5rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
    /* No overflow / max-height: rely on the single page scroll. */
  }

  .docs-article { min-width: 0; }

  @media (max-width: 800px) {
    .docs-layout {
      grid-template-columns: 1fr;
      padding: 1rem var(--gutter) 3rem;
    }
    .docs-sidebar {
      position: static;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--c-rule);
    }
  }
</style>
