{
  "name": "mlmentorship",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Senior ML interview prep",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/check-links.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "playbook:generate": "tsx scripts/playbook/generate.ts",
    "playbook:sample": "tsx scripts/playbook/generate.ts --intake examples/playbook/sample-intake.json --out artifacts/playbooks/sample",
    "test:playbook": "tsx --test scripts/playbook/*.test.ts",
    "playbook:validate": "npm run test:playbook && npm run playbook:sample -- --html-only",
    "playbook:review": "zsh scripts/playbook/validate-review.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.18.1",
    "katex": "^0.16.11",
    "mermaid": "^11.14.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@resvg/resvg-js": "^2.6.2",
    "astro-mermaid": "^2.0.1",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "satori": "^0.26.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "zod": "^4.4.3"
  }
}
